    "userGuide.freeAndPro.free.review.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open every group, compare photos, change the Best Shot, and mark groups as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривайте будь-яку групу, порівнюйте фото, змінюйте найкращий кадр і позначайте групи переглянутими."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos los grupos, compara fotos, cambia la mejor toma y marca grupos como revisados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos los grupos, compara fotos, cambia la mejor toma y marca grupos como revisados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra todos os grupos, compare fotos, mude a melhor foto e marque grupos como revisados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne jede Gruppe, vergleiche Fotos, ändere die beste Aufnahme und markiere Gruppen als geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez chaque groupe, comparez les photos, changez la meilleure photo et marquez les groupes comme examinés."
          }
        }
      }
    },
