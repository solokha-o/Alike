        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido restaurar tus compras. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar suas compras. Verifique sua conexão e tente novamente."
