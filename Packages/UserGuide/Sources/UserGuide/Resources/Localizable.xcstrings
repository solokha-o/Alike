    "userGuide.scanning.status.allowance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free includes three scans each calendar month. The counter resets at the start of the next month."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free містить три сканування щокалендарного місяця. Лічильник оновлюється на початку наступного місяця."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free incluye tres análisis por mes calendario. El contador se restablece al empezar el mes siguiente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free incluye tres análisis por mes natural. El contador se restablece al empezar el mes siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike Free inclui três análises por mês. O contador zera no início do mês seguinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free enthält drei Scans pro Kalendermonat. Der Zähler startet zu Beginn des nächsten Monats neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free comprend trois analyses par mois civil. Le compteur repart au début du mois suivant."
          }
        }
      }
    },
    "userGuide.scanning.status.allowance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free scans remaining"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок безкоштовних сканувань"
          }
        },
        "es-419": {
