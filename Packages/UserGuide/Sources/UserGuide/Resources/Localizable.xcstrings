    "userGuide.privacy.deleteData.removed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan results and analysis caches, cleanup progress and history, and your Alike preferences."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати сканування й кеші аналізу, прогрес та історія очищення, а також ваші налаштування Alike."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de los análisis y sus cachés, el progreso e historial de limpieza y tus preferencias de Alike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de los análisis y sus cachés, el progreso e historial de limpieza y tus preferencias de Alike."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados das análises e caches de análise, progresso e histórico de limpeza e suas preferências do Alike."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan-Ergebnisse und Analyse-Caches, Aufräum-Fortschritt und -Verlauf sowie deine Alike-Einstellungen."
          }
