    "userGuide.settingsAndReminders.reminder.schedule.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro lets you move the reminder to whichever day and time suits you."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro дозволяє перенести нагадування на зручні вам день і час."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro te deja mover el recordatorio al día y la hora que te vengan bien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro te deja mover el recordatorio al día y la hora que te vengan bien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike Pro permite mover o lembrete para o dia e o horário que combinarem com você."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Alike Pro legst du die Erinnerung auf den Tag und die Uhrzeit, die dir passen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro vous laisse déplacer le rappel au jour et à l’heure qui vous conviennent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro ti permette di spostare il promemoria nel giorno e nell'ora che preferisci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Alike Pro verplaats je de herinnering naar de dag en tijd die jou uitkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro pozwala przenieść przypomnienie na dowolny pasujący Ci dzień i godzinę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro, anımsatıcıyı sana uyan gün ve saate taşımana olanak tanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro 讓你把提醒改到最適合你的日期與時間。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك Alike Pro نقل التذكير إلى اليوم والوقت اللذين يناسبانك."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.schedule.title": {
