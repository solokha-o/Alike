    "userGuide.privacy.onDevice.network.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only network requests Alike makes are to the App Store, for subscriptions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Єдині мережеві запити Alike — до App Store, для підписок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las únicas solicitudes de red que hace Alike son al App Store, para las suscripciones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las únicas solicitudes de red que hace Alike son al App Store, para las suscripciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As únicas requisições de rede que o Alike faz são para a App Store, por causa das assinaturas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzigen Netzwerkanfragen von Alike gehen an den App Store – für Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seules requêtes réseau d’Alike vont vers l’App Store, pour les abonnements."
          }
        }
      }
    },
    "userGuide.privacy.onDevice.network.title": {
