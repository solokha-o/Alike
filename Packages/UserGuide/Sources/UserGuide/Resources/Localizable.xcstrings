    "userGuide.smartCategories.blurDetection.conservative.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike suggests only the softest few percent of your photos, and only when there are enough to compare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike пропонує лише кілька відсотків найменш різких фото, і лише коли є з чим порівнювати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike sugiere solo el pequeño porcentaje más desenfocado de tus fotos, y solo cuando hay suficientes para comparar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike sugiere solo el pequeño porcentaje más desenfocado de tus fotos, y solo cuando hay suficientes para comparar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike sugere apenas os poucos por cento mais suaves das suas fotos, e só quando há material suficiente para comparar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike schlägt nur die weichsten paar Prozent deiner Fotos vor – und auch nur, wenn es genug zum Vergleichen gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ne propose que les quelques pour cent les plus flous de vos photos, et seulement s’il y a de quoi comparer."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.conservative.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the clearest cases"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише найочевидніші випадки"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los casos más claros"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los casos más claros"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os casos mais claros"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die eindeutigen Fälle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les cas les plus nets"
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.favorites.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos you marked as favourites never appear here — mark a photo as a favourite to protect it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, позначені як обрані, тут ніколи не з'являються — позначте фото обраним, щоб захистити його."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que marcaste como favoritas nunca aparecen aquí: marca una foto como favorita para protegerla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que has marcado como favoritas nunca aparecen aquí: marca una foto como favorita para protegerla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos marcadas como favoritas nunca aparecem aqui — marque uma foto como favorita para protegê-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die du als Favoriten markiert hast, erscheinen hier nie – markiere ein Foto als Favorit, um es zu schützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos que vous avez mises en favoris n’apparaissent jamais ici — mettez une photo en favori pour la protéger."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.favorites.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites are left alone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрані не чіпаються"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las favoritas se quedan como están"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las favoritas se quedan como están"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As favoritas ficam de fora"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten bleiben unangetastet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris sont épargnés"
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short list is intentional: a missed blurry photo costs you nothing, a wrongly flagged keepsake does."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий список — це задум: пропущене розмите фото нічого не коштує, а помилково позначений спогад — так."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista corta es intencional: una foto borrosa que se escapa no te cuesta nada; un recuerdo marcado por error, sí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista corta es intencional: una foto borrosa que se escapa no te cuesta nada; un recuerdo marcado por error, sí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista curta é proposital: uma foto tremida que passa não custa nada; uma lembrança sinalizada por engano, sim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kurze Liste ist Absicht: ein übersehenes unscharfes Foto kostet dich nichts, eine fälschlich markierte Erinnerung schon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La brièveté de la liste est volontaire : une photo floue oubliée ne vous coûte rien, un souvenir signalé à tort, si."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the blurred list is short"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чому список розмитих короткий"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué la lista de borrosas es corta"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué la lista de borrosas es corta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a lista de desfocadas é curta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum die Liste unscharfer Fotos kurz ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi la liste des photos floues est courte"
          }
        }
      }
    },
    "userGuide.smartCategories.categories.blurred.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos that look out of focus, based on on-device analysis. Worth checking before you remove them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, які виглядають нерізкими, за результатами аналізу на пристрої. Варто перевірити перед видаленням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, según el análisis en el dispositivo. Vale la pena revisarlas antes de eliminarlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, según el análisis en el dispositivo. Merece la pena revisarlas antes de eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecem fora de foco, segundo a análise no dispositivo. Vale conferir antes de remover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die laut Analyse auf dem Gerät unscharf wirken. Vor dem Entfernen einen Blick wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des photos qui semblent floues d’après l’analyse sur l’appareil. À vérifier avant de les supprimer."
          }
        }
      }
    },
