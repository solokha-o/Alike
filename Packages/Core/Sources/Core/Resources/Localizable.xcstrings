    "core.cleanupCategory.likelyLowQualityPhotosBased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely low-quality photos based on on-device analysis. Review before deleting."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імовірно неякісні фото за результатами аналізу на пристрої. Перегляньте їх перед видаленням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos probablemente de baja calidad según el análisis en el dispositivo. Revísalas antes de eliminarlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos probablemente de baja calidad según el análisis en el dispositivo. Revísalas antes de eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos provavelmente de baixa qualidade, segundo a análise no dispositivo. Revise antes de apagar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Analyse auf dem Gerät wahrscheinlich Fotos in geringer Qualität. Vor dem Löschen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos probablement de faible qualité d’après l’analyse sur l’appareil. À examiner avant suppression."
          }
        }
      }
    },
