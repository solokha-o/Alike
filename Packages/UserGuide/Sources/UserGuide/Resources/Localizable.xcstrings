    },
    "userGuide.deletingSafely.flow.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike can't remove a photo on its own — iOS always asks you first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike не може видалити фото самостійно — iOS завжди спершу запитує вас."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no puede eliminar una foto por su cuenta: iOS siempre te pregunta primero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no puede eliminar una foto por su cuenta: iOS siempre te pregunta primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike não consegue remover uma foto sozinho — o iOS sempre pergunta antes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike kann kein Foto von sich aus entfernen – iOS fragt immer zuerst dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ne peut pas supprimer une photo de lui-même : iOS vous demande toujours d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike non può rimuovere una foto da solo: iOS chiede sempre prima a te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike kan een foto niet zelf verwijderen — iOS vraagt het altijd eerst aan jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike nie może samodzielnie usunąć zdjęcia — iOS zawsze pyta najpierw Ciebie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike bir fotoğrafı kendi başına kaldıramaz — iOS her zaman önce sana sorar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 無法自行移除照片，iOS 一定會先詢問你。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Alike إزالة صورة من تلقاء نفسه — يسألك iOS دائمًا أولًا."
          }
        }
      }
    },
