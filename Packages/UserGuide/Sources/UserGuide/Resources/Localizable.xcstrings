    "userGuide.settingsAndReminders.subscription.restore.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a new device, or after reinstalling, this brings your existing subscription back."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На новому пристрої або після перевстановлення це поверне вашу наявну підписку."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo nuevo, o después de reinstalar, esto recupera tu suscripción actual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo nuevo, o después de reinstalar, esto recupera tu suscripción actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um dispositivo novo, ou depois de reinstalar, isto traz sua assinatura de volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem neuen Gerät oder nach einer Neuinstallation holt das dein bestehendes Abo zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un nouvel appareil, ou après une réinstallation, cela restaure votre abonnement existant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un nuovo dispositivo o dopo una reinstallazione, questo recupera l'abbonamento esistente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een nieuw apparaat of na opnieuw installeren haal je hiermee je bestaande abonnement terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na nowym urządzeniu lub po ponownej instalacji przywraca to Twoją istniejącą subskrypcję."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir aygıtta ya da yeniden kurulumdan sonra bu, mevcut aboneliğini geri getirir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新裝置上或重新安裝後，這會找回你現有的訂閱項目。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز جديد، أو بعد إعادة التثبيت، يعيد هذا اشتراكك الحالي."
          }
        }
      }
    },
