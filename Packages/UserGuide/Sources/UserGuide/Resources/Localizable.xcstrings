    "userGuide.settingsAndReminders.reminder.weekly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder to spend a few minutes on cleanup. On Alike Free it arrives on Sunday evening."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Делікатне нагадування приділити кілька хвилин очищенню. В Alike Free воно приходить у неділю ввечері."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave para dedicar unos minutos a la limpieza. En Alike Free llega el domingo por la tarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave para dedicar unos minutos a la limpieza. En Alike Free llega el domingo por la tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete leve para dedicar alguns minutos à limpeza. No Alike Free ele chega no domingo à noite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Hinweis, ein paar Minuten aufzuräumen. In Alike Free kommt er am Sonntagabend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel discret pour consacrer quelques minutes au nettoyage. Dans Alike Free, il arrive le dimanche soir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto per dedicare qualche minuto alla pulizia. Con Alike Free arriva la domenica sera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vriendelijke herinnering om een paar minuten op te ruimen. Bij Alike Free komt die op zondagavond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne przypomnienie, aby poświęcić kilka minut na porządki. W Alike Free przychodzi w niedzielę wieczorem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizliğe birkaç dakika ayırman için nazik bir anımsatma. Alike Free'de pazar akşamı gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和地提醒你花幾分鐘整理。在 Alike Free 中，提醒會在星期日傍晚送達。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير لطيف بقضاء بضع دقائق في التنظيف. وفي Alike المجاني يصل مساء الأحد."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.weekly.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
