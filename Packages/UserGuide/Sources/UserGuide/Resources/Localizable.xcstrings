    "userGuide.cleanupQueue.badges.reviewed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've made your decision about this group — whatever that decision was."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ухвалили рішення щодо цієї групи — яким би воно не було."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tomaste tu decisión sobre este grupo, cualquiera que haya sido."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has tomado tu decisión sobre este grupo, cualquiera que haya sido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tomou sua decisão sobre este grupo, seja ela qual for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich für diese Gruppe entschieden – wie auch immer die Entscheidung ausfiel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez tranché pour ce groupe, quelle qu’ait été votre décision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai preso la tua decisione su questo gruppo, qualunque essa sia stata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je beslissing over deze groep genomen — wat die beslissing ook was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podjąłeś decyzję w sprawie tej grupy — jakakolwiek by nie była."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu grup hakkında kararını verdin — karar ne olursa olsun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已對這個群組做出決定，無論是什麼決定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتخذت قرارك بشأن هذه المجموعة — أيًّا كان ذلك القرار."
          }
        }
      }
    },
