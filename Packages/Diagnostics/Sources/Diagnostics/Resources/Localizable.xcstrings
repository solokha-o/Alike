{
  "sourceLanguage" : "en",
  "strings" : {
    "diagnostics.prompt.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike closed unexpectedly"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike несподівано закрився"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike se cerró inesperadamente"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike se ha cerrado inesperadamente"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike fechou inesperadamente"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike wurde unerwartet beendet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike s’est fermé de façon inattendue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike si è chiuso in modo imprevisto"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike is onverwacht gestopt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Alike nieoczekiwanie się zamknęła"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike beklenmedik şekilde kapandı"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike 意外關閉"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إغلاق Alike بشكل غير متوقع"
          }
        }
      }
    },
    "diagnostics.prompt.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a crash report to the developer? It opens as an email, so you can read it before anything is sent."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслати звіт про збій розробнику? Він відкриється як лист, тож ви зможете переглянути його перед надсиланням."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar un informe del fallo al desarrollador? Se abre como un correo, así que puedes leerlo antes de enviarlo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar un informe del fallo al desarrollador? Se abre como un correo, así que puedes leerlo antes de enviarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar um relatório da falha ao desenvolvedor? Ele abre como um e-mail, então você pode ler antes de enviar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzbericht an den Entwickler senden? Er wird als E-Mail geöffnet, du kannst ihn also vor dem Senden lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer un rapport de plantage au développeur ? Il s’ouvre sous forme d’e-mail, vous pouvez donc le lire avant l’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare un report dell’arresto anomalo allo sviluppatore? Si apre come e-mail, così puoi leggerlo prima dell’invio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een crashrapport naar de ontwikkelaar sturen? Het opent als e-mail, zodat je het kunt lezen voordat het wordt verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłać raport o awarii do twórcy aplikacji? Otworzy się jako e-mail, więc możesz go przeczytać przed wysłaniem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliştiriciye bir çökme raporu gönderilsin mi? Rapor bir e-posta olarak açılır, böylece göndermeden önce okuyabilirsiniz."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將當機報告傳送給開發者嗎？報告會以電子郵件開啟，你可以在傳送前先閱讀。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إرسال تقرير التعطل إلى المطوّر؟ سيُفتح كرسالة بريد إلكتروني لتتمكن من قراءته قبل الإرسال."
          }
        }
      }
    },
    "diagnostics.prompt.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The report is the crash diagnostic iOS recorded: the stack trace, the app and iOS versions, your device model and, for some crashes, the error message. Alike sends it as it is, unfiltered. It contains no photos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт — це діагностика збою, яку записала iOS: стек викликів, версії застосунку та iOS, модель пристрою і, для деяких збоїв, текст повідомлення про помилку. Alike надсилає його як є, без фільтрування. Фото він не містить."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe es el diagnóstico del fallo que registró iOS: la traza, las versiones de la app y de iOS, el modelo de tu dispositivo y, en algunos fallos, el mensaje de error. Alike lo envía tal cual, sin filtrarlo. No contiene fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe es el diagnóstico del fallo que registró iOS: la traza, las versiones de la app y de iOS, el modelo de tu dispositivo y, en algunos fallos, el mensaje de error. Alike lo envía tal cual, sin filtrarlo. No contiene fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório é o diagnóstico da falha registrado pelo iOS: o rastreamento, as versões do app e do iOS, o modelo do seu dispositivo e, em algumas falhas, a mensagem de erro. O Alike o envia como está, sem filtrar. Não contém fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bericht ist die Absturzdiagnose, die iOS aufgezeichnet hat: der Stacktrace, die App- und iOS-Version, dein Gerätemodell und bei manchen Abstürzen die Fehlermeldung. Alike sendet ihn unverändert und ungefiltert. Fotos enthält er nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport est le diagnostic du plantage enregistré par iOS : la trace, les versions de l’app et d’iOS, le modèle de votre appareil et, pour certains plantages, le message d’erreur. Alike l’envoie tel quel, sans filtrage. Il ne contient aucune photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il report è la diagnostica dell’arresto registrata da iOS: lo stack trace, le versioni dell’app e di iOS, il modello del dispositivo e, per alcuni arresti, il messaggio di errore. Alike lo invia così com’è, senza filtrarlo. Non contiene foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het rapport is de crashdiagnose die iOS heeft vastgelegd: de stacktrace, de app- en iOS-versie, je apparaatmodel en bij sommige crashes de foutmelding. Alike verstuurt het ongewijzigd en ongefilterd. Het bevat geen foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport to diagnostyka awarii zapisana przez iOS: ślad stosu, wersje aplikacji i iOS, model urządzenia oraz, przy niektórych awariach, komunikat o błędzie. Alike wysyła go bez zmian i bez filtrowania. Nie zawiera zdjęć."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapor, iOS'un kaydettiği çökme tanılamasıdır: yığın izi, uygulama ve iOS sürümleri, cihaz modeliniz ve bazı çökmelerde hata mesajı. Alike onu filtrelemeden, olduğu gibi gönderir. Fotoğraf içermez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告是 iOS 記錄的當機診斷：堆疊追蹤、App 與 iOS 版本、裝置型號，部分當機還包含錯誤訊息。Alike 會原封不動地寄出，不做過濾。報告不含照片。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقرير هو تشخيص التعطل الذي سجّله iOS: تتبّع المكدّس وإصدارا التطبيق وiOS وطراز جهازك، وفي بعض حالات التعطل رسالة الخطأ. يرسله Alike كما هو دون تنقيح. ولا يحتوي على صور."
          }
        }
      }
    },
