    "appintents.openReview.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a review category in Alike, such as similar photos or screenshots."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває категорію перегляду в Alike, наприклад схожі фото або знімки екрана."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una categoría de revisión en Alike, como fotos similares o capturas de pantalla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una categoría de revisión en Alike, como fotos similares o capturas de pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma categoria de revisão no Alike, como fotos semelhantes ou capturas de tela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine Prüfkategorie in Alike, etwa ähnliche Fotos oder Bildschirmfotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une catégorie à vérifier dans Alike, comme les photos similaires ou les captures d’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una categoria da rivedere in Alike, come foto simili o screenshot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een controlecategorie in Alike, zoals vergelijkbare foto's of schermafbeeldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera kategorię przeglądu w Alike, na przykład podobne zdjęcia lub zrzuty ekranu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike’ta benzer fotoğraflar veya ekran görüntüleri gibi bir inceleme kategorisini açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Alike 中開啟檢視類別，例如相似照片或螢幕截圖。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح فئة مراجعة في Alike، مثل الصور المتشابهة أو لقطات الشاشة."
          }
        }
      }
    },
