          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alle foto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fototoegang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do zdjęć"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf erişimi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片取用權"
          }
        },
        "ar": {
