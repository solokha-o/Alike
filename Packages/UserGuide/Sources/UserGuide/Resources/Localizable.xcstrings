    "userGuide.scanning.status.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your first scan the card shows when it ran, how many opportunities were found, and how much space they hold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після першого сканування картка показує, коли воно відбулося, скільки знайдено можливостей і скільки місця вони займають."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tu primer análisis, la tarjeta muestra cuándo se hizo, cuántas oportunidades se encontraron y cuánto espacio ocupan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tu primer análisis, la tarjeta muestra cuándo se ha hecho, cuántas oportunidades se han encontrado y cuánto espacio ocupan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da primeira análise, o cartão mostra quando ela rodou, quantas oportunidades foram encontradas e quanto espaço elas ocupam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach deinem ersten Scan zeigt die Karte, wann er lief, wie viele Möglichkeiten gefunden wurden und wie viel Speicher darin steckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre première analyse, la fiche indique quand elle a eu lieu, combien de possibilités ont été trouvées et l’espace qu’elles représentent."
          }
        }
      }
    },
    "userGuide.scanning.status.card.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last scan at a glance"
          }
