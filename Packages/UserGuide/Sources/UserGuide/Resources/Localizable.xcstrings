    "userGuide.comparingPhotos.review.toggle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the seal button in the navigation bar when you're done with a group. Tap it again to reopen it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся кнопкою з печаткою у панелі навігації, коли завершите роботу з групою. Торкніться ще раз, щоб відкрити її знову."
          }
        }
      }
