    "userGuide.scanning.status.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your first scan the card shows when it ran, how many opportunities were found, and how much space they hold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після першого сканування картка показує, коли воно відбулося, скільки знайдено можливостей і скільки місця вони займають."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tu primer análisis, la tarjeta muestra cuándo se hizo, cuántas oportunidades se encontraron y cuánto espacio ocupan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tu primer análisis, la tarjeta muestra cuándo se ha hecho, cuántas oportunidades se han encontrado y cuánto espacio ocupan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da primeira análise, o cartão mostra quando ela rodou, quantas oportunidades foram encontradas e quanto espaço elas ocupam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach deinem ersten Scan zeigt die Karte, wann er lief, wie viele Möglichkeiten gefunden wurden und wie viel Speicher darin steckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre première analyse, la fiche indique quand elle a eu lieu, combien de possibilités ont été trouvées et l’espace qu’elles représentent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la prima scansione la scheda mostra quando è stata eseguita, quante occasioni sono state trovate e quanto spazio occupano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na je eerste scan toont de kaart wanneer die is uitgevoerd, hoeveel kansen er zijn gevonden en hoeveel ruimte die innemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pierwszym skanowaniu karta pokazuje, kiedy zostało wykonane, ile znaleziono okazji i ile miejsca zajmują."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk taramandan sonra kart, taramanın ne zaman yapıldığını, kaç fırsat bulunduğunu ve ne kadar yer kapladıklarını gösterir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次掃描後，卡片會顯示掃描時間、找到多少可清理項目，以及它們佔用多少空間。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد فحصك الأول تعرض البطاقة موعد إجرائه وعدد الفرص التي عُثر عليها وحجم المساحة التي تشغلها."
          }
        }
      }
    },
