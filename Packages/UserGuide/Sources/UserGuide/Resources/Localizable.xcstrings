    "userGuide.settingsAndReminders.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity, language, the weekly reminder and your subscription."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чутливість, мова, щотижневе нагадування та ваша підписка."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.title": {
      "extractionState": "manual",
