    "core.cleanupCategory.unlockBlurredPhotoCleanupReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock blurred photo cleanup to review likely low-quality shots before deleting them with the same safe confirmation flow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте очищення розмитих фото, щоб переглядати й видаляти ймовірно неякісні кадри з безпечним підтвердженням."
          }
        }
      }
    },
    "core.cleanupCategory.unlockScreenshotCleanupReviewDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock screenshot cleanup to review and delete screenshots with the same safe confirmation flow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте очищення знімків екрана, щоб переглядати й видаляти їх із безпечним підтвердженням."
