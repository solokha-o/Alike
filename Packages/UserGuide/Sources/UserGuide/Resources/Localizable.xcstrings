    "userGuide.comparingPhotos.review.toggle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the seal button in the navigation bar when you're done with a group. Tap it again to reopen it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся кнопкою з печаткою у панелі навігації, коли завершите роботу з групою. Торкніться ще раз, щоб відкрити її знову."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón del sello en la barra de navegación cuando termines con un grupo. Tócalo de nuevo para volver a abrirlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón del sello en la barra de navegación cuando termines con un grupo. Tócalo de nuevo para volver a abrirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão de selo na barra de navegação quando terminar com um grupo. Toque nele de novo para reabrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Siegel-Button in der Navigationsleiste, wenn du mit einer Gruppe fertig bist. Noch einmal tippen öffnet sie wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton en forme de sceau dans la barre de navigation quand vous en avez fini avec un groupe. Touchez-le à nouveau pour le rouvrir."
          }
        }
      }
    },
