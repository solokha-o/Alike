            "state": "translated",
            "value": "Aplicar substitui a edição feita em outro app. O original continua recuperável."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwenden ersetzt die Bearbeitung aus einer anderen App. Das Original bleibt wiederherstellbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
