    "userGuide.cleanupQueue.sections.needsReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups you haven't decided on yet, plus ones a rescan changed. Start here."
