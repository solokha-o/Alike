    "userGuide.comparingPhotos.selection.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection is saved, so closing a group and coming back later loses nothing."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір зберігається, тож ви нічого не втратите, якщо закриєте групу й повернетеся пізніше."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selección se guarda, así que cerrar un grupo y volver más tarde no pierde nada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selección se guarda, así que cerrar un grupo y volver más tarde no pierde nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua seleção é salva, então fechar um grupo e voltar depois não perde nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl wird gesichert – eine Gruppe zu schließen und später zurückzukommen verliert nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sélection est enregistrée : fermer un groupe et y revenir plus tard ne fait rien perdre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua selezione viene salvata: chiudere un gruppo e tornarci più tardi non fa perdere nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je selectie wordt bewaard, dus een groep sluiten en later terugkomen kost je niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wybór jest zapisywany, więc zamknięcie grupy i powrót później niczego nie traci."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimin kaydedilir; bir grubu kapatıp sonra dönmek hiçbir şey kaybettirmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的選取會被儲存，因此關掉群組稍後再回來也不會遺失任何內容。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ تحديدك، لذا فإن إغلاق مجموعة والعودة إليها لاحقًا لا يفقدك شيئًا."
          }
        }
      }
    },
