    "diagnostics.mail.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike attached the crash diagnostic iOS recorded on my device, unchanged: the stack trace, the app and iOS versions, the device model and, for some crashes, the error message. It contains no photos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike додав без змін діагностику збою, яку iOS записала на моєму пристрої: стек викликів, версії застосунку та iOS, модель пристрою і, для деяких збоїв, текст повідомлення про помилку. Фото в ній немає."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike adjuntó sin cambios el diagnóstico del fallo que iOS registró en mi dispositivo: la traza, las versiones de la app y de iOS, el modelo del dispositivo y, en algunos fallos, el mensaje de error. No contiene fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike ha adjuntado sin cambios el diagnóstico del fallo que iOS registró en mi dispositivo: la traza, las versiones de la app y de iOS, el modelo del dispositivo y, en algunos fallos, el mensaje de error. No contiene fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike anexou, sem alterações, o diagnóstico da falha que o iOS registrou no meu dispositivo: o rastreamento, as versões do app e do iOS, o modelo do dispositivo e, em algumas falhas, a mensagem de erro. Não contém fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike hat die Absturzdiagnose, die iOS auf meinem Gerät aufgezeichnet hat, unverändert angehängt: den Stacktrace, die App- und iOS-Version, das Gerätemodell und bei manchen Abstürzen die Fehlermeldung. Sie enthält keine Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike a joint tel quel le diagnostic du plantage enregistré par iOS sur mon appareil : la trace, les versions de l’app et d’iOS, le modèle de l’appareil et, pour certains plantages, le message d’erreur. Il ne contient aucune photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike ha allegato senza modifiche la diagnostica dell’arresto registrata da iOS sul mio dispositivo: lo stack trace, le versioni dell’app e di iOS, il modello del dispositivo e, per alcuni arresti, il messaggio di errore. Non contiene foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike heeft de crashdiagnose die iOS op mijn apparaat vastlegde ongewijzigd bijgevoegd: de stacktrace, de app- en iOS-versie, het apparaatmodel en bij sommige crashes de foutmelding. Er staan geen foto’s in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike dołączył bez zmian diagnostykę awarii zapisaną przez iOS na moim urządzeniu: ślad stosu, wersje aplikacji i iOS, model urządzenia oraz, przy niektórych awariach, komunikat o błędzie. Nie zawiera zdjęć."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike, iOS'un cihazımda kaydettiği çökme tanılamasını değiştirmeden ekledi: yığın izi, uygulama ve iOS sürümleri, cihaz modeli ve bazı çökmelerde hata mesajı. Fotoğraf içermez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike 原封不動地附上了 iOS 在我的裝置上記錄的當機診斷：堆疊追蹤、App 與 iOS 版本、裝置型號，部分當機還包含錯誤訊息。不含任何照片。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرفق Alike دون تعديل تشخيص التعطل الذي سجّله iOS على جهازي: تتبّع المكدّس وإصدارا التطبيق وiOS وطراز الجهاز، وفي بعض حالات التعطل رسالة الخطأ. ولا يحتوي على أي صور."
          }
        }
      }
    },
    "diagnostics.prompt.shareFallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Mail account is set up, so the report goes through the share sheet. Pick a mail app there and send it to:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошту не налаштовано, тому звіт передається через аркуш надсилання. Оберіть там поштовий застосунок і надішліть його на адресу:"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta de Mail configurada, así que el informe se envía por la hoja para compartir. Elige ahí una app de correo y mándalo a:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta de Mail configurada, así que el informe se envía por la hoja para compartir. Elige ahí una app de correo y mándalo a:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há uma conta do Mail configurada, então o relatório passa pela folha de compartilhamento. Escolha um app de e-mail ali e envie para:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein Mail-Account eingerichtet, daher läuft der Bericht über das Teilen-Menü. Wähle dort eine Mail-App und sende ihn an:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte Mail n’est configuré : le rapport passe donc par la feuille de partage. Choisissez-y une app de messagerie et envoyez-le à :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account Mail è configurato, quindi il report passa dal pannello di condivisione. Scegli lì un’app di posta e invialo a:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen Mail-account ingesteld, dus het rapport gaat via het deelvenster. Kies daar een mailapp en stuur het naar:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie skonfigurowano konta Mail, więc raport przechodzi przez arkusz udostępniania. Wybierz tam aplikację pocztową i wyślij go na adres:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail hesabı ayarlanmadığı için rapor paylaşım sayfasından gidiyor. Orada bir e-posta uygulaması seçip şu adrese gönder:"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置尚未設定「郵件」帳號，因此報告會透過分享選單傳送。請在其中選擇郵件 App，並寄到："
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إعداد حساب بريد، لذا يمر التقرير عبر ورقة المشاركة. اختر تطبيق بريد هناك وأرسله إلى:"
          }
        }
      }
    },
    "diagnostics.mail.shareRecipient" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send this crash report to:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надішліть цей звіт про збій на адресу:"
          }
        },
        "es-419" : {
