    "userGuide.privacy.permissions.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested once at the start. You can change or limit it any time in iOS Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитується один раз на початку. Ви можете змінити або обмежити доступ будь-коли в Налаштуваннях iOS."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide una vez al principio. Puedes cambiarlo o limitarlo cuando quieras en Configuración de iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide una vez al principio. Puedes cambiarlo o limitarlo cuando quieras en Ajustes de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido uma vez, no início. Você pode mudar ou limitar isso quando quiser nos Ajustes do iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird einmal zu Beginn angefragt. Du kannst das jederzeit in den iOS-Einstellungen ändern oder einschränken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé une fois au début. Vous pouvez le modifier ou le limiter à tout moment dans les Réglages iOS."
          }
        }
      }
    },
