    "userGuide.cleanupQueue.progress.metrics.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated Savings is how much space your current selection would free once the photos are permanently deleted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оцінена економія» — це місце, яке звільнить поточний вибір після остаточного видалення фото."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro estimado es el espacio que liberaría tu selección actual una vez que las fotos se eliminen de forma permanente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro estimado es el espacio que liberaría tu selección actual una vez que las fotos se eliminen de forma permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A economia estimada é quanto espaço a sua seleção atual liberaria assim que as fotos fossem apagadas definitivamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geschätzte Ersparnis ist der Speicher, den deine aktuelle Auswahl freigibt, sobald die Fotos endgültig gelöscht sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économie estimée correspond à l’espace que votre sélection actuelle libérerait une fois les photos supprimées définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Risparmio stimato» è lo spazio che la selezione attuale libererebbe una volta eliminate definitivamente le foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Geschatte besparing' is hoeveel ruimte je huidige selectie vrijmaakt zodra de foto's definitief zijn verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Szacowana oszczędność” to ilość miejsca, jaką zwolni bieżący wybór po trwałym usunięciu zdjęć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini Kazanç, geçerli seçimindeki fotoğraflar kalıcı olarak silindiğinde açılacak alandır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「預估可省空間」是指目前選取的照片在永久刪除後可釋出的空間。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«التوفير التقديري» هو حجم المساحة التي سيحررها تحديدك الحالي بعد حذف الصور نهائيًا."
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.metrics.title": {
