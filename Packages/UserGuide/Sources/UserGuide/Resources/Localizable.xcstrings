    "userGuide.smartCategories.blurDetection.conservative.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike suggests only the softest few percent of your photos, and only when there are enough to compare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike пропонує лише кілька відсотків найменш різких фото, і лише коли є з чим порівнювати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike sugiere solo el pequeño porcentaje más desenfocado de tus fotos, y solo cuando hay suficientes para comparar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike sugiere solo el pequeño porcentaje más desenfocado de tus fotos, y solo cuando hay suficientes para comparar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike sugere apenas os poucos por cento mais suaves das suas fotos, e só quando há material suficiente para comparar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike schlägt nur die weichsten paar Prozent deiner Fotos vor – und auch nur, wenn es genug zum Vergleichen gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ne propose que les quelques pour cent les plus flous de vos photos, et seulement s’il y a de quoi comparer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike propone solo la piccola percentuale di foto più sfocate, e solo quando ce ne sono abbastanza da confrontare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike stelt alleen de zachtste paar procent van je foto's voor, en alleen als er genoeg zijn om te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike proponuje tylko kilka procent najmniej ostrych zdjęć i tylko wtedy, gdy jest ich dość do porównania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike yalnızca fotoğraflarının en yumuşak birkaç yüzdesini önerir ve bunu ancak karşılaştıracak kadar fotoğraf varsa yapar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 只會建議照片中最模糊的少數幾個百分比，而且僅在數量足以比較時才會這麼做。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقترح Alike سوى النسبة الأقل وضوحًا من صورك، وفقط عندما يتوفر عدد كافٍ منها للمقارنة."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.conservative.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the clearest cases"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише найочевидніші випадки"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los casos más claros"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los casos más claros"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os casos mais claros"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die eindeutigen Fälle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les cas les plus nets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i casi più evidenti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de duidelijkste gevallen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko najbardziej oczywiste przypadki"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca en açık durumlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只挑最明確的情況"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوضح الحالات فقط"
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.favorites.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos you marked as favourites never appear here — mark a photo as a favourite to protect it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, позначені як обрані, тут ніколи не з'являються — позначте фото обраним, щоб захистити його."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que marcaste como favoritas nunca aparecen aquí: marca una foto como favorita para protegerla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que has marcado como favoritas nunca aparecen aquí: marca una foto como favorita para protegerla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos marcadas como favoritas nunca aparecem aqui — marque uma foto como favorita para protegê-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die du als Favoriten markiert hast, erscheinen hier nie – markiere ein Foto als Favorit, um es zu schützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos que vous avez mises en favoris n’apparaissent jamais ici — mettez une photo en favori pour la protéger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto che hai contrassegnato come preferite non compaiono mai qui: contrassegna una foto come preferita per proteggerla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's die je als favoriet hebt gemarkeerd verschijnen hier nooit — markeer een foto als favoriet om die te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia oznaczone jako ulubione nigdy się tu nie pojawiają — oznacz zdjęcie jako ulubione, aby je chronić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori olarak işaretlediğin fotoğraflar burada asla görünmez — bir fotoğrafı korumak için favori yap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你標為最愛的照片絕不會出現在這裡；把照片加入最愛即可保護它。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور التي وضعتها في المفضلة لا تظهر هنا أبدًا — ضع صورة في المفضلة لحمايتها."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.favorites.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites are left alone"
          }
        },
        "uk": {
