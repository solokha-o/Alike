    "userGuide.privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays on your device, what Alike asks for, and how to erase its data."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що залишається на пристрої, що запитує Alike і як стерти його дані."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se queda en tu dispositivo, qué pide Alike y cómo borrar sus datos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se queda en tu dispositivo, qué pide Alike y cómo borrar sus datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que fica no seu dispositivo, o que o Alike pede e como apagar os dados dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was auf deinem Gerät bleibt, wonach Alike fragt und wie du seine Daten löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste sur votre appareil, ce qu’Alike demande, et comment effacer ses données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa resta sul tuo dispositivo, cosa chiede Alike e come cancellarne i dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat op je apparaat blijft, waar Alike om vraagt, en hoe je de gegevens wist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zostaje na Twoim urządzeniu, o co prosi Alike i jak wymazać jego dane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtında neler kalır, Alike neler ister ve verileri nasıl silinir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些內容留在你的裝置上、Alike 會要求什麼，以及如何清除其資料。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يبقى على جهازك، وما يطلبه Alike، وكيفية محو بياناته."
          }
        }
      }
    },
