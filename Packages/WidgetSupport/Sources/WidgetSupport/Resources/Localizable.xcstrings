      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار المساحة التي يمكنك استعادتها، بنظرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einen Blick sehen, wie viel Speicher frei werden kann."
