            "value": "Dostęp i bezpieczeństwo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim ve güvenlik"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取用權與安全性"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول والأمان"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike only ever suggests. Every removal needs your selection and the system confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike лише пропонує. Кожне видалення потребує вашого вибору та системного підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike solo sugiere. Cada eliminación necesita tu selección y la confirmación del sistema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike solo sugiere. Cada eliminación necesita tu selección y la confirmación del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike apenas sugere. Toda remoção depende da sua seleção e da confirmação do sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike schlägt immer nur vor. Jede Entfernung braucht deine Auswahl und die Bestätigung des Systems."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike se contente de suggérer. Chaque suppression passe par votre sélection et la confirmation du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike si limita a suggerire. Ogni rimozione richiede la tua selezione e la conferma di sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike doet alleen suggesties. Elke verwijdering vereist jouw selectie en de systeembevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike jedynie podpowiada. Każde usunięcie wymaga Twojego wyboru i potwierdzenia systemowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike yalnızca öneri sunar. Her kaldırma işlemi senin seçimini ve sistem onayını gerektirir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 只會提出建議。任何移除都需要你的選取和系統確認。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يفعل Alike أكثر من الاقتراح. وكل إزالة تحتاج إلى تحديدك وإلى تأكيد النظام."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted automatically"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється автоматично"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado automaticamente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird automatisch gelöscht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé automatiquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato automaticamente"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets automatisch verwijderd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest usuwane automatycznie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey otomatik olarak silinmez"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動刪除任何內容"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف أي شيء تلقائيًا"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are analysed on device. Nothing is uploaded anywhere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото аналізуються на пристрої. Нічого нікуди не завантажується."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se analizan en el dispositivo. No se sube nada a ningún lado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se analizan en el dispositivo. No se sube nada a ningún lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são analisadas no dispositivo. Nada é enviado para lugar nenhum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden auf dem Gerät analysiert. Nichts wird irgendwohin hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont analysées sur l’appareil. Rien n’est envoyé où que ce soit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono analizzate sul dispositivo. Nulla viene caricato da nessuna parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's worden op het apparaat geanalyseerd. Er wordt niets ergens naartoe geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są analizowane na urządzeniu. Nic nigdzie nie jest przesyłane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar aygıtta analiz edilir. Hiçbir şey hiçbir yere yüklenmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在裝置上分析，不會上傳到任何地方。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحلَّل الصور على الجهاز. ولا يُرفع أي شيء إلى أي مكان."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your iPhone"
          }
        },
        "uk": {
