    "userGuide.gettingStarted.access.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access and safety"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ і безпека"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike only ever suggests. Every removal needs your selection and the system confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike лише пропонує. Кожне видалення потребує вашого вибору та системного підтвердження."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted automatically"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється автоматично"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are analysed on device. Nothing is uploaded anywhere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото аналізуються на пристрої. Нічого нікуди не завантажується."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе працює на вашому iPhone"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs read and write access to your library: read to analyse photos, write to move the ones you pick."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до медіатеки на читання й запис: читання — щоб аналізувати фото, запис — щоб переміщувати вибрані."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до фото"
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop after any step and pick up later — your progress is saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете зупинитися на будь-якому кроці й повернутися пізніше — прогрес зберігається."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three-step loop"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл із трьох кроків"
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm, and the selected photos go to Recently Deleted, where iOS keeps them for 30 days."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте — і вибрані фото потраплять до «Нещодавно видалених», де iOS зберігає їх 30 днів."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Recently Deleted"
