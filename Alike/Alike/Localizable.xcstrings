    "guide.gettingStarted.access.noAutoDelete.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike only ever suggests. Every removal needs your selection and the system confirmation."}},"uk":{"stringUnit":{"state":"translated","value":"Alike лише пропонує. Кожне видалення потребує вашого вибору та системного підтвердження."}}}},
    "guide.gettingStarted.access.noAutoDelete.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing is deleted automatically"}},"uk":{"stringUnit":{"state":"translated","value":"Нічого не видаляється автоматично"}}}},
    "guide.gettingStarted.access.onDevice.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos are analysed on device. Nothing is uploaded anywhere."}},"uk":{"stringUnit":{"state":"translated","value":"Фото аналізуються на пристрої. Нічого нікуди не завантажується."}}}},
    "guide.gettingStarted.access.onDevice.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Everything runs on your iPhone"}},"uk":{"stringUnit":{"state":"translated","value":"Усе працює на вашому iPhone"}}}},
    "guide.gettingStarted.access.permission.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike needs read and write access to your library: read to analyse photos, write to move the ones you pick."}},"uk":{"stringUnit":{"state":"translated","value":"Alike потрібен доступ до медіатеки на читання й запис: читання — щоб аналізувати фото, запис — щоб переміщувати вибрані."}}}},
    "guide.gettingStarted.access.permission.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo access"}},"uk":{"stringUnit":{"state":"translated","value":"Доступ до фото"}}}},
    "guide.gettingStarted.loop.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can stop after any step and pick up later — your progress is saved."}},"uk":{"stringUnit":{"state":"translated","value":"Ви можете зупинитися на будь-якому кроці й повернутися пізніше — прогрес зберігається."}}}},
    "guide.gettingStarted.loop.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The three-step loop"}},"uk":{"stringUnit":{"state":"translated","value":"Цикл із трьох кроків"}}}},
    "guide.gettingStarted.loop.move.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm, and the selected photos go to Recently Deleted, where iOS keeps them for 30 days."}},"uk":{"stringUnit":{"state":"translated","value":"Підтвердьте — і вибрані фото потраплять до «Нещодавно видалених», де iOS зберігає їх 30 днів."}}}},
    "guide.gettingStarted.loop.move.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move to Recently Deleted"}},"uk":{"stringUnit":{"state":"translated","value":"Перемістіть у «Нещодавно видалені»"}}}},
    "guide.gettingStarted.loop.review.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open a group on the Cleanup tab, compare the photos, and choose which ones you no longer need."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте групу на вкладці «Очищення», порівняйте фото й оберіть ті, які більше не потрібні."}}}},
    "guide.gettingStarted.loop.review.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review"}},"uk":{"stringUnit":{"state":"translated","value":"Переглядайте"}}}},
    "guide.gettingStarted.loop.scan.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ALI looks through your photo library on the Scanner tab and groups photos that look alike."}},"uk":{"stringUnit":{"state":"translated","value":"На вкладці «Сканер» ALI переглядає вашу медіатеку та групує схожі фото."}}}},
    "guide.gettingStarted.loop.scan.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan"}},"uk":{"stringUnit":{"state":"translated","value":"Скануйте"}}}},
    "guide.gettingStarted.scope.blurred.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos that look out of focus, gathered for you to check before removing."}},"uk":{"stringUnit":{"state":"translated","value":"Фото, що виглядають нерізкими, зібрані для перевірки перед видаленням."}}}},
    "guide.gettingStarted.scope.blurred.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Blurred Photos"}},"uk":{"stringUnit":{"state":"translated","value":"Розмиті фото"}}}},
    "guide.gettingStarted.scope.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike analyses photos only. Videos are never read or included in a scan."}},"uk":{"stringUnit":{"state":"translated","value":"Alike аналізує лише фото. Відео ніколи не зчитуються й не потрапляють у сканування."}}}},
    "guide.gettingStarted.scope.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What Alike looks at"}},"uk":{"stringUnit":{"state":"translated","value":"Що аналізує Alike"}}}},
    "guide.gettingStarted.scope.screenshots.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Screen captures are kept out of similarity groups and collected in their own category."}},"uk":{"stringUnit":{"state":"translated","value":"Знімки екрана не потрапляють до груп схожих фото, а збираються в окрему категорію."}}}},
    "guide.gettingStarted.scope.screenshots.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshots"}},"uk":{"stringUnit":{"state":"translated","value":"Знімки екрана"}}}},
    "guide.gettingStarted.scope.similar.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Bursts and near-duplicates that look alike — the same moment shot several times."}},"uk":{"stringUnit":{"state":"translated","value":"Серії та майже однакові знімки — один момент, зроблений кілька разів."}}}},
    "guide.gettingStarted.scope.similar.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Similar Photos"}},"uk":{"stringUnit":{"state":"translated","value":"Схожі фото"}}}},
    "guide.gettingStarted.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What Alike does, what it looks at, and the three-step loop."}},"uk":{"stringUnit":{"state":"translated","value":"Що робить Alike, що аналізує та як влаштований цикл із трьох кроків."}}}},
    "guide.gettingStarted.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Getting started"}},"uk":{"stringUnit":{"state":"translated","value":"Початок роботи"}}}},
    "guide.hub.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike never removes a photo without your confirmation."}},"uk":{"stringUnit":{"state":"translated","value":"Alike ніколи не видаляє фото без вашого підтвердження."}}}},
    "guide.hub.intro": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike finds photos worth a second look, and lets you decide what stays."}},"uk":{"stringUnit":{"state":"translated","value":"Alike знаходить фото, які варто переглянути ще раз, а рішення залишає за вами."}}}},
    "guide.hub.noResults": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No Results"}},"uk":{"stringUnit":{"state":"translated","value":"Нічого не знайдено"}}}},
    "guide.hub.noResults.message": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try a different word, or browse the topics."}},"uk":{"stringUnit":{"state":"translated","value":"Спробуйте інше слово або перегляньте розділи."}}}},
    "guide.hub.searchPrompt": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search the guide"}},"uk":{"stringUnit":{"state":"translated","value":"Пошук у довідці"}}}},
    "guide.hub.topic.hint": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens this guide topic"}},"uk":{"stringUnit":{"state":"translated","value":"Відкриває цей розділ довідки"}}}},
    "guide.hub.topics.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Topics"}},"uk":{"stringUnit":{"state":"translated","value":"Розділи"}}}},
    "guide.privacy.deleteData.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Find it in Settings, under Data & Privacy. It can't be undone."}},"uk":{"stringUnit":{"state":"translated","value":"Знайдете в «Налаштуваннях», у розділі «Дані та приватність». Скасувати неможливо."}}}},
    "guide.privacy.deleteData.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete Alike Data"}},"uk":{"stringUnit":{"state":"translated","value":"Видалити дані Alike"}}}},
    "guide.privacy.deleteData.kept.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your photos, your Recently Deleted album, your photo access, and your Alike Pro subscription."}},"uk":{"stringUnit":{"state":"translated","value":"Ваші фото, альбом «Нещодавно видалені», доступ до фото та підписка Alike Pro."}}}},
    "guide.privacy.deleteData.kept.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What stays untouched"}},"uk":{"stringUnit":{"state":"translated","value":"Що залишається недоторканим"}}}},
    "guide.privacy.deleteData.removed.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan results and analysis caches, cleanup progress and history, and your Alike preferences."}},"uk":{"stringUnit":{"state":"translated","value":"Результати сканування й кеші аналізу, прогрес та історія очищення, а також ваші налаштування Alike."}}}},
    "guide.privacy.deleteData.removed.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What gets erased"}},"uk":{"stringUnit":{"state":"translated","value":"Що стирається"}}}},
    "guide.privacy.deleteData.replay.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike shows its introduction again afterwards, without asking for photo access a second time."}},"uk":{"stringUnit":{"state":"translated","value":"Після цього Alike знову покаже вступ, не запитуючи доступ до фото вдруге."}}}},
    "guide.privacy.deleteData.replay.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting fresh"}},"uk":{"stringUnit":{"state":"translated","value":"Початок з чистого аркуша"}}}},
    "guide.privacy.onDevice.analysis.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos are compared using Apple's on-device vision framework, and the results are stored locally."}},"uk":{"stringUnit":{"state":"translated","value":"Фото порівнюються за допомогою системного фреймворку Apple на пристрої, а результати зберігаються локально."}}}},
    "guide.privacy.onDevice.analysis.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Analysis never leaves your iPhone"}},"uk":{"stringUnit":{"state":"translated","value":"Аналіз не залишає ваш iPhone"}}}},
    "guide.privacy.onDevice.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike has no account, no sign-in, and no server of its own."}},"uk":{"stringUnit":{"state":"translated","value":"В Alike немає облікового запису, входу чи власного сервера."}}}},
    "guide.privacy.onDevice.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"On your device"}},"uk":{"stringUnit":{"state":"translated","value":"На вашому пристрої"}}}},
    "guide.privacy.onDevice.network.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The only network requests Alike makes are to the App Store, for subscriptions."}},"uk":{"stringUnit":{"state":"translated","value":"Єдині мережеві запити Alike — до App Store, для підписок."}}}},
    "guide.privacy.onDevice.network.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your photos are never uploaded"}},"uk":{"stringUnit":{"state":"translated","value":"Ваші фото ніколи не завантажуються"}}}},
    "guide.privacy.permissions.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What Alike asks for"}},"uk":{"stringUnit":{"state":"translated","value":"Що запитує Alike"}}}},
    "guide.privacy.permissions.notifications.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Requested only if you turn on the weekly cleanup reminder, and never otherwise."}},"uk":{"stringUnit":{"state":"translated","value":"Запитуються, лише якщо ви ввімкнете щотижневе нагадування, і більше ніколи."}}}},
    "guide.privacy.permissions.notifications.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications"}},"uk":{"stringUnit":{"state":"translated","value":"Сповіщення"}}}},
    "guide.privacy.permissions.photos.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Requested once at the start. You can change or limit it any time in iOS Settings."}},"uk":{"stringUnit":{"state":"translated","value":"Запитується один раз на початку. Ви можете змінити або обмежити доступ будь-коли в Налаштуваннях iOS."}}}},
    "guide.privacy.permissions.photos.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo library"}},"uk":{"stringUnit":{"state":"translated","value":"Медіатека"}}}},
    "guide.privacy.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What stays on your device, what Alike asks for, and how to erase its data."}},"uk":{"stringUnit":{"state":"translated","value":"Що залишається на пристрої, що запитує Alike і як стерти його дані."}}}},
    "guide.privacy.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy and your data"}},"uk":{"stringUnit":{"state":"translated","value":"Приватність і ваші дані"}}}},
    "guide.scanning.rescan.error.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The card explains what went wrong and offers Retry. Earlier results stay available in the meantime."}},"uk":{"stringUnit":{"state":"translated","value":"Картка пояснює, що сталося, і пропонує повторити. Попередні результати тим часом залишаються доступними."}}}},
    "guide.scanning.rescan.error.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A scan didn't finish"}},"uk":{"stringUnit":{"state":"translated","value":"Сканування не завершилося"}}}},
    "guide.scanning.rescan.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A refresh that runs by itself after you move photos does not count against your free scans."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення, яке запускається саме після переміщення фото, не витрачає безкоштовні сканування."}}}},
    "guide.scanning.rescan.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"When to scan again"}},"uk":{"stringUnit":{"state":"translated","value":"Коли сканувати знову"}}}},
    "guide.scanning.rescan.libraryChanged.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"When you add or remove photos elsewhere, Alike marks the results as needing a refresh and offers to rescan."}},"uk":{"stringUnit":{"state":"translated","value":"Коли ви додаєте чи видаляєте фото деінде, Alike позначає результати як застарілі й пропонує пересканувати."}}}},
    "guide.scanning.rescan.libraryChanged.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your library changed"}},"uk":{"stringUnit":{"state":"translated","value":"Медіатека змінилася"}}}},
    "guide.scanning.rescan.sensitivity.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sensitivity decides how alike two photos must be to land in the same group, so Alike asks to rescan after you change it."}},"uk":{"stringUnit":{"state":"translated","value":"Чутливість визначає, наскільки схожими мають бути фото для однієї групи, тому після зміни Alike пропонує пересканувати."}}}},
    "guide.scanning.rescan.sensitivity.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You changed sensitivity"}},"uk":{"stringUnit":{"state":"translated","value":"Ви змінили чутливість"}}}},
    "guide.scanning.run.background.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scanning continues when you switch tabs. Cleanup refreshes on its own once it finishes."}},"uk":{"stringUnit":{"state":"translated","value":"Сканування триває, коли ви перемикаєте вкладки. Після завершення «Очищення» оновиться саме."}}}},
    "guide.scanning.run.background.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep using the app while it works"}},"uk":{"stringUnit":{"state":"translated","value":"Користуйтеся застосунком під час сканування"}}}},
    "guide.scanning.run.cache.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike remembers what it learned about each photo and only re-analyses what actually changed."}},"uk":{"stringUnit":{"state":"translated","value":"Alike запам'ятовує результати для кожного фото й повторно аналізує лише те, що справді змінилося."}}}},
    "guide.scanning.run.cache.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Later scans are faster"}},"uk":{"stringUnit":{"state":"translated","value":"Наступні сканування швидші"}}}},
    "guide.scanning.run.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Scanner card changes as the scan progresses and tells you what to do next."}},"uk":{"stringUnit":{"state":"translated","value":"Картка сканера змінюється під час сканування й підказує, що робити далі."}}}},
    "guide.scanning.run.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Running a scan"}},"uk":{"stringUnit":{"state":"translated","value":"Запуск сканування"}}}},
    "guide.scanning.run.start.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap the button on the Scanner tab. A progress bar shows how far along the analysis is."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть кнопку на вкладці «Сканер». Індикатор покаже, скільки залишилося аналізувати."}}}},
    "guide.scanning.run.start.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Start scanning"}},"uk":{"stringUnit":{"state":"translated","value":"Почати сканування"}}}},
    "guide.scanning.status.allowance.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike Free includes three scans each calendar month. The counter resets at the start of the next month."}},"uk":{"stringUnit":{"state":"translated","value":"Alike Free містить три сканування щокалендарного місяця. Лічильник оновлюється на початку наступного місяця."}}}},
    "guide.scanning.status.allowance.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Free scans remaining"}},"uk":{"stringUnit":{"state":"translated","value":"Залишок безкоштовних сканувань"}}}},
    "guide.scanning.status.card.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"After your first scan the card shows when it ran, how many opportunities were found, and how much space they hold."}},"uk":{"stringUnit":{"state":"translated","value":"Після першого сканування картка показує, коли воно відбулося, скільки знайдено можливостей і скільки місця вони займають."}}}},
    "guide.scanning.status.card.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Last scan at a glance"}},"uk":{"stringUnit":{"state":"translated","value":"Огляд останнього сканування"}}}},
    "guide.scanning.status.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Library status"}},"uk":{"stringUnit":{"state":"translated","value":"Стан медіатеки"}}}},
    "guide.scanning.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Running a scan, reading the Scanner card, and knowing when to rescan."}},"uk":{"stringUnit":{"state":"translated","value":"Як запустити сканування, читати картку сканера та коли повторювати."}}}},
    "guide.scanning.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scanning your library"}},"uk":{"stringUnit":{"state":"translated","value":"Сканування медіатеки"}}}},
    "guide.settingsAndReminders.analysis.columns.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sets the default number of columns for photo grids across the app."}},"uk":{"stringUnit":{"state":"translated","value":"Задає типову кількість колонок для сіток фото в усьому застосунку."}}}},
    "guide.settingsAndReminders.analysis.columns.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Grid Columns"}},"uk":{"stringUnit":{"state":"translated","value":"Стовпців у сітці"}}}},
    "guide.settingsAndReminders.analysis.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Changing sensitivity asks for a rescan, because the groups have to be built again."}},"uk":{"stringUnit":{"state":"translated","value":"Зміна чутливості потребує пересканування, бо групи доводиться будувати заново."}}}},
    "guide.settingsAndReminders.analysis.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tuning the results"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування результатів"}}}},
    "guide.settingsAndReminders.analysis.language.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike is available in English and Ukrainian. The switch opens the iOS Settings page for the app."}},"uk":{"stringUnit":{"state":"translated","value":"Alike доступний англійською та українською. Перемикач відкриває сторінку застосунку в Налаштуваннях iOS."}}}},
    "guide.settingsAndReminders.analysis.language.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Change Language"}},"uk":{"stringUnit":{"state":"translated","value":"Змінити мову"}}}},
    "guide.settingsAndReminders.analysis.sensitivity.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Low groups only near-identical photos. High casts a wider net and finds more, but loosely related, matches."}},"uk":{"stringUnit":{"state":"translated","value":"«Низька» групує лише майже однакові фото. «Висока» шукає ширше й знаходить більше, але менш споріднених збігів."}}}},
    "guide.settingsAndReminders.analysis.sensitivity.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sensitivity"}},"uk":{"stringUnit":{"state":"translated","value":"Чутливість"}}}},
    "guide.settingsAndReminders.reminder.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder is off until you turn it on, and asks for notification permission the first time."}},"uk":{"stringUnit":{"state":"translated","value":"Нагадування вимкнене, доки ви його не ввімкнете, і першого разу запитує дозвіл на сповіщення."}}}},
    "guide.settingsAndReminders.reminder.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Weekly cleanup reminder"}},"uk":{"stringUnit":{"state":"translated","value":"Щотижневе нагадування про очищення"}}}},
    "guide.settingsAndReminders.reminder.schedule.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike Pro lets you move the reminder to whichever day and time suits you."}},"uk":{"stringUnit":{"state":"translated","value":"Alike Pro дозволяє перенести нагадування на зручні вам день і час."}}}},
