    "userGuide.privacy.permissions.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested only if you turn on the weekly cleanup reminder, and never otherwise."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуються, лише якщо ви ввімкнете щотижневе нагадування, і більше ніколи."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide solo si activas el recordatorio semanal de limpieza; nunca en otro caso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide solo si activas el recordatorio semanal de limpieza; nunca en otro caso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido apenas se você ativar o lembrete semanal de limpeza, e nunca em outra situação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur angefragt, wenn du die wöchentliche Aufräum-Erinnerung einschaltest, sonst nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé uniquement si vous activez le rappel de nettoyage hebdomadaire, jamais autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richieste solo se attivi il promemoria settimanale di pulizia, mai in altri casi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gevraagd als je de wekelijkse opruimherinnering inschakelt, en anders nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane tylko wtedy, gdy włączysz cotygodniowe przypomnienie o porządkach — nigdy w innym przypadku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca haftalık temizlik anımsatıcısını açarsan istenir, başka hiçbir durumda değil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你開啟每週清理提醒時才會要求，其他情況一律不會。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب فقط إذا فعّلت تذكير التنظيف الأسبوعي، ولا يُطلب في غير ذلك أبدًا."
          }
        }
      }
    },
