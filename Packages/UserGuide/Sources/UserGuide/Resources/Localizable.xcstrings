    "userGuide.gettingStarted.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Alike does, what it looks at, and the three-step loop."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що робить Alike, що аналізує та як влаштований цикл із трьох кроків."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hace Alike, qué mira y el ciclo de tres pasos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hace Alike, qué mira y el ciclo de tres pasos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Alike faz, o que ele observa e o ciclo de três etapas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Alike macht, was es ansieht und der Dreischritt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait Alike, ce qu’il regarde et la boucle en trois étapes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fa Alike, cosa guarda e il ciclo in tre passi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Alike doet, waar het naar kijkt, en de cyclus in drie stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co robi Alike, na co patrzy i trzyetapowy cykl."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ne yapar, neye bakar ve üç adımlı döngü."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 的用途、觀察範圍，以及三步驟循環。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يفعله Alike، وما الذي ينظر إليه، والدورة المكوّنة من ثلاث خطوات."
          }
        }
      }
    },
