    "cleanup.cleanupHistory.estimatedReclaimable1PhotoMoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estimated reclaimable, 1 photo moved to Recently Deleted"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ орієнтовно можна звільнити, 1 фото переміщено до «Недавно видалені»"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperables estimados, 1 foto movida a Eliminados recientemente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperables estimados, 1 foto movida a Eliminados recientemente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperáveis estimados, 1 foto movida para Apagados recentemente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "geschätzt %@ freigebbar, 1 Foto in „Zuletzt gelöscht“ bewegt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ récupérables estimés, 1 photo déplacée vers Supprimés récemment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperabili stimati, 1 foto spostata in «Eliminati di recente»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geschat vrij te maken, 1 foto naar 'Recent verwijderd' verplaatst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ szacowanego miejsca do odzyskania, 1 zdjęcie przeniesione do albumu „Ostatnio usunięte”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini %@ geri kazanılabilir, 1 fotoğraf Son Silinenler'e taşındı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預估可回收 %@，已將 1 張照片移到「最近刪除」"
          }
        }
      }
    },
