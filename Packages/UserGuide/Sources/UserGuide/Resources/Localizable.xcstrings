    "userGuide.privacy.onDevice.analysis.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are compared using Apple's on-device vision framework, and the results are stored locally."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото порівнюються за допомогою системного фреймворку Apple на пристрої, а результати зберігаються локально."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se comparan con el framework de visión en el dispositivo de Apple y los resultados se guardan localmente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se comparan con el framework de visión en el dispositivo de Apple y los resultados se guardan localmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são comparadas com o framework de visão no dispositivo da Apple, e os resultados ficam salvos localmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden mit Apples Vision-Framework auf dem Gerät verglichen, und die Ergebnisse bleiben lokal gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont comparées avec le framework de vision sur l’appareil d’Apple, et les résultats sont stockés localement."
          }
        }
      }
    },
    "userGuide.privacy.onDevice.analysis.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis never leaves your iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз не залишає ваш iPhone"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis nunca sale de tu iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis nunca sale de tu iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise nunca sai do seu iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse verlässt dein iPhone nie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse ne quitte jamais votre iPhone"
          }
        }
      }
    },
    "userGuide.privacy.onDevice.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike has no account, no sign-in, and no server of its own."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В Alike немає облікового запису, входу чи власного сервера."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no tiene cuenta, ni inicio de sesión, ni servidor propio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no tiene cuenta, ni inicio de sesión, ni servidor propio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike não tem conta, nem login, nem servidor próprio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike hat keinen Account, keine Anmeldung und keinen eigenen Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike n’a ni compte, ni connexion, ni serveur propre."
          }
        }
      }
    },
