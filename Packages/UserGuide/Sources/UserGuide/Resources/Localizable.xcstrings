            "state": "translated",
            "value": "تتحرر المساحة في النهاية"
          }
        }
      }
    },
    "userGuide.deletingSafely.history.activity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A timeline grouped by month, so you can see what you cleaned up and when."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрічка, згрупована за місяцями, щоб бачити, що і коли ви очистили."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de tiempo agrupada por mes, para que veas qué limpiaste y cuándo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de tiempo agrupada por mes, para que veas qué has limpiado y cuándo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha do tempo agrupada por mês, para você ver o que limpou e quando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine nach Monaten gruppierte Zeitleiste, damit du siehst, was du wann aufgeräumt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chronologie groupée par mois, pour voir ce que vous avez nettoyé et quand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cronologia raggruppata per mese, così vedi cosa hai pulito e quando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tijdlijn per maand, zodat je ziet wat je wanneer hebt opgeruimd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oś czasu pogrupowana według miesięcy, dzięki czemu widzisz, co i kiedy uporządkowałeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aya göre gruplandırılmış bir zaman çizelgesi; neyi ne zaman temizlediğini görürsün."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依月份分組的時間軸，讓你看見自己何時清理了什麼。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خط زمني مجمَّع حسب الشهر، لتتمكن من رؤية ما نظّفته ومتى."
          }
        }
      }
    },
