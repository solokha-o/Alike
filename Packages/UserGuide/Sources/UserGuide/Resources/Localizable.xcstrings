    "userGuide.smartCategories.workflow.select.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One button selects everything or clears the selection, and the summary keeps a running total."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка вибирає все або знімає вибір, а зведення показує поточний підсумок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón selecciona todo o quita la selección, y el resumen mantiene el total actualizado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón selecciona todo o quita la selección, y el resumen mantiene el total actualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão seleciona tudo ou limpa a seleção, e o resumo mantém o total atualizado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Button wählt alles aus oder hebt die Auswahl auf, und die Zusammenfassung hält die Summe aktuell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton sélectionne tout ou efface la sélection, et le résumé tient le total à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pulsante seleziona tutto o azzera la selezione, e il riepilogo tiene il totale aggiornato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén knop selecteert alles of wist de selectie, en het overzicht houdt een lopend totaal bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden przycisk zaznacza wszystko lub czyści wybór, a podsumowanie prowadzi bieżącą sumę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir düğme her şeyi seçer ya da seçimi temizler; özet güncel toplamı tutar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個按鈕即可全選或清除選取，摘要會即時更新總計。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زر واحد يحدد كل شيء أو يمسح التحديد، ويحتفظ الملخص بإجمالٍ جارٍ."
          }
        }
      }
    },
