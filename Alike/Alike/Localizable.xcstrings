    "guide.smartCategories.workflow.inspect.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Same tools as a group"}},"uk":{"stringUnit":{"state":"translated","value":"Ті самі інструменти, що й у групі"}}}},
