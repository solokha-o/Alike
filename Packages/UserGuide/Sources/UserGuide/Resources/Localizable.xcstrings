    "userGuide.gettingStarted.scope.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analyses photos only. Videos are never read or included in a scan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike аналізує лише фото. Відео ніколи не зчитуються й не потрапляють у сканування."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analiza solo fotos. Los videos nunca se leen ni se incluyen en un análisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analiza solo fotos. Los vídeos nunca se leen ni se incluyen en un análisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike analisa apenas fotos. Vídeos nunca são lidos nem incluídos em uma análise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analysiert ausschließlich Fotos. Videos werden nie gelesen und nie in einen Scan einbezogen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analyse uniquement les photos. Les vidéos ne sont jamais lues ni incluses dans une analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analizza solo le foto. I video non vengono mai letti né inclusi in una scansione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analyseert alleen foto's. Video's worden nooit gelezen of meegenomen in een scan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analizuje tylko zdjęcia. Filmy nigdy nie są odczytywane ani uwzględniane w skanowaniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike yalnızca fotoğrafları analiz eder. Videolar hiçbir zaman okunmaz ya da taramaya dahil edilmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 只分析照片。影片絕不會被讀取，也不會納入掃描。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحلل Alike الصور فقط. ولا تُقرأ مقاطع الفيديو أو تُدرَج في الفحص أبدًا."
          }
        }
      }
    },
