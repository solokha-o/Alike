          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Alike esta semana para quitar lo que sobra y seguir ahorrando espacio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Alike esta semana para quitar lo que sobra y seguir ahorrando espacio."
