default_platform(:ios)

require "shellwords"

APP_IDENTIFIER = "com.alike.app"
REPO_ROOT = File.expand_path("..", __dir__)
XCODE_PROJECT = File.join(REPO_ROOT, "Alike", "Alike.xcodeproj")
XCODE_PROJECT_FILE = File.join(XCODE_PROJECT, "project.pbxproj")
RELEASE_SCHEME = "Alike"
BUILD_OUTPUT_PATH = File.join(REPO_ROOT, "build", "fastlane")
RELEASE_ARCHIVE_PATH = File.join(BUILD_OUTPUT_PATH, "AlikeRelease.xcarchive")
GENERATED_STORE_UPLOAD_ROOT = ENV["ALIKE_GENERATED_STORE_UPLOAD_ROOT"] || File.join(REPO_ROOT, "build", "generated", "store_upload")
METADATA_PATH = File.join(GENERATED_STORE_UPLOAD_ROOT, "metadata")
SCREENSHOTS_PATH = File.join(GENERATED_STORE_UPLOAD_ROOT, "screenshots")
PREPARE_STORE_UPLOAD_BUNDLE = File.join(REPO_ROOT, "tools", "prepare_app_store_upload_bundle.py")

def python_executable
  ENV["PYTHON"] || "python3"
end

def prepare_store_upload_bundle
  sh("#{python_executable} #{PREPARE_STORE_UPLOAD_BUNDLE}")
end

def log_store_upload_paths
  UI.message("Alike metadata path: #{METADATA_PATH}")
  UI.message("Alike screenshots path: #{SCREENSHOTS_PATH}")
end

def xcode_marketing_version
  versions = File.read(XCODE_PROJECT_FILE)
                 .scan(/MARKETING_VERSION\s*=\s*([^;]+);/)
                 .flatten
                 .map { |version| version.strip.delete_prefix('"').delete_suffix('"') }
                 .uniq

  unless versions.length == 1
    found_versions = versions.empty? ? "none" : versions.join(", ")
    UI.user_error!("Expected exactly one unique MARKETING_VERSION in #{XCODE_PROJECT_FILE}, found #{found_versions}")
  end

  version = versions.first
  UI.message("Alike App Store Connect app_version: #{version}")
  version
end

def preserve_review_attachments_when_not_configured
  require "deliver/upload_metadata"
  return if Deliver::UploadMetadata.method_defined?(:alike_original_review_attachment_file)

  Deliver::UploadMetadata.class_eval do
    alias_method :alike_original_review_attachment_file, :review_attachment_file

    def review_attachment_file(version)
      return unless options[:app_review_attachment_file]

      alike_original_review_attachment_file(version)
    end
  end
end

def allow_iphone_69_screenshot_size
  require "deliver/app_screenshot"
  return if Deliver::AppScreenshot.singleton_class.method_defined?(:alike_original_devices)

  Deliver::AppScreenshot.singleton_class.class_eval do
    alias_method :alike_original_devices, :devices

    def devices
      values = alike_original_devices
      iphone_69_sizes = [[1320, 2868], [2868, 1320]]
      current = values[Deliver::AppScreenshot::ScreenSize::IOS_67] || []
      values[Deliver::AppScreenshot::ScreenSize::IOS_67] = (current + iphone_69_sizes).uniq
      values
    end
  end
end

def app_store_api_key
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

  UI.user_error!("APP_STORE_CONNECT_KEY_ID is required") if key_id.to_s.empty?
  UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is required") if issuer_id.to_s.empty?

  options = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }

  if !key_filepath.to_s.empty?
    options[:key_filepath] = key_filepath
  elsif !key_content.to_s.empty?
    options[:key_content] = key_content
    options[:is_key_content_base64] = ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true"
  else
    UI.user_error!("APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_CONTENT is required")
  end

  app_store_connect_api_key(options)
end

def xcode_provisioning_args
  return unless ENV["ALIKE_XCODE_ALLOW_PROVISIONING_UPDATES"] == "1"

  args = ["-allowProvisioningUpdates"]
  key_path = ENV["ALIKE_XCODE_AUTHENTICATION_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  key_id = ENV["ALIKE_XCODE_AUTHENTICATION_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["ALIKE_XCODE_AUTHENTICATION_KEY_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

  if !key_path.to_s.empty? && !key_id.to_s.empty? && !issuer_id.to_s.empty?
    args += [
      "-authenticationKeyPath", File.expand_path(key_path),
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    ]
  end

  Shellwords.join(args)
end

def upload_symbols?
  ENV["ALIKE_UPLOAD_SYMBOLS"] == "1"
end

def deliver_store_bundle(skip_metadata:, skip_screenshots:)
  api_key = app_store_api_key
  app_version = xcode_marketing_version
  prepare_store_upload_bundle
  log_store_upload_paths
  preserve_review_attachments_when_not_configured
  allow_iphone_69_screenshot_size unless skip_screenshots

  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    app_version: app_version,
    metadata_path: METADATA_PATH,
    screenshots_path: SCREENSHOTS_PATH,
    skip_binary_upload: true,
    skip_metadata: skip_metadata,
    skip_screenshots: skip_screenshots,
    submit_for_review: false,
    overwrite_screenshots: true,
    run_precheck_before_submit: false,
    force: true
  )
end

platform :ios do
  desc "Prepare and validate the App Store metadata/screenshot bundle without uploading."
  lane :metadata_validate do
    prepare_store_upload_bundle
    log_store_upload_paths
  end

  desc "Upload localized App Store metadata and screenshots without binary upload or review submission."
  lane :metadata_upload do
    deliver_store_bundle(skip_metadata: false, skip_screenshots: false)
  end

  desc "Upload only localized App Store text metadata (descriptions, keywords, review info) without screenshots, binary, or review submission."
  lane :metadata_text_upload do
    deliver_store_bundle(skip_metadata: false, skip_screenshots: true)
  end

  desc "Upload only App Store screenshots without text metadata, binary, or review submission."
  lane :screenshots_upload do
    deliver_store_bundle(skip_metadata: true, skip_screenshots: false)
  end

  desc "Archive the release scheme and upload the build to TestFlight without review submission."
  lane :testflight_upload do
    api_key = app_store_api_key
    ipa_path = ENV["ALIKE_TESTFLIGHT_IPA_PATH"]

    if ipa_path.to_s.empty?
      ipa_path = build_app(
        project: XCODE_PROJECT,
        scheme: RELEASE_SCHEME,
        configuration: "Release",
        export_method: "app-store",
        archive_path: RELEASE_ARCHIVE_PATH,
        output_directory: BUILD_OUTPUT_PATH,
        clean: true,
        include_symbols: upload_symbols?,
        export_xcargs: xcode_provisioning_args
      )
    else
      UI.message("Using release-check IPA for TestFlight upload: #{ipa_path}")
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )
  end
end
