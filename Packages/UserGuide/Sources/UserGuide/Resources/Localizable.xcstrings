          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözden geçirildi, Kalan, Seçildi, Tahmini Kazanç"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢視、尚餘、已選取、預估可省空間"
          }
        },
        "ar": {
          "stringUnit": {
