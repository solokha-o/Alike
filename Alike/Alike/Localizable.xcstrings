    "guide.settingsAndReminders.subscription.restore.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"On a new device, or after reinstalling, this brings your existing subscription back."}},"uk":{"stringUnit":{"state":"translated","value":"На новому пристрої або після перевстановлення це поверне вашу наявну підписку."}}}},
