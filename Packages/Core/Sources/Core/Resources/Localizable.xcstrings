        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü temizliğinin kilidini aç; ekran görüntülerini aynı güvenli onay akışıyla gözden geçir ve sil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
