    "details.clusterDetails.enhancementEditedElsewhere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo was edited in another app, so Alike won't replace that edit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це фото редагували в іншому застосунку, тому Alike не замінює ту правку."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto se editó en otra app, así que Alike no reemplazará esa edición."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto se editó en otra app, así que Alike no reemplazará esa edición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto foi editada em outro app, então o Alike não substituirá essa edição."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto wurde in einer anderen App bearbeitet – Alike ersetzt diese Bearbeitung nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a été modifiée dans une autre app ; Alike ne remplacera pas cette modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto è stata modificata in un'altra app, quindi Alike non sostituirà quella modifica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto is in een andere app bewerkt, dus Alike vervangt die bewerking niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie edytowano w innej aplikacji, więc Alike nie zastąpi tamtej zmiany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf başka bir uygulamada düzenlendi; Alike o düzenlemeyi değiştirmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片是在其他 App 中編輯的，Alike 不會取代該編輯。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُرِّرت هذه الصورة في تطبيق آخر، لذا لن يستبدل Alike ذلك التعديل."
          }
        }
      }
    },
    "details.clusterDetails.enhancementLimitedAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos shared through limited access can't be enhanced. Give Alike access to all photos in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото з обмеженим доступом не можна покращити. Надайте Alike доступ до всіх фото в Налаштуваннях."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos con acceso limitado no se pueden mejorar. Da acceso a todas las fotos en Ajustes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos con acceso limitado no se pueden mejorar. Da acceso a todas las fotos en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos com acesso limitado não podem ser aprimoradas. Libere o acesso a todas as fotos nos Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos mit eingeschränktem Zugriff lassen sich nicht verbessern. Erlaube Alike in den Einstellungen den Zugriff auf alle Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos en accès limité ne peuvent pas être améliorées. Autorisez Alike à accéder à toutes vos photos dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto con accesso limitato non possono essere migliorate. Consenti ad Alike l’accesso a tutte le foto in Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s met beperkte toegang kunnen niet worden verbeterd. Geef Alike in Instellingen toegang tot alle foto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęć z ograniczonym dostępem nie można poprawić. Przyznaj Alike dostęp do wszystkich zdjęć w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı erişimdeki fotoğraflar iyileştirilemez. Ayarlar’dan Alike’a tüm fotoğraflara erişim ver."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受限取用的照片無法優化。請在「設定」中允許 Alike 取用所有照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحسين الصور ذات الوصول المحدود. امنح Alike الوصول إلى كل الصور من الإعدادات."
          }
        }
      }
    },
