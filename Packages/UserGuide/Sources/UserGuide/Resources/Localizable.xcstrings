          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a lista de desfocadas é curta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum die Liste unscharfer Fotos kurz ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi la liste des photos floues est courte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché l'elenco delle sfocate è corto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom de lijst met wazige foto's kort is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego lista rozmytych jest krótka"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulanık listesi neden kısa"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼模糊清單很短"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا قائمة الصور الضبابية قصيرة"
          }
        }
      }
    },
    "userGuide.smartCategories.categories.blurred.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos that look out of focus, based on on-device analysis. Worth checking before you remove them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, які виглядають нерізкими, за результатами аналізу на пристрої. Варто перевірити перед видаленням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, según el análisis en el dispositivo. Vale la pena revisarlas antes de eliminarlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, según el análisis en el dispositivo. Merece la pena revisarlas antes de eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecem fora de foco, segundo a análise no dispositivo. Vale conferir antes de remover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die laut Analyse auf dem Gerät unscharf wirken. Vor dem Entfernen einen Blick wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des photos qui semblent floues d’après l’analyse sur l’appareil. À vérifier avant de les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto che sembrano fuori fuoco, in base all'analisi sul dispositivo. Vale la pena controllarle prima di rimuoverle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's die onscherp lijken, op basis van analyse op het apparaat. Het loont om ze te bekijken voordat je ze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia, które wyglądają na nieostre, według analizy na urządzeniu. Warto je sprawdzić przed usunięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıttaki analize göre odak dışı görünen fotoğraflar. Kaldırmadan önce denetlemekte fayda var."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據裝置端分析看起來失焦的照片。移除前值得先確認。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور تبدو خارج نطاق التركيز، استنادًا إلى تحليل يجري على الجهاز. تستحق التحقق منها قبل إزالتها."
          }
        }
      }
    },
