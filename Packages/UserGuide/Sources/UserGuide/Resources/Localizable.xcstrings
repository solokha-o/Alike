    "userGuide.comparingPhotos.selection.menu.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the ••• menu: select everything but the keeper in one go, or clear the whole selection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У меню ••• : вибрати все, крім кадру, який лишається, або зняти весь вибір."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú •••: selecciona todo menos la que se conserva, o quita toda la selección."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú •••: selecciona todo menos la que se conserva, o quita toda la selección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No menu •••: selecione tudo menos a que fica, ou limpe a seleção inteira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im •••-Menü: alles außer der besten Aufnahme auf einmal auswählen oder die ganze Auswahl aufheben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu ••• : sélectionnez tout sauf celle qui reste, ou effacez toute la sélection."
          }
        }
      }
    },
