    "userGuide.comparingPhotos.review.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking a group reviewed is your decision, not a consequence of selecting photos. You can reopen it at any time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка «переглянуто» — це ваше рішення, а не наслідок вибору фото. Ви завжди можете повернути групу в роботу."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar un grupo como revisado es decisión tuya, no una consecuencia de seleccionar fotos. Puedes volver a abrirlo cuando quieras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar un grupo como revisado es decisión tuya, no una consecuencia de seleccionar fotos. Puedes volver a abrirlo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar um grupo como revisado é decisão sua, não consequência de selecionar fotos. Você pode reabri-lo quando quiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe als geprüft zu markieren ist deine Entscheidung, keine Folge des Auswählens. Du kannst sie jederzeit wieder öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer un groupe comme examiné relève de votre décision, pas d’une conséquence de la sélection. Vous pouvez le rouvrir à tout moment."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing a group"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершення групи"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar un grupo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar un grupo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluindo um grupo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe abschließen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer un groupe"
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.keepAll.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If every photo in a group is worth keeping, mark it reviewed and move on. Nothing has to be removed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо всі фото в групі варті збереження, позначте її переглянутою та йдіть далі. Видаляти нічого не обов'язково."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vale la pena conservar todas las fotos de un grupo, márcalo como revisado y sigue. No hace falta eliminar nada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si merece la pena conservar todas las fotos de un grupo, márcalo como revisado y sigue. No hace falta eliminar nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vale a pena manter todas as fotos de um grupo, marque como revisado e siga em frente. Nada precisa ser removido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jedes Foto einer Gruppe bleiben soll, markiere sie als geprüft und mach weiter. Es muss nichts entfernt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si toutes les photos d’un groupe méritent d’être gardées, marquez-le comme examiné et passez à la suite. Rien n’a besoin d’être supprimé."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.keepAll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping everything counts too"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
