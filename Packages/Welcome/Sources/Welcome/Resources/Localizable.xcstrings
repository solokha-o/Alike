        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike, votre détective photo"
          }
        }
      }
    },
    "welcome.main.analysisStaysDeviceNothingDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis stays on your device, and nothing is deleted automatically."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз виконується на вашому пристрої, і нічого не видаляється автоматично."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se queda en tu dispositivo y no se elimina nada automáticamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se queda en tu dispositivo y no se elimina nada automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise fica no seu dispositivo, e nada é apagado automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse bleibt auf deinem Gerät, und nichts wird automatisch gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse reste sur votre appareil et rien n’est supprimé automatiquement."
          }
        }
      }
    },
