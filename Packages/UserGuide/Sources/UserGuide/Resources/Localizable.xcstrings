          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio si libera alla fine"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruimte komt aan het eind vrij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce zwalnia się na końcu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan en sonda boşalır"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間會在最後才釋出"
          }
        },
        "ar": {
