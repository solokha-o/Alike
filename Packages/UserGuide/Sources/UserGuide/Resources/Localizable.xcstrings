    "userGuide.privacy.onDevice.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike has no account, no sign-in, and no server of its own."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В Alike немає облікового запису, входу чи власного сервера."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no tiene cuenta, ni inicio de sesión, ni servidor propio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike no tiene cuenta, ni inicio de sesión, ni servidor propio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike não tem conta, nem login, nem servidor próprio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike hat keinen Account, keine Anmeldung und keinen eigenen Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike n’a ni compte, ni connexion, ni serveur propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike non ha account, non richiede accesso e non ha server propri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike heeft geen account, geen inlog en geen eigen server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike nie ma konta, logowania ani własnego serwera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın hesabı, oturum açması ve kendine ait bir sunucusu yoktur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 沒有帳號、不需登入，也沒有自己的伺服器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لـ Alike حساب ولا تسجيل دخول ولا خادم خاص به."
          }
        }
      }
    },
