    "welcome.main.knowHowMuchSpaceCould": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know how much space you could reclaim before you clean up."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнавайтеся, скільки місця можна звільнити, ще до очищення."
          }
        }
      }
    },
    "welcome.main.localAlikeDataWasDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local Alike data was deleted. Your photos and subscription are unchanged."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні дані Alike видалено. Ваші фотографії та підписка не змінилися."
          }
        }
      }
    },
