    "welcome.main.everyDeletionStaysConfirmedVisible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deletion stays confirmed, visible, and fully in your hands."
