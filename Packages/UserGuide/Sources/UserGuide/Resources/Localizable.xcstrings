    "userGuide.privacy.permissions.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested once at the start. You can change or limit it any time in iOS Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитується один раз на початку. Ви можете змінити або обмежити доступ будь-коли в Налаштуваннях iOS."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide una vez al principio. Puedes cambiarlo o limitarlo cuando quieras en Configuración de iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide una vez al principio. Puedes cambiarlo o limitarlo cuando quieras en Ajustes de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido uma vez, no início. Você pode mudar ou limitar isso quando quiser nos Ajustes do iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird einmal zu Beginn angefragt. Du kannst das jederzeit in den iOS-Einstellungen ändern oder einschränken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé une fois au début. Vous pouvez le modifier ou le limiter à tout moment dans les Réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesto una volta all'inizio. Puoi modificarlo o limitarlo quando vuoi in Impostazioni di iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer aan het begin gevraagd. Je kunt dit altijd wijzigen of beperken in de iOS-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany raz na początku. Możesz go zmienić lub ograniczyć w każdej chwili w Ustawieniach iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıçta bir kez istenir. İstediğin zaman iOS Ayarları'ndan değiştirebilir ya da sınırlayabilirsin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一開始要求一次。你隨時可以在 iOS「設定」中更改或限制。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب مرة واحدة في البداية. ويمكنك تغييره أو تقييده في أي وقت من إعدادات iOS."
          }
        }
      }
    },
