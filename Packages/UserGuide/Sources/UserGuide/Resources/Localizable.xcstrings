            "state": "translated",
            "value": "30 dias para mudar de ideia"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Tage, um es dir anders zu überlegen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 jours pour changer d’avis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "30 giorni per cambiare idea"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dagen om je te bedenken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dni na zmianę zdania"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikrini değiştirmek için 30 gün"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天可以反悔"
          }
        },
        "ar": {
