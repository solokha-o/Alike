    "userGuide.deletingSafely.flow.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike shows what will be moved and how much space it holds, then hands the request to the system."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike показує, що буде переміщено та скільки місця це займає, а потім передає запит системі."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks for confirmation"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS запитує підтвердження"
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike can't remove a photo on its own — iOS always asks you first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike не може видалити фото самостійно — iOS завжди спершу запитує вас."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.header": {
      "extractionState": "manual",
      "localizations": {
