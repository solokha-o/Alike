            "value": "O ciclo de três etapas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dreischritt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boucle en trois étapes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ciclo in tre passi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cyclus in drie stappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzyetapowy cykl"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç adımlı döngü"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三步驟循環"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدورة المكوّنة من ثلاث خطوات"
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm, and the selected photos go to Recently Deleted, where iOS keeps them for 30 days."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте — і вибрані фото потраплять до «Нещодавно видалених», де iOS зберігає їх 30 днів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma y las fotos seleccionadas pasan a Eliminados recientemente, donde iOS las guarda 30 días."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma y las fotos seleccionadas pasan a Eliminados recientemente, donde iOS las guarda 30 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme e as fotos selecionadas vão para Apagados recentemente, onde o iOS as mantém por 30 dias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, und die ausgewählten Fotos wandern in „Zuletzt gelöscht“, wo iOS sie 30 Tage aufbewahrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez, et les photos sélectionnées partent dans Supprimés récemment, où iOS les garde 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma e le foto selezionate finiscono in «Eliminati di recente», dove iOS le conserva per 30 giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig, en de geselecteerde foto's gaan naar 'Recent verwijderd', waar iOS ze 30 dagen bewaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź, a wybrane zdjęcia trafią do albumu „Ostatnio usunięte”, gdzie iOS przechowa je przez 30 dni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayla; seçili fotoğraflar iOS'un 30 gün sakladığı Son Silinenler'e gider."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後，所選照片會移到「最近刪除」，iOS 會保留 30 天。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد، فتنتقل الصور المحددة إلى «المحذوفة مؤخرًا»، حيث يحتفظ بها iOS مدة 30 يومًا."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.title": {
