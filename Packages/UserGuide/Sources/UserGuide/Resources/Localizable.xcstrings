      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the ••• menu: select everything but the keeper in one go, or clear the whole selection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У меню ••• : вибрати все, крім кадру, який лишається, або зняти весь вибір."
