    "welcome.main.accessGranted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Granted"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ надано"
          }
        }
      }
    },
    "welcome.main.alike": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike"
          }
        }
      }
    },
    "welcome.main.alikeDataDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike data deleted"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані Alike видалено"
          }
        }
      }
    },
    "welcome.main.alikeNeedsPhotoAccessScan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs photo access to scan your library and prepare cleanup suggestions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до фото, щоб сканувати вашу фототеку та підготувати рекомендації для очищення."
          }
        }
      }
    },
    "welcome.main.alikeNeverDeletesPhotosAutomatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike never deletes photos automatically. You review the suggestions first and confirm every cleanup action."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ніколи не видаляє фото автоматично. Ви спочатку переглядаєте рекомендації й підтверджуєте кожну дію."
          }
        }
      }
    },
    "welcome.main.alikeYourPhotoDetective": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike, your photo detective"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike, ваш фотодетектив"
          }
        }
      }
    },
    "welcome.main.analysisStaysDeviceNothingDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis stays on your device, and nothing is deleted automatically."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз виконується на вашому пристрої, і нічого не видаляється автоматично."
          }
        }
      }
    },
    "welcome.main.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "welcome.main.canChangeAccessLaterSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change access later in Settings, and Alike never deletes anything without your confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пізніше ви можете змінити доступ у Налаштуваннях, а Alike нічого не видаляє без вашого підтвердження."
          }
        }
      }
    },
    "welcome.main.canGrantAccessNowReturn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant access now and return to cleanup whenever you're ready."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете надати доступ зараз і повернутися до очищення, коли будете готові."
          }
        }
      }
    },
    "welcome.main.cleanUpLibraryWithConfidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up your library with confidence"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищуйте фототеку впевнено"
          }
        }
      }
    },
    "welcome.main.comparePhotosKeepShotsThat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare photos and keep the shots that matter to you."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнюйте фото й залишайте важливі для вас знімки."
          }
        }
      }
    },
    "welcome.main.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити"
          }
        }
      }
    },
    "welcome.main.enablePhotoAccessSettingsWhen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable photo access in Settings when you're ready to continue."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до фото в Налаштуваннях, коли будете готові продовжити."
          }
        }
      }
    },
    "welcome.main.everyDeletionStaysConfirmedVisible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deletion stays confirmed, visible, and fully in your hands."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне видалення підтверджується, залишається прозорим і повністю у ваших руках."
          }
        }
      }
    },
    "welcome.main.findCleanupOpportunities": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
