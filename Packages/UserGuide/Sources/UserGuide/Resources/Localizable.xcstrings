    "userGuide.cleanupQueue.badges.inReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've selected photos here but haven't marked the group as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вибрали фото в цій групі, але ще не позначили її як переглянуту."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionaste fotos aquí, pero no marcaste el grupo como revisado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has seleccionado fotos aquí, pero no has marcado el grupo como revisado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você selecionou fotos aqui, mas não marcou o grupo como revisado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast hier Fotos ausgewählt, die Gruppe aber nicht als geprüft markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez sélectionné des photos ici, mais sans marquer le groupe comme examiné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai selezionato delle foto qui, ma non hai ancora segnato il gruppo come controllato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt hier foto's geselecteerd, maar de groep nog niet als bekeken gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrałeś tu zdjęcia, ale nie oznaczyłeś grupy jako przejrzanej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada fotoğraf seçtin ama grubu gözden geçirildi olarak işaretlemedin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這裡選了照片，但尚未將群組標示為已檢視。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حددت صورًا هنا لكنك لم تضع علامة على المجموعة بأنها روجعت."
          }
        }
      }
    },
