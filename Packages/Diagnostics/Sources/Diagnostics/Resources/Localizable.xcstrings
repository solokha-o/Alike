          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike fechou inesperadamente"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike wurde unerwartet beendet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike s’est fermé de façon inattendue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike si è chiuso in modo imprevisto"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike is onverwacht gestopt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Alike nieoczekiwanie się zamknęła"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike beklenmedik şekilde kapandı"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
