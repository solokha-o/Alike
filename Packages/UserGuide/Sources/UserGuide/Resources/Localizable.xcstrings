    "userGuide.settingsAndReminders.subscription.restore.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a new device, or after reinstalling, this brings your existing subscription back."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На новому пристрої або після перевстановлення це поверне вашу наявну підписку."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo nuevo, o después de reinstalar, esto recupera tu suscripción actual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo nuevo, o después de reinstalar, esto recupera tu suscripción actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um dispositivo novo, ou depois de reinstalar, isto traz sua assinatura de volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem neuen Gerät oder nach einer Neuinstallation holt das dein bestehendes Abo zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
