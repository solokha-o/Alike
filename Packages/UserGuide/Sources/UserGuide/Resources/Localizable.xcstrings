    "userGuide.comparingPhotos.bestShot.auto.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites come first, then the highest resolution, then the most recent shot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу обрані, потім найвища роздільна здатність, далі — найновіший знімок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van las favoritas, luego la mayor resolución y después la toma más reciente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van las favoritas, luego la mayor resolución y después la toma más reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As favoritas vêm primeiro, depois a maior resolução e então a foto mais recente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten kommen zuerst, dann die höchste Auflösung, dann die neueste Aufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris d’abord, puis la plus haute résolution, puis le cliché le plus récent."
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.auto.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Alike picks it"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як Alike його обирає"
          }
        },
        "es-419": {
