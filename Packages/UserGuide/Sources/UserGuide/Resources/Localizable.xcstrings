    "userGuide.deletingSafely.flow.storage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage comes back only after the photos leave Recently Deleted — automatically after 30 days, or when you empty the album."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пам'ять повертається лише після того, як фото залишать «Нещодавно видалені» — автоматично за 30 днів або коли ви очистите альбом."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio vuelve solo cuando las fotos salen de Eliminados recientemente: automáticamente a los 30 días o cuando vacías el álbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio vuelve solo cuando las fotos salen de Eliminados recientemente: automáticamente a los 30 días o cuando vacías el álbum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço só volta depois que as fotos saem de Apagados recentemente — automaticamente após 30 dias ou quando você esvazia o álbum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher kommt erst zurück, wenn die Fotos „Zuletzt gelöscht“ verlassen – automatisch nach 30 Tagen oder wenn du das Album leerst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace ne revient qu’une fois les photos sorties de Supprimés récemment : automatiquement au bout de 30 jours, ou quand vous videz l’album."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.storage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
