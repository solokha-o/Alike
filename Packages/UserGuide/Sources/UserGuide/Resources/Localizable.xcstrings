    "userGuide.settingsAndReminders.analysis.language.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike is available in English, Ukrainian, Spanish, Portuguese, German, French, Italian, Dutch, Polish, Turkish, Traditional Chinese and Arabic. The switch opens the iOS Settings page for the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike доступний англійською, українською, іспанською, португальською, німецькою, французькою, італійською, нідерландською, польською, турецькою, традиційною китайською та арабською. Перемикач відкриває сторінку програми в Налаштуваннях iOS."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike está disponible en inglés, ucraniano, español, portugués, alemán, francés, italiano, neerlandés, polaco, turco, chino tradicional y árabe. El botón abre la página de la app en Configuración de iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike está disponible en inglés, ucraniano, español, portugués, alemán, francés, italiano, neerlandés, polaco, turco, chino tradicional y árabe. El botón abre la página de la app en Ajustes de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike está disponível em inglês, ucraniano, espanhol, português, alemão, francês, italiano, neerlandês, polonês, turco, chinês tradicional e árabe. O botão abre a página do app nos Ajustes do iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ist auf Englisch, Ukrainisch, Spanisch, Portugiesisch, Deutsch, Französisch, Italienisch, Niederländisch, Polnisch, Türkisch, Chinesisch (traditionell) und Arabisch verfügbar. Der Schalter öffnet die iOS-Einstellungsseite der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike est disponible en anglais, ukrainien, espagnol, portugais, allemand, français, italien, néerlandais, polonais, turc, chinois traditionnel et arabe. Le bouton ouvre la page des Réglages iOS de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike è disponibile in inglese, ucraino, spagnolo, portoghese, tedesco, francese, italiano, olandese, polacco, turco, cinese tradizionale e arabo. Il pulsante apre la pagina dell'app in Impostazioni di iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike is beschikbaar in het Engels, Oekraïens, Spaans, Portugees, Duits, Frans, Italiaans, Nederlands, Pools, Turks, traditioneel Chinees en Arabisch. De schakelaar opent de iOS-instellingenpagina van de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike jest dostępny po angielsku, ukraińsku, hiszpańsku, portugalsku, niemiecku, francusku, włosku, niderlandzku, polsku, turecku, w chińskim tradycyjnym i po arabsku. Przełącznik otwiera stronę aplikacji w Ustawieniach iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike; İngilizce, Ukraynaca, İspanyolca, Portekizce, Almanca, Fransızca, İtalyanca, Felemenkçe, Lehçe, Türkçe, Geleneksel Çince ve Arapça dillerinde kullanılabilir. Bu seçenek uygulamanın iOS Ayarlar sayfasını açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 提供英文、烏克蘭文、西班牙文、葡萄牙文、德文、法文、義大利文、荷蘭文、波蘭文、土耳其文、繁體中文與阿拉伯文。此選項會打開 App 的 iOS「設定」頁面。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر Alike بالإنجليزية والأوكرانية والإسبانية والبرتغالية والألمانية والفرنسية والإيطالية والهولندية والبولندية والتركية والصينية التقليدية والعربية. ويفتح المُبدِّل صفحة إعدادات iOS الخاصة بالتطبيق."
          }
        }
      }
    },
