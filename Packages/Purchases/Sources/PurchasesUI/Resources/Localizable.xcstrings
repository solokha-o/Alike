        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Käufe konnten nicht wiederhergestellt werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
