        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групуйте візуально схожі фото та інші елементи, які варто переглянути."
          }
        }
      }
    },
    "welcome.main.howAlikeHelps": {
      "extractionState": "manual",
      "localizations": {
