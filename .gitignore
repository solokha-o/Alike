# macOS
.DS_Store

# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

## Obj-C/Swift specific
*.hmap
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Build products
DerivedData/
build/

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# Local packages resolve against the app workspace's Package.resolved; the
# per-package copies are build artifacts left behind by `xcodebuild`/`swift test`.
Packages/*/Package.resolved

# Xcode-managed SwiftPM workspace user data
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local App Store Connect / signing configuration.
# The glob matters: this file used to ignore `.env` and nothing else, so a
# backup like `.env.bak-20260809` or `.env.local` showed up as untracked in a
# public repository with the App Store Connect key ID and issuer ID inside it.
.env
.env.*

# Jekyll landing page build output
site/_site/
site/.jekyll-cache/
site/.jekyll-metadata
site/Gemfile.lock
*.cache
*test-logs
*.vscode
.sandbox-home/
# Added by code-review-graph
.code-review-graph/

# Local Ruby/Bundler install for Fastlane
.bundle/
vendor/
Gemfile.lock

# Notion-mirrored progress notes; the board is the source of truth
Docs/task*-plan.md
Docs/phase*-handoff.md

# Build benchmark artifacts from the Xcode build-optimization skills
.build-benchmark/

# WAL sidecars regenerated by every Storage package test run; never ship these
# next to a checked-in migration fixture.
Packages/Storage/Tests/StorageTests/Fixtures/*.sqlite-wal
Packages/Storage/Tests/StorageTests/Fixtures/*.sqlite-shm
