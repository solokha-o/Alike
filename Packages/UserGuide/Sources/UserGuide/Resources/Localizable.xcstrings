    "userGuide.cleanupQueue.badges.notReviewed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't opened this group yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не відкривали цю групу."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no abriste este grupo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no has abierto este grupo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
