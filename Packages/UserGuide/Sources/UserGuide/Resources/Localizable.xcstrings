            "value": "تمت مراجعتها، المتبقي، المحدد، التوفير التقديري"
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.all.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every group Alike found, including the ones you already marked as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі знайдені Alike групи, зокрема ті, які ви вже позначили як переглянуті."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los grupos que encontró Alike, incluidos los que ya marcaste como revisados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los grupos que ha encontrado Alike, incluidos los que ya has marcado como revisados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os grupos que o Alike encontrou, incluindo os que você já marcou como revisados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gruppen, die Alike gefunden hat – auch die, die du schon als geprüft markiert hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les groupes trouvés par Alike, y compris ceux que vous avez déjà marqués comme examinés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i gruppi trovati da Alike, inclusi quelli che hai già segnato come controllati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle groepen die Alike heeft gevonden, ook de groepen die je al als bekeken hebt gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie grupy znalezione przez Alike, łącznie z tymi, które już oznaczyłeś jako przejrzane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın bulduğu tüm gruplar; gözden geçirildi olarak işaretlediklerin de dahil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 找到的所有群組，包括你已標示為已檢視的群組。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مجموعة عثر عليها Alike، بما فيها تلك التي وضعت عليها علامة أنها روجعت."
          }
        }
      }
    },
