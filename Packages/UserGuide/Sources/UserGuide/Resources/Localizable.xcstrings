            "state": "translated",
            "value": "Una scansione non è stata completata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een scan is niet afgerond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie nie zostało ukończone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarama tamamlanmadı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
