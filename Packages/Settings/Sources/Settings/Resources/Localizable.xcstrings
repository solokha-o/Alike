{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.deleteAllDataModel.someDataMayAlreadyHave" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تكون بعض البيانات قد أُزيلت بالفعل. يُرجى المحاولة مرة أخرى لإكمال حذف بيانات Alike."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise wurden bereits einige Daten entfernt. Versuche es erneut, um das Löschen deiner Alike-Daten abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data may already have been removed. Please try again to finish deleting your Alike data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data may already have been removed. Please try again to finish deleting your Alike data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que algunos datos ya se hayan eliminado. Vuelve a intentarlo para terminar de eliminar tus datos de Alike."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que algunos datos ya se hayan eliminado. Vuelve a intentarlo para terminar de eliminar tus datos de Alike."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données ont peut-être déjà été supprimées. Réessayez pour terminer la suppression de vos données Alike."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données ont peut-être déjà été supprimées. Réessayez pour terminer la suppression de vos données Alike."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni dati potrebbero essere già stati rimossi. Riprova per completare l'eliminazione dei dati di Alike."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige gegevens zijn mogelijk al verwijderd. Probeer het opnieuw om het verwijderen van je Alike-gegevens te voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część danych mogła już zostać usunięta. Spróbuj ponownie, aby dokończyć usuwanie danych Alike."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados podem já ter sido removidos. Tente novamente para concluir a exclusão dos seus dados do Alike."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı veriler zaten kaldırılmış olabilir. Alike verilerini silmeyi tamamlamak için yeniden dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі дані вже могли бути видалені. Спробуйте ще раз, щоб завершити видалення даних Alike."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分資料可能已被移除。請再試一次以完成刪除 Alike 資料。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns dados podem já ter sido removidos. Tenta novamente para concluir a eliminação dos teus dados do Alike."
          }
        }
      }
    },
    "settings.main.alikeLearnsWhichPhotosYouPick" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعلم Alike الصور التي تختارها كأفضل لقطة لتحسين الترتيب المستقبلي. تؤدي إعادة التعيين إلى نسيان ذلك والعودة إلى الترتيب الافتراضي — لا يتم إرسال أي شيء مطلقًا خارج جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike lernt, welche Fotos du als beste Aufnahme auswählst, um künftige Rankings zu verbessern. Zurücksetzen vergisst das und kehrt zum Standard-Ranking zurück – nichts verlässt jemals dein Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike learns which photos you pick as Best Shot to improve future rankings. Resetting forgets that and returns to the default ranking — nothing is ever sent off your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike learns which photos you pick as Best Shot to improve future rankings. Resetting forgets that and returns to the default ranking — nothing is ever sent off your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike aprende qué fotos eliges como Mejor Toma para mejorar las clasificaciones futuras. Restablecer olvida eso y vuelve a la clasificación predeterminada; nada sale nunca de tu dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike aprende qué fotos eliges como Mejor Toma para mejorar las clasificaciones futuras. Restablecer olvida eso y vuelve a la clasificación predeterminada; nada sale nunca de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike apprend quelles photos vous choisissez comme Meilleure Photo pour améliorer les classements futurs. La réinitialisation oublie cela et revient au classement par défaut — rien ne quitte jamais votre appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike apprend quelles photos vous choisissez comme Meilleure Photo pour améliorer les classements futurs. La réinitialisation oublie cela et revient au classement par défaut — rien ne quitte jamais votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike impara quali foto scegli come Scatto Migliore per migliorare le classifiche future. Il ripristino dimentica tutto ciò e torna alla classifica predefinita: nulla lascia mai il tuo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike leert welke foto's je als Beste Opname kiest om toekomstige rangschikkingen te verbeteren. Resetten vergeet dat en keert terug naar de standaardrangschikking — er verlaat nooit iets je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike uczy się, które zdjęcia wybierasz jako Najlepsze ujęcie, aby poprawiać przyszłe rankingi. Zresetowanie zapomina to i przywraca domyślny ranking — nic nigdy nie opuszcza Twojego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike aprende quais fotos você escolhe como Melhor Foto para melhorar as classificações futuras. Redefinir esquece isso e volta à classificação padrão — nada é enviado do seu dispositivo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike, gelecekteki sıralamaları iyileştirmek için En İyi Kare olarak hangi fotoğrafları seçtiğinizi öğrenir. Sıfırlama bunu unutur ve varsayılan sıralamaya döner — hiçbir şey cihazınızdan asla gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike запам'ятовує, які фото ви обираєте як Найкращий кадр, щоб покращувати майбутні рейтинги. Скидання забуває це та повертає стандартний рейтинг — дані ніколи не залишають ваш пристрій."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike 會學習你選為「最佳照片」的照片，藉此改善未來的排序。重設會忘記這些學習內容並回到預設排序—任何資料都不會離開你的裝置。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike Pro está ativo"
          }
        }
      }
    },
