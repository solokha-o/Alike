    "welcome.main.photoAccessLetsAlikeScan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до фото дозволяє Alike сканувати фототеку, групувати схожі фото та готувати рекомендації для перегляду."
          }
        }
      }
    },
    "welcome.main.photoAccessRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Access Required"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до фото"
          }
        }
      }
    },
    "welcome.main.photoAnalysisStaysThisDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo analysis stays on this device and gives you guided cleanup suggestions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз фото виконується на цьому пристрої, а Alike готує підказки для прибирання."
          }
        }
      }
    },
    "welcome.main.photosStayPrivateYoullConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay private, and you'll confirm every cleanup before anything is removed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото залишаються приватними, і ви підтвердите кожне очищення перед видаленням."
          }
        }
      }
    },
    "welcome.main.privateAlwaysControl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private and always in your control"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватно й завжди під вашим контролем"
          }
        }
      }
    },
    "welcome.main.privateOnDeviceAnalysis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
