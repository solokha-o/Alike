    "userGuide.comparingPhotos.inspect.info.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a photo for resolution, file type, dates, favourite status, and where it was taken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте фото, щоб побачити роздільну здатність, тип файлу, дати, статус обраного та місце зйомки."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una foto para ver resolución, tipo de archivo, fechas, si es favorita y dónde se tomó."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una foto para ver resolución, tipo de archivo, fechas, si es favorita y dónde se tomó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma foto pressionada para ver resolução, tipo de arquivo, datas, se é favorita e onde foi tirada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Foto gedrückt für Auflösung, Dateityp, Daten, Favoritenstatus und Aufnahmeort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une photo pour voir la résolution, le type de fichier, les dates, le statut de favori et le lieu de prise de vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una foto per vedere risoluzione, tipo di file, date, stato preferito e dove è stata scattata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een foto ingedrukt voor resolutie, bestandstype, datums, favorietstatus en waar de foto is gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj zdjęcie, aby zobaczyć rozdzielczość, typ pliku, daty, status ulubionego i miejsce wykonania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözünürlük, dosya türü, tarihler, favori durumu ve çekildiği yer için bir fotoğrafa uzun bas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按照片可查看解析度、檔案類型、日期、最愛狀態與拍攝地點。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على صورة لعرض الدقة ونوع الملف والتواريخ وحالة التفضيل ومكان التقاطها."
          }
        }
      }
    },
