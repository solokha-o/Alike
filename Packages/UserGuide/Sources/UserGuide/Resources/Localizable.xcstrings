    "userGuide.smartCategories.workflow.inspect.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold for Show Info or Open Original, and adjust columns from the toolbar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте для «Показати інформацію» чи «Відкрити оригінал», а колонки змініть на панелі інструментів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para «Mostrar información» o «Abrir original», y ajusta las columnas desde la barra de herramientas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para «Mostrar información» o «Abrir original», y ajusta las columnas desde la barra de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado para “Mostrar informações” ou “Abrir original”, e ajuste as colunas pela barra de ferramentas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten für „Infos einblenden“ oder „Original öffnen“, und die Spalten über die Symbolleiste anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour « Afficher les infos » ou « Ouvrir l’original », et ajustez les colonnes depuis la barre d’outils."
          }
        }
      }
    },
