    "appintents.openReview.needsPro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This category needs Alike Pro. Opening the upgrade screen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця категорія потребує Alike Pro. Відкриваю екран оновлення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría requiere Alike Pro. Abriendo la pantalla de mejora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoría requiere Alike Pro. Abriendo la pantalla de mejora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta categoria exige o Alike Pro. Abrindo a tela de upgrade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kategorie erfordert Alike Pro. Der Upgrade-Bildschirm wird geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette catégorie nécessite Alike Pro. Ouverture de l’écran de mise à niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa categoria richiede Alike Pro. Apertura della schermata di upgrade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze categorie vereist Alike Pro. Het upgradescherm wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kategoria wymaga Alike Pro. Otwieram ekran ulepszenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategori Alike Pro gerektirir. Yükseltme ekranı açılıyor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此類別需要 Alike Pro。正在開啟升級畫面。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب هذه الفئة Alike Pro. جارٍ فتح شاشة الترقية."
          }
        }
      }
    },
