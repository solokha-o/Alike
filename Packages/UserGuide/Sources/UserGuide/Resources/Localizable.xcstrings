    "userGuide.settingsAndReminders.reminder.weekly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder to spend a few minutes on cleanup. On Alike Free it arrives on Sunday evening."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Делікатне нагадування приділити кілька хвилин очищенню. В Alike Free воно приходить у неділю ввечері."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave para dedicar unos minutos a la limpieza. En Alike Free llega el domingo por la tarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave para dedicar unos minutos a la limpieza. En Alike Free llega el domingo por la tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete leve para dedicar alguns minutos à limpeza. No Alike Free ele chega no domingo à noite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Hinweis, ein paar Minuten aufzuräumen. In Alike Free kommt er am Sonntagabend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel discret pour consacrer quelques minutes au nettoyage. Dans Alike Free, il arrive le dimanche soir."
          }
        }
      }
    },
