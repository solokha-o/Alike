    "appintents.startScan.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Alike and starts a scan of your photo library for similar photos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Alike і починає сканування бібліотеки на схожі фото."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Alike y comienza a escanear tu biblioteca en busca de fotos similares."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Alike y comienza a escanear tu fototeca en busca de fotos similares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Alike e começa a analisar sua biblioteca em busca de fotos semelhantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Alike und startet einen Scan deiner Fotomediathek nach ähnlichen Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Alike et lance l’analyse de votre photothèque à la recherche de photos similaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Alike e avvia l’analisi della libreria per trovare foto simili."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Alike en start een scan van je fotobibliotheek op vergelijkbare foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Alike i rozpoczyna skanowanie biblioteki w poszukiwaniu podobnych zdjęć."
