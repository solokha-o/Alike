    "userGuide.comparingPhotos.selection.tap.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any photo to mark it for removal. Tap again to keep it. The Best Shot can't be selected."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться фото, щоб позначити його для видалення. Торкніться ще раз, щоб залишити. Найкращий кадр вибрати не можна."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier foto para marcarla para eliminar. Tócala de nuevo para conservarla. La mejor toma no se puede seleccionar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier foto para marcarla para eliminar. Tócala de nuevo para conservarla. La mejor toma no se puede seleccionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer foto para marcá-la para remoção. Toque de novo para mantê-la. A melhor foto não pode ser selecionada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Foto an, um es zum Entfernen zu markieren. Noch einmal tippen behält es. Die beste Aufnahme lässt sich nicht auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une photo pour la marquer en vue d’une suppression. Touchez-la à nouveau pour la garder. La meilleure photo ne peut pas être sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una foto per contrassegnarla per la rimozione. Toccala di nuovo per conservarla. Lo scatto migliore non può essere selezionato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een foto om die voor verwijdering te markeren. Tik nogmaals om de foto te bewaren. De beste opname kan niet worden geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zdjęcie, aby oznaczyć je do usunięcia. Stuknij ponownie, aby je zachować. Najlepszego ujęcia nie można wybrać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak üzere işaretlemek için bir fotoğrafa dokun. Saklamak için yeniden dokun. En İyi Kare seçilemez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下照片即可標示為待移除，再點一下即可保留。最佳照片無法被選取。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أي صورة لتحديدها للإزالة. انقر مرة أخرى للاحتفاظ بها. ولا يمكن تحديد أفضل لقطة."
          }
        }
      }
    },
