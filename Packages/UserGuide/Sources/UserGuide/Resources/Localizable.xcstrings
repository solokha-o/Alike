    "userGuide.cleanupQueue.progress.history.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows everything you've cleaned up so far, grouped by month, with your all-time total."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує все, що ви очистили, згруповане за місяцями, разом із підсумком за весь час."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todo lo que limpiaste hasta ahora, agrupado por mes, con tu total histórico."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todo lo que has limpiado hasta ahora, agrupado por mes, con tu total histórico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tudo o que você já limpou, agrupado por mês, com o seu total geral."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt alles, was du bisher aufgeräumt hast, nach Monat gruppiert, mit deiner Gesamtbilanz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre tout ce que vous avez nettoyé jusqu’ici, groupé par mois, avec votre total depuis le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutto ciò che hai già pulito, raggruppato per mese, con il totale complessivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alles wat je tot nu toe hebt opgeruimd, gegroepeerd per maand, met je totaal aller tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wszystko, co dotąd uporządkowałeś, pogrupowane według miesięcy, wraz z łączną sumą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadar temizlediğin her şeyi aya göre gruplandırarak, tüm zamanların toplamıyla birlikte gösterir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你至今清理過的所有項目，依月份分組，並附上歷來總計。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كل ما نظّفته حتى الآن، مجمَّعًا حسب الشهر، مع إجماليك منذ البداية."
          }
        }
      }
    },
