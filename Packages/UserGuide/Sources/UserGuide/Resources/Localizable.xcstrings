    "userGuide.scanning.run.start.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button on the Scanner tab. A progress bar shows how far along the analysis is."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку на вкладці «Сканер». Індикатор покаже, скільки залишилося аналізувати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de la pestaña Análisis. Una barra de progreso muestra cuánto lleva el análisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de la pestaña Análisis. Una barra de progreso muestra cuánto lleva el análisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão da aba Análise. Uma barra de progresso mostra o quanto já foi analisado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe im Tab „Scan“ auf den Button. Ein Fortschrittsbalken zeigt, wie weit die Analyse ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton dans l’onglet Analyse. Une barre de progression indique où en est l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante nella scheda Scanner. Una barra di avanzamento mostra a che punto è l'analisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop op het tabblad Scanner. Een voortgangsbalk laat zien hoe ver de analyse is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk na karcie Skaner. Pasek postępu pokazuje, jak zaawansowana jest analiza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı sekmesindeki düğmeye dokun. Bir ilerleme çubuğu analizin ne kadar ilerlediğini gösterir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「掃描」標籤頁中的按鈕。進度列會顯示分析進行到哪裡。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر الزر في علامة تبويب الفحص. ويُظهر شريط التقدّم مدى تقدّم التحليل."
          }
        }
      }
    },
