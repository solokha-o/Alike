    "userGuide.scanning.run.background.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning continues when you switch tabs. Cleanup refreshes on its own once it finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування триває, коли ви перемикаєте вкладки. Після завершення «Очищення» оновиться саме."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis continúa cuando cambias de pestaña. La limpieza se actualiza sola cuando termina."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis continúa cuando cambias de pestaña. La limpieza se actualiza sola cuando termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise continua quando você troca de aba. A limpeza é atualizada sozinha assim que ela termina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan läuft weiter, wenn du den Tab wechselst. Das Aufräumen aktualisiert sich danach von selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse continue quand vous changez d’onglet. Le nettoyage s’actualise tout seul dès qu’elle est terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione continua anche se cambi scheda. Pulizia si aggiorna da sola quando termina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scannen gaat door als je van tabblad wisselt. Opruimen wordt vanzelf ververst zodra het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie trwa dalej, gdy przełączysz karty. Porządki odświeżą się same po jego zakończeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekme değiştirdiğinde tarama sürer. Tarama bitince Temizlik kendiliğinden yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換標籤頁時掃描會持續進行。完成後，「清理」會自動更新。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الفحص عند تنقلك بين علامات التبويب. ويُحدَّث التنظيف تلقائيًا بمجرد انتهائه."
          }
        }
      }
    },
    "userGuide.scanning.run.background.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep using the app while it works"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся застосунком під час сканування"
          }
        },
        "es-419": {
