    "userGuide.comparingPhotos.inspect.fullscreen.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the photo full screen. Swipe between the photos in the group and pinch to zoom in on the details."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває фото на весь екран. Гортайте фото групи та зводьте пальці, щоб роздивитися деталі."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la foto a pantalla completa. Desliza entre las fotos del grupo y pellizca para acercarte a los detalles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la foto a pantalla completa. Desliza entre las fotos del grupo y pellizca para acercarte a los detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a foto em tela cheia. Deslize entre as fotos do grupo e use o gesto de pinça para ampliar os detalhes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Foto im Vollbild. Streiche durch die Fotos der Gruppe und zoome mit zwei Fingern in die Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la photo en plein écran. Balayez entre les photos du groupe et pincez pour zoomer sur les détails."
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.fullscreen.title": {
