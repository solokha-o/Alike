    "guide.cleanupQueue.progress.history.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"History"}},"uk":{"stringUnit":{"state":"translated","value":"Історія"}}}},
    "guide.cleanupQueue.progress.metrics.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Savings is how much space your current selection would free once the photos are permanently deleted."}},"uk":{"stringUnit":{"state":"translated","value":"«Оцінена економія» — це місце, яке звільнить поточний вибір після остаточного видалення фото."}}}},
    "guide.cleanupQueue.progress.metrics.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reviewed, Remaining, Selected, Estimated Savings"}},"uk":{"stringUnit":{"state":"translated","value":"Переглянуто, Залишилося, Вибрано, Оцінена економія"}}}},
    "guide.cleanupQueue.sections.all.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Every group Alike found, including the ones you already marked as reviewed."}},"uk":{"stringUnit":{"state":"translated","value":"Усі знайдені Alike групи, зокрема ті, які ви вже позначили як переглянуті."}}}},
    "guide.cleanupQueue.sections.all.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All clusters"}},"uk":{"stringUnit":{"state":"translated","value":"Усі групи"}}}},
    "guide.cleanupQueue.sections.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs review appears only when there is something new or changed to look at."}},"uk":{"stringUnit":{"state":"translated","value":"«Потребує перегляду» з'являється лише тоді, коли є щось нове або змінене."}}}},
    "guide.cleanupQueue.sections.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Two lists of groups"}},"uk":{"stringUnit":{"state":"translated","value":"Два списки груп"}}}},
    "guide.cleanupQueue.sections.needsReview.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Groups you haven't decided on yet, plus ones a rescan changed. Start here."}},"uk":{"stringUnit":{"state":"translated","value":"Групи, щодо яких ви ще не вирішили, і ті, що змінилися після пересканування. Почніть звідси."}}}},
    "guide.cleanupQueue.sections.needsReview.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs review"}},"uk":{"stringUnit":{"state":"translated","value":"Потребує перегляду"}}}},
    "guide.cleanupQueue.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your progress, the two cluster sections, badges, sorting and filters."}},"uk":{"stringUnit":{"state":"translated","value":"Ваш прогрес, два розділи груп, позначки, сортування та фільтри."}}}},
    "guide.cleanupQueue.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Working through Cleanup"}},"uk":{"stringUnit":{"state":"translated","value":"Робота з очищенням"}}}},
    "guide.comparingPhotos.bestShot.auto.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favourites come first, then the highest resolution, then the most recent shot."}},"uk":{"stringUnit":{"state":"translated","value":"Спершу обрані, потім найвища роздільна здатність, далі — найновіший знімок."}}}},
    "guide.comparingPhotos.bestShot.auto.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"How Alike picks it"}},"uk":{"stringUnit":{"state":"translated","value":"Як Alike його обирає"}}}},
    "guide.comparingPhotos.bestShot.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your manual choice stays in place for as long as that photo exists."}},"uk":{"stringUnit":{"state":"translated","value":"Ваш ручний вибір діє, доки це фото існує."}}}},
    "guide.comparingPhotos.bestShot.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Best Shot"}},"uk":{"stringUnit":{"state":"translated","value":"Найкращий кадр"}}}},
    "guide.comparingPhotos.bestShot.override.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Disagree? Press and hold any photo and choose Make Best Shot. The previous keeper joins your selection."}},"uk":{"stringUnit":{"state":"translated","value":"Не згодні? Утримуйте будь-яке фото й виберіть «Зробити найкращим кадром». Попередній кадр перейде до вибору."}}}},
    "guide.comparingPhotos.bestShot.override.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Make Best Shot"}},"uk":{"stringUnit":{"state":"translated","value":"Зробити найкращим кадром"}}}},
    "guide.comparingPhotos.inspect.fullscreen.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens the photo full screen. Swipe between the photos in the group and pinch to zoom in on the details."}},"uk":{"stringUnit":{"state":"translated","value":"Відкриває фото на весь екран. Гортайте фото групи та зводьте пальці, щоб роздивитися деталі."}}}},
    "guide.comparingPhotos.inspect.fullscreen.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Original"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити оригінал"}}}},
    "guide.comparingPhotos.inspect.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Looking closer"}},"uk":{"stringUnit":{"state":"translated","value":"Детальний перегляд"}}}},
    "guide.comparingPhotos.inspect.info.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Press and hold a photo for resolution, file type, dates, favourite status, and where it was taken."}},"uk":{"stringUnit":{"state":"translated","value":"Утримуйте фото, щоб побачити роздільну здатність, тип файлу, дати, статус обраного та місце зйомки."}}}},
    "guide.comparingPhotos.inspect.info.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show Info"}},"uk":{"stringUnit":{"state":"translated","value":"Показати інформацію"}}}},
    "guide.comparingPhotos.review.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Marking a group reviewed is your decision, not a consequence of selecting photos. You can reopen it at any time."}},"uk":{"stringUnit":{"state":"translated","value":"Позначка «переглянуто» — це ваше рішення, а не наслідок вибору фото. Ви завжди можете повернути групу в роботу."}}}},
    "guide.comparingPhotos.review.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Finishing a group"}},"uk":{"stringUnit":{"state":"translated","value":"Завершення групи"}}}},
    "guide.comparingPhotos.review.keepAll.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If every photo in a group is worth keeping, mark it reviewed and move on. Nothing has to be removed."}},"uk":{"stringUnit":{"state":"translated","value":"Якщо всі фото в групі варті збереження, позначте її переглянутою та йдіть далі. Видаляти нічого не обов'язково."}}}},
    "guide.comparingPhotos.review.keepAll.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Keeping everything counts too"}},"uk":{"stringUnit":{"state":"translated","value":"Залишити все — теж рішення"}}}},
    "guide.comparingPhotos.review.move.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The button at the bottom appears once something is selected, and always asks for confirmation first."}},"uk":{"stringUnit":{"state":"translated","value":"Кнопка внизу з'являється, щойно щось вибрано, і завжди спершу запитує підтвердження."}}}},
    "guide.comparingPhotos.review.move.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move the selected photos"}},"uk":{"stringUnit":{"state":"translated","value":"Перемістити вибрані фото"}}}},
    "guide.comparingPhotos.review.toggle.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the seal button in the navigation bar when you're done with a group. Tap it again to reopen it."}},"uk":{"stringUnit":{"state":"translated","value":"Скористайтеся кнопкою з печаткою у панелі навігації, коли завершите роботу з групою. Торкніться ще раз, щоб відкрити її знову."}}}},
    "guide.comparingPhotos.review.toggle.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mark as reviewed"}},"uk":{"stringUnit":{"state":"translated","value":"Позначити як переглянуту"}}}},
    "guide.comparingPhotos.selection.batch.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike Free moves one photo at a time. Alike Pro removes your whole selection in a single step."}},"uk":{"stringUnit":{"state":"translated","value":"Alike Free переміщує по одному фото. Alike Pro видаляє весь вибір за один крок."}}}},
    "guide.comparingPhotos.selection.batch.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Removing several photos at once"}},"uk":{"stringUnit":{"state":"translated","value":"Видалення кількох фото одразу"}}}},
    "guide.comparingPhotos.selection.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your selection is saved, so closing a group and coming back later loses nothing."}},"uk":{"stringUnit":{"state":"translated","value":"Вибір зберігається, тож ви нічого не втратите, якщо закриєте групу й повернетеся пізніше."}}}},
    "guide.comparingPhotos.selection.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choosing photos"}},"uk":{"stringUnit":{"state":"translated","value":"Вибір фото"}}}},
    "guide.comparingPhotos.selection.menu.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"In the ••• menu: select everything but the keeper in one go, or clear the whole selection."}},"uk":{"stringUnit":{"state":"translated","value":"У меню ••• : вибрати все, крім кадру, який лишається, або зняти весь вибір."}}}},
    "guide.comparingPhotos.selection.menu.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select All Except Best"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати все, крім найкращого"}}}},
    "guide.comparingPhotos.selection.tap.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap any photo to mark it for removal. Tap again to keep it. The Best Shot can't be selected."}},"uk":{"stringUnit":{"state":"translated","value":"Торкніться фото, щоб позначити його для видалення. Торкніться ще раз, щоб залишити. Найкращий кадр вибрати не можна."}}}},
    "guide.comparingPhotos.selection.tap.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap to select"}},"uk":{"stringUnit":{"state":"translated","value":"Торкніться, щоб вибрати"}}}},
    "guide.comparingPhotos.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choosing what to keep inside a group, and marking it reviewed."}},"uk":{"stringUnit":{"state":"translated","value":"Як обрати, що залишити в групі, і позначити її переглянутою."}}}},
    "guide.comparingPhotos.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Similar Photos and Best Shot"}},"uk":{"stringUnit":{"state":"translated","value":"Схожі фото й найкращий кадр"}}}},
    "guide.deletingSafely.flow.confirm.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike shows what will be moved and how much space it holds, then hands the request to the system."}},"uk":{"stringUnit":{"state":"translated","value":"Alike показує, що буде переміщено та скільки місця це займає, а потім передає запит системі."}}}},
    "guide.deletingSafely.flow.confirm.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iOS asks for confirmation"}},"uk":{"stringUnit":{"state":"translated","value":"iOS запитує підтвердження"}}}},
    "guide.deletingSafely.flow.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike can't remove a photo on its own — iOS always asks you first."}},"uk":{"stringUnit":{"state":"translated","value":"Alike не може видалити фото самостійно — iOS завжди спершу запитує вас."}}}},
    "guide.deletingSafely.flow.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Step by step"}},"uk":{"stringUnit":{"state":"translated","value":"Крок за кроком"}}}},
    "guide.deletingSafely.flow.icloud.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If iCloud Photos is on, the same photos move to Recently Deleted on your other devices."}},"uk":{"stringUnit":{"state":"translated","value":"Якщо ввімкнено «Фото iCloud», ті самі фото перемістяться до «Нещодавно видалених» на інших ваших пристроях."}}}},
    "guide.deletingSafely.flow.icloud.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud Photos syncs the change"}},"uk":{"stringUnit":{"state":"translated","value":"Фото iCloud синхронізують зміни"}}}},
    "guide.deletingSafely.flow.recentlyDeleted.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos land in the Photos app's Recently Deleted album, where you can restore any of them."}},"uk":{"stringUnit":{"state":"translated","value":"Фото потрапляють до альбому «Нещодавно видалені» у застосунку «Фото», звідки їх можна відновити."}}}},
    "guide.deletingSafely.flow.recentlyDeleted.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"30 days to change your mind"}},"uk":{"stringUnit":{"state":"translated","value":"30 днів, щоб передумати"}}}},
    "guide.deletingSafely.flow.storage.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage comes back only after the photos leave Recently Deleted — automatically after 30 days, or when you empty the album."}},"uk":{"stringUnit":{"state":"translated","value":"Пам'ять повертається лише після того, як фото залишать «Нещодавно видалені» — автоматично за 30 днів або коли ви очистите альбом."}}}},
    "guide.deletingSafely.flow.storage.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Space is freed at the end"}},"uk":{"stringUnit":{"state":"translated","value":"Місце звільняється наприкінці"}}}},
    "guide.deletingSafely.history.activity.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A timeline grouped by month, so you can see what you cleaned up and when."}},"uk":{"stringUnit":{"state":"translated","value":"Стрічка, згрупована за місяцями, щоб бачити, що і коли ви очистили."}}}},
    "guide.deletingSafely.history.activity.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Activity"}},"uk":{"stringUnit":{"state":"translated","value":"Остання активність"}}}},
    "guide.deletingSafely.history.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cleanup History"}},"uk":{"stringUnit":{"state":"translated","value":"Історія очищення"}}}},
    "guide.deletingSafely.history.impact.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your running totals: space reclaimed, photos moved, and cleanup sessions completed."}},"uk":{"stringUnit":{"state":"translated","value":"Ваші загальні підсумки: звільнене місце, переміщені фото та завершені сеанси очищення."}}}},
    "guide.deletingSafely.history.impact.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All-Time Impact"}},"uk":{"stringUnit":{"state":"translated","value":"Результат за весь час"}}}},
    "guide.deletingSafely.summary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recently Deleted, when space is actually freed, and iCloud."}},"uk":{"stringUnit":{"state":"translated","value":"«Нещодавно видалені», коли справді звільняється місце, та iCloud."}}}},
    "guide.deletingSafely.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What happens when you delete"}},"uk":{"stringUnit":{"state":"translated","value":"Що відбувається під час видалення"}}}},
    "guide.freeAndPro.free.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Results you've already scanned stay available, whether or not you subscribe."}},"uk":{"stringUnit":{"state":"translated","value":"Уже відскановані результати залишаються доступними незалежно від наявності підписки."}}}},
