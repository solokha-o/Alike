          }
        }
      }
    },
    "userGuide.gettingStarted.loop.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop after any step and pick up later — your progress is saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете зупинитися на будь-якому кроці й повернутися пізніше — прогрес зберігається."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes parar después de cualquier paso y retomarlo más tarde: tu progreso se guarda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes parar después de cualquier paso y retomarlo más tarde: tu progreso se guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode parar depois de qualquer etapa e continuar depois — seu progresso é salvo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nach jedem Schritt aufhören und später weitermachen – dein Fortschritt wird gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous arrêter après n’importe quelle étape et reprendre plus tard : votre progression est enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi fermarti dopo qualsiasi passo e riprendere più tardi: i tuoi progressi sono salvati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt na elke stap stoppen en later verdergaan — je voortgang wordt bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przerwać po dowolnym kroku i wrócić później — Twoje postępy są zapisywane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir adımdan sonra durup sonra devam edebilirsin — ilerlemen kaydedilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在任一步驟後停下，稍後再繼續，進度都會保存。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك التوقف بعد أي خطوة والمتابعة لاحقًا — فتقدّمك محفوظ."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three-step loop"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл із трьох кроків"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El ciclo de tres pasos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ciclo de tres pasos"
          }
        },
        "pt-BR": {
