        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos bleiben privat, und du bestätigst jedes Aufräumen, bevor etwas entfernt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
