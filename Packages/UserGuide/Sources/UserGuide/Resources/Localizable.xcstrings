          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add or remove photos elsewhere, Alike marks the results as needing a refresh and offers to rescan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви додаєте чи видаляєте фото деінде, Alike позначає результати як застарілі й пропонує пересканувати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando agregas o quitas fotos en otro lugar, Alike marca los resultados como pendientes de actualizar y ofrece analizar de nuevo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando añades o quitas fotos en otro lugar, Alike marca los resultados como pendientes de actualizar y ofrece analizar de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você adiciona ou remove fotos em outro lugar, o Alike marca os resultados como desatualizados e oferece uma nova análise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du anderswo Fotos hinzufügst oder entfernst, markiert Alike die Ergebnisse als aktualisierungsbedürftig und bietet einen neuen Scan an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ajoutez ou retirez des photos ailleurs, Alike signale que les résultats doivent être actualisés et propose une nouvelle analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi o rimuovi foto altrove, Alike segnala che i risultati vanno aggiornati e propone una nuova scansione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je elders foto's toevoegt of verwijdert, markeert Alike de resultaten als verouderd en biedt aan opnieuw te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dodasz lub usuniesz zdjęcia gdzie indziej, Alike oznaczy wyniki jako wymagające odświeżenia i zaproponuje ponowne skanowanie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir yerde fotoğraf ekleyip çıkardığında Alike sonuçları yenileme gerektiriyor olarak işaretler ve yeniden taramayı önerir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你在別處新增或移除照片時，Alike 會將結果標示為須更新，並提議重新掃描。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تضيف صورًا أو تزيلها من مكان آخر، يضع Alike علامة على النتائج بأنها بحاجة إلى تحديث ويعرض إعادة الفحص."
          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека змінилася"
          }
        },
        "es-419": {
          "stringUnit": {
