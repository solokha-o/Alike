    "userGuide.cleanupQueue.sections.needsReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups you haven't decided on yet, plus ones a rescan changed. Start here."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи, щодо яких ви ще не вирішили, і ті, що змінилися після пересканування. Почніть звідси."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos sobre los que aún no decidiste, más los que cambió un nuevo análisis. Empieza por aquí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos sobre los que aún no has decidido, más los que ha cambiado un nuevo análisis. Empieza por aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos sobre os quais você ainda não decidiu, mais os que uma nova análise alterou. Comece por aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen, über die du noch nicht entschieden hast, plus die, die ein neuer Scan verändert hat. Fang hier an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes sur lesquels vous n’avez pas encore tranché, plus ceux qu’une nouvelle analyse a modifiés. Commencez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppi su cui non hai ancora deciso, più quelli modificati da una nuova scansione. Comincia da qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groepen waarover je nog niet hebt beslist, plus groepen die door een nieuwe scan zijn gewijzigd. Begin hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupy, o których jeszcze nie zdecydowałeś, oraz te zmienione przez ponowne skanowanie. Zacznij tutaj."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz karar vermediğin gruplar ve yeniden taramanın değiştirdiği gruplar. Buradan başla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未決定的群組，以及重新掃描後有變動的群組。從這裡開始。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعات التي لم تقرر بشأنها بعد، إضافة إلى تلك التي غيّرتها إعادة الفحص. ابدأ من هنا."
          }
        }
      }
    },
