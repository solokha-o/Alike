          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat het niet doet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czego to nie robi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ele não faz"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapmadığı şey"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чого це не робить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不會做的事"
          }
        }
      }
    },
    "userGuide.comparingPhotos.personalization.limits.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only changes how much sharpness, exposure, noise, and faces count against each other. A blurry or badly exposed photo is never promoted to Best Shot because of it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يغيّر فقط مدى تأثير الوضوح والإضاءة والضوضاء والوجوه على بعضها بعضًا. الصورة الضبابية أو سيئة الإضاءة لا تُختار أبدًا كأفضل لقطة بسبب ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ändert nur, wie stark Schärfe, Belichtung, Rauschen und Gesichter gegeneinander gewichtet werden. Ein unscharfes oder schlecht belichtetes Foto wird dadurch nie zur besten Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia cuánto cuentan la nitidez, la exposición, el ruido y las caras entre sí. Una foto borrosa o mal expuesta nunca se convierte en la mejor toma por esto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia cuánto cuentan la nitidez, la exposición, el ruido y las caras entre sí. Una foto borrosa o mal expuesta nunca se convierte en la mejor toma por esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change que l'importance relative de la netteté, de l'exposition, du bruit et des visages. Une photo floue ou mal exposée n'est jamais désignée meilleure photo à cause de ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cambia solo quanto contano tra loro nitidezza, esposizione, rumore e volti. Una foto sfocata o mal esposta non diventa mai lo scatto migliore per questo motivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verandert alleen hoe zwaar scherpte, belichting, ruis en gezichten tegenover elkaar meetellen. Een wazige of slecht belichte foto wordt hierdoor nooit de beste opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zmienia tylko to, jak bardzo ostrość, ekspozycja, szum i twarze liczą się względem siebie. Rozmyte lub źle naświetlone zdjęcie nigdy nie zostanie przez to najlepszym ujęciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso só muda o quanto nitidez, exposição, ruído e rostos contam uns em relação aos outros. Uma foto desfocada ou mal exposta nunca se torna a melhor foto por causa disso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca netlik, pozlama, gürültü ve yüzlerin birbirine göre ne kadar önemli olduğunu değiştirir. Bulanık veya kötü pozlanmış bir fotoğraf bu yüzden asla en iyi kare olarak seçilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це змінює лише те, наскільки різкість, експозиція, шум і обличчя враховуються одне відносно одного. Розмите або погано експоноване фото через це ніколи не стане найкращим кадром."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會改變銳利度、曝光、雜訊和臉孔彼此之間的權重。模糊或曝光不佳的照片絕不會因此被選為最佳照片。"
          }
        }
      }
    },
