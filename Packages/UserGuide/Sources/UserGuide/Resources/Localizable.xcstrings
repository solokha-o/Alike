    "userGuide.settingsAndReminders.analysis.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing sensitivity asks for a rescan, because the groups have to be built again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна чутливості потребує пересканування, бо групи доводиться будувати заново."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad pide un nuevo análisis, porque los grupos se tienen que armar otra vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad pide un nuevo análisis, porque los grupos se tienen que armar otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a sensibilidade pede uma nova análise, porque os grupos precisam ser montados novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geänderte Empfindlichkeit verlangt einen neuen Scan, weil die Gruppen neu gebildet werden müssen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la sensibilité demande une nouvelle analyse, car les groupes doivent être reconstruits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la sensibilità richiede una nuova scansione, perché i gruppi vanno ricostruiti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de gevoeligheid wijzigt, is een nieuwe scan nodig, omdat de groepen opnieuw moeten worden opgebouwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana czułości wymaga ponownego skanowania, ponieważ grupy trzeba zbudować od nowa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyarlılığı değiştirmek yeniden tarama gerektirir, çünkü grupların yeniden oluşturulması gerekir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改敏感度需要重新掃描，因為群組必須重新建立。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستدعي تغيير الحساسية إعادة فحص، لأن المجموعات يجب أن تُبنى من جديد."
          }
        }
      }
    },
