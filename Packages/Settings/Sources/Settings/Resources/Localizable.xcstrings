    "settings.main.thisActionCantBeUndone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action can't be undone. Alike will replay onboarding when deletion finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю дію неможливо скасувати. Після видалення Alike знову покаже вступні екрани."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Alike volverá a mostrar la introducción cuando termine la eliminación."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Alike volverá a mostrar la introducción cuando termine la eliminación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita. O Alike mostrará a introdução novamente quando a exclusão terminar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion kann nicht rückgängig gemacht werden. Nach dem Löschen zeigt Alike die Einführung erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Alike réaffichera l’introduction une fois la suppression terminée."
          }
        }
      }
    },
    "settings.main.thisOverrideAvailableOnlyDebug": {
