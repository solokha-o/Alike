    "cleanup.cleanupHistory.storageMayNotBeFreed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage may not be freed until items are permanently deleted from Recently Deleted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місце може не звільнитися, доки об’єкти не буде остаточно видалено з альбому «Недавно видалені»."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que no se libere espacio hasta que los elementos se eliminen de forma permanente de Eliminados recientemente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que no se libere espacio hasta que los elementos se eliminen de forma permanente de Eliminados recientemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço pode não ser liberado até que os itens sejam apagados definitivamente de Apagados recentemente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher wird möglicherweise erst freigegeben, wenn die Objekte endgültig aus „Zuletzt gelöscht“ entfernt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace ne sera peut-être libéré qu’une fois les éléments supprimés définitivement de Supprimés récemment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio potrebbe non liberarsi finché gli elementi non vengono eliminati definitivamente da «Eliminati di recente»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komt mogelijk pas opslagruimte vrij als items definitief zijn verwijderd uit 'Recent verwijderd'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce może nie zostać zwolnione, dopóki elementy nie zostaną trwale usunięte z albumu „Ostatnio usunięte”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler Son Silinenler'den kalıcı olarak silinene kadar depolama alanı boşalmayabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在項目從「最近刪除」中永久刪除之前，儲存空間可能不會釋出。"
          }
        }
      }
    },
