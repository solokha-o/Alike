    "userGuide.deletingSafely.flow.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike shows what will be moved and how much space it holds, then hands the request to the system."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike показує, що буде переміщено та скільки місця це займає, а потім передає запит системі."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike muestra qué se va a mover y cuánto espacio ocupa, y luego entrega la solicitud al sistema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike muestra qué se va a mover y cuánto espacio ocupa, y luego entrega la solicitud al sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike mostra o que será movido e quanto espaço ocupa, e então entrega o pedido ao sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike zeigt, was bewegt wird und wie viel Speicher das ist, und übergibt die Anfrage dann an das System."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike indique ce qui va être déplacé et l’espace que cela représente, puis transmet la demande au système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike mostra cosa verrà spostato e quanto spazio occupa, poi passa la richiesta al sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike laat zien wat er wordt verplaatst en hoeveel ruimte dat inneemt, en geeft het verzoek daarna door aan het systeem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike pokazuje, co zostanie przeniesione i ile miejsca zajmuje, a następnie przekazuje żądanie systemowi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike neyin taşınacağını ve ne kadar yer kapladığını gösterir, sonra isteği sisteme iletir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 會顯示將移動哪些項目、佔用多少空間，然後把要求交給系統。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Alike ما سيُنقل وحجم المساحة التي يشغلها، ثم يسلّم الطلب إلى النظام."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.confirm.title": {
