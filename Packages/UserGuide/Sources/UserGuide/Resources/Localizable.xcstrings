    "userGuide.comparingPhotos.bestShot.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your manual choice stays in place for as long as that photo exists."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ручний вибір діє, доки це фото існує."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu elección manual se mantiene mientras esa foto exista."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu elección manual se mantiene mientras esa foto exista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua escolha manual permanece enquanto aquela foto existir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine manuelle Wahl bleibt bestehen, solange dieses Foto existiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre choix manuel tient tant que cette photo existe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scelta manuale resta valida finché quella foto esiste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je handmatige keuze blijft gelden zolang die foto bestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ręczny wybór pozostaje, dopóki to zdjęcie istnieje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle yaptığın seçim, o fotoğraf var olduğu sürece geçerli kalır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
