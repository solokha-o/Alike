    "userGuide.comparingPhotos.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing what to keep inside a group, and marking it reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як обрати, що залишити в групі, і позначити її переглянутою."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir qué conservar dentro de un grupo y marcarlo como revisado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir qué conservar dentro de un grupo y marcarlo como revisado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher o que manter dentro de um grupo e marcá-lo como revisado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb einer Gruppe entscheiden, was bleibt, und sie als geprüft markieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir ce que l’on garde dans un groupe, puis le marquer comme examiné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere cosa conservare in un gruppo e segnarlo come controllato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiezen wat je binnen een groep bewaart, en de groep als bekeken markeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybieranie tego, co zachować w grupie, i oznaczanie jej jako przejrzanej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir grupta neyi saklayacağını seçmek ve grubu gözden geçirildi olarak işaretlemek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在群組中挑選要保留的照片，並標示為已檢視。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار ما تحتفظ به داخل المجموعة، ووضع علامة أنها روجعت."
          }
        }
      }
    },
