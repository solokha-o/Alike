    "guide.freeAndPro.pro.blurred.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the Blurred Photos category and review what on-device analysis flagged."}},"uk":{"stringUnit":{"state":"translated","value":"Відкривайте категорію «Розмиті фото» та переглядайте те, що позначив аналіз на пристрої."}}}},
    "guide.freeAndPro.pro.blurred.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Blurred photos cleanup"}},"uk":{"stringUnit":{"state":"translated","value":"Очищення розмитих фото"}}}},
    "guide.freeAndPro.pro.filters.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Filter Cleanup by review status, minimum group size, or favourites only."}},"uk":{"stringUnit":{"state":"translated","value":"Фільтруйте «Очищення» за станом перегляду, мінімальним розміром групи або лише обраними."}}}},
