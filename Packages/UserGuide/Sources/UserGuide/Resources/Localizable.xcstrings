    "userGuide.privacy.onDevice.network.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only network requests Alike makes are to the App Store, for subscriptions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Єдині мережеві запити Alike — до App Store, для підписок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las únicas solicitudes de red que hace Alike son al App Store, para las suscripciones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las únicas solicitudes de red que hace Alike son al App Store, para las suscripciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As únicas requisições de rede que o Alike faz são para a App Store, por causa das assinaturas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzigen Netzwerkanfragen von Alike gehen an den App Store – für Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seules requêtes réseau d’Alike vont vers l’App Store, pour les abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le uniche richieste di rete di Alike sono verso l'App Store, per gli abbonamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De enige netwerkverzoeken die Alike doet, gaan naar de App Store, voor abonnementen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedyne żądania sieciowe Alike kieruje do App Store, w sprawie subskrypcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın yaptığı tek ağ isteği, abonelikler için App Store'adır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 唯一的網路要求是為了訂閱而連線到 App Store。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات الشبكة الوحيدة التي يجريها Alike هي إلى App Store، من أجل الاشتراكات."
          }
        }
      }
    },
