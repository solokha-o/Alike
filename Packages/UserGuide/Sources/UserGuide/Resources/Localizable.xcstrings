    "userGuide.cleanupQueue.controls.sort.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order groups by newest, most space to save, largest group, highest similarity, or review status."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядковуйте групи за новизною, обсягом економії, розміром групи, схожістю або станом перегляду."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los grupos por más recientes, mayor ahorro de espacio, grupo más grande, mayor similitud o estado de revisión."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los grupos por más recientes, mayor ahorro de espacio, grupo más grande, mayor similitud o estado de revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene os grupos por mais recentes, maior economia de espaço, maior grupo, maior semelhança ou status de revisão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Gruppen nach neuesten, größter Ersparnis, größter Gruppe, höchster Ähnlichkeit oder Prüfstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les groupes par plus récents, plus grande économie d’espace, plus grand groupe, similarité la plus élevée ou statut d’examen."
          }
        }
      }
    },
