    "welcome.main.alikeNeedsPhotoAccessScan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs photo access to scan your library and prepare cleanup suggestions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до фото, щоб сканувати вашу фототеку та підготувати рекомендації для очищення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso a tus fotos para analizar tu fototeca y preparar sugerencias de limpieza."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso a tus fotos para analizar tu fototeca y preparar sugerencias de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike precisa de acesso às fotos para analisar sua fototeca e preparar sugestões de limpeza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike benötigt Zugriff auf deine Fotos, um deine Mediathek zu scannen und Aufräumvorschläge vorzubereiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike a besoin d’accéder à vos photos pour analyser votre photothèque et préparer des suggestions de nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ha bisogno dell'accesso alle foto per analizzare la libreria e preparare i suggerimenti di pulizia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike heeft toegang tot je foto's nodig om je bibliotheek te scannen en opruimsuggesties voor te bereiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike potrzebuje dostępu do zdjęć, aby przeskanować bibliotekę i przygotować propozycje porządków."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın kitaplığını tarayıp temizlik önerileri hazırlayabilmesi için fotoğraf erişimi gerekiyor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 需要取用照片，才能掃描你的圖庫並準備清理建議。"
          }
        }
      }
    },
    "welcome.main.alikeNeverDeletesPhotosAutomatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike never deletes photos automatically. You review the suggestions first and confirm every cleanup action."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ніколи не видаляє фото автоматично. Ви спочатку переглядаєте рекомендації й підтверджуєте кожну дію."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike nunca elimina fotos automáticamente. Primero revisas las sugerencias y confirmas cada acción de limpieza."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike nunca elimina fotos automáticamente. Primero revisas las sugerencias y confirmas cada acción de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike nunca apaga fotos automaticamente. Você revisa as sugestões primeiro e confirma cada ação de limpeza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike löscht nie automatisch Fotos. Du prüfst zuerst die Vorschläge und bestätigst jede Aufräumaktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ne supprime jamais de photos automatiquement. Vous examinez d’abord les suggestions et confirmez chaque nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike non elimina mai foto automaticamente. Prima controlli i suggerimenti e confermi ogni azione di pulizia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike verwijdert nooit automatisch foto's. Jij bekijkt eerst de suggesties en bevestigt elke opruimactie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike nigdy nie usuwa zdjęć automatycznie. Najpierw przeglądasz propozycje i potwierdzasz każdą operację porządkową."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike hiçbir fotoğrafı otomatik olarak silmez. Önce önerileri sen gözden geçirir, her temizlik işlemini sen onaylarsın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 絕不會自動刪除照片。你會先檢視建議，並確認每一項清理操作。"
          }
        }
      }
    },
