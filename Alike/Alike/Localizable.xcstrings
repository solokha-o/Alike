    "Delete Alike Data": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete Alike Data"}},"uk":{"stringUnit":{"state":"translated","value":"Видалити дані Alike"}}}},
    "Delete all Alike data?": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all Alike data?"}},"uk":{"stringUnit":{"state":"translated","value":"Видалити всі дані Alike?"}}}},
    "Grid, sensitivity, and reminder preferences": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Grid, sensitivity, and reminder preferences"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування сітки, чутливості та нагадувань"}}}},
    "Monthly free-scan allowance": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly free-scan allowance"}},"uk":{"stringUnit":{"state":"translated","value":"Місячний ліміт безкоштовних сканувань"}}}},
    "Permanently delete Alike data after confirmation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Permanently delete Alike data after confirmation"}},"uk":{"stringUnit":{"state":"translated","value":"Назавжди видалити дані Alike після підтвердження"}}}},
    "Photo access and Alike Pro subscription": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo access and Alike Pro subscription"}},"uk":{"stringUnit":{"state":"translated","value":"Доступ до фото та підписка Alike Pro"}}}},
    "Review and permanently delete data stored by Alike on this device": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and permanently delete data stored by Alike on this device"}},"uk":{"stringUnit":{"state":"translated","value":"Переглянути й назавжди видалити дані Alike на цьому пристрої"}}}},
    "Scan results and analysis caches": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan results and analysis caches"}},"uk":{"stringUnit":{"state":"translated","value":"Результати сканування та кеші аналізу"}}}},
    "Some data may already have been removed. Please try again to finish deleting your Alike data.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some data may already have been removed. Please try again to finish deleting your Alike data."}},"uk":{"stringUnit":{"state":"translated","value":"Деякі дані вже могли бути видалені. Спробуйте ще раз, щоб завершити видалення даних Alike."}}}},
    "This action can't be undone. Alike will replay onboarding when deletion finishes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This action can't be undone. Alike will replay onboarding when deletion finishes."}},"uk":{"stringUnit":{"state":"translated","value":"Цю дію неможливо скасувати. Після видалення Alike знову покаже вступні екрани."}}}},
    "This permanently deletes Alike's local results, cleanup history, and preferences. Your photos and subscription will stay.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes Alike's local results, cleanup history, and preferences. Your photos and subscription will stay."}},"uk":{"stringUnit":{"state":"translated","value":"Це назавжди видалить локальні результати Alike, історію очищення та налаштування. Ваші фотографії та підписка залишаться."}}}},
    "Try Again": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try Again"}},"uk":{"stringUnit":{"state":"translated","value":"Спробувати ще раз"}}}},
    "What will be deleted": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What will be deleted"}},"uk":{"stringUnit":{"state":"translated","value":"Що буде видалено"}}}},
    "What will stay": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What will stay"}},"uk":{"stringUnit":{"state":"translated","value":"Що залишиться"}}}},
    "Your local Alike data was deleted. Your photos and subscription are unchanged.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your local Alike data was deleted. Your photos and subscription are unchanged."}},"uk":{"stringUnit":{"state":"translated","value":"Локальні дані Alike видалено. Ваші фотографії та підписка не змінилися."}}}},
    "Your photo library is never deleted by this action.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your photo library is never deleted by this action."}},"uk":{"stringUnit":{"state":"translated","value":"Ця дія ніколи не видаляє вашу фототеку."}}}},
    "Your photos and Recently Deleted items": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your photos and Recently Deleted items"}},"uk":{"stringUnit":{"state":"translated","value":"Ваші фотографії та елементи в «Нещодавно видалені»"}}}},
