    "userGuide.scanning.run.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Scanner card changes as the scan progresses and tells you what to do next."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка сканера змінюється під час сканування й підказує, що робити далі."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de análisis cambia a medida que avanza y te dice qué hacer después."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de análisis cambia a medida que avanza y te dice qué hacer después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão da análise muda conforme ela avança e diz o que fazer em seguida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Scan-Karte verändert sich mit dem Fortschritt und sagt dir, was als Nächstes dran ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche d’analyse évolue avec la progression et vous indique quoi faire ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda Scanner cambia con l'avanzare della scansione e ti dice cosa fare dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Scanner-kaart verandert naarmate de scan vordert en vertelt je wat je hierna kunt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta Skanera zmienia się w miarę postępu skanowania i podpowiada, co dalej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı kartı tarama ilerledikçe değişir ve sonraki adımı söyler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「掃描」卡片會隨掃描進度變化，並告訴你下一步該做什麼。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغيّر بطاقة الفحص مع تقدّم العملية وتخبرك بما ينبغي فعله بعد ذلك."
          }
        }
      }
    },
