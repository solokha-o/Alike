          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo roda no seu iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se passe sur votre iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto avviene sul tuo iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles draait op je iPhone"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko dzieje się na Twoim iPhonie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey iPhone'unda çalışır"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在你的 iPhone 上執行"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يجري على iPhone الخاص بك"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs read and write access to your library: read to analyse photos, write to move the ones you pick."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до медіатеки на читання й запис: читання — щоб аналізувати фото, запис — щоб переміщувати вибрані."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso de lectura y escritura a tu fototeca: lectura para analizar las fotos y escritura para mover las que elijas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso de lectura y escritura a tu fototeca: lectura para analizar las fotos y escritura para mover las que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike precisa de acesso de leitura e gravação à sua fototeca: leitura para analisar as fotos e gravação para mover as que você escolher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike braucht Lese- und Schreibzugriff auf deine Mediathek: Lesen, um Fotos zu analysieren, Schreiben, um die von dir gewählten zu bewegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike a besoin d’un accès en lecture et en écriture à votre photothèque : la lecture pour analyser les photos, l’écriture pour déplacer celles que vous choisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ha bisogno dell'accesso in lettura e scrittura alla tua libreria: in lettura per analizzare le foto, in scrittura per spostare quelle che scegli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike heeft lees- en schrijftoegang tot je bibliotheek nodig: lezen om foto's te analyseren, schrijven om de foto's die jij kiest te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike potrzebuje dostępu do biblioteki w trybie odczytu i zapisu: odczyt do analizy zdjęć, zapis do przenoszenia tych, które wybierzesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın fotoğraf kitaplığınıza okuma ve yazma erişimi gerekir: fotoğrafları analiz etmek için okuma, seçtiklerini taşımak için yazma."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 需要圖庫的讀取與寫入權限：讀取用於分析照片，寫入用於移動你挑選的照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Alike إلى إذن القراءة والكتابة في مكتبتك: القراءة لتحليل الصور، والكتابة لنقل ما تختاره منها."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
