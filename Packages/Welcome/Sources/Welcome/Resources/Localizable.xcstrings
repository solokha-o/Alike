    "welcome.main.canChangeAccessLaterSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change access later in Settings, and Alike never deletes anything without your confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пізніше ви можете змінити доступ у Налаштуваннях, а Alike нічого не видаляє без вашого підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el acceso más tarde en Configuración, y Alike nunca elimina nada sin tu confirmación."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el acceso más tarde en Ajustes, y Alike nunca elimina nada sin tu confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar o acesso depois nos Ajustes, e o Alike nunca apaga nada sem a sua confirmação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Zugriff später in den Einstellungen ändern, und Alike löscht nie etwas ohne deine Bestätigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez modifier l’accès plus tard dans Réglages, et Alike ne supprime jamais rien sans votre confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare l'accesso in seguito in Impostazioni e Alike non elimina mai nulla senza la tua conferma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de toegang later wijzigen in Instellingen, en Alike verwijdert nooit iets zonder jouw bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp możesz zmienić później w Ustawieniach, a Alike nigdy niczego nie usuwa bez Twojego potwierdzenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimi daha sonra Ayarlar'dan değiştirebilirsin ve Alike onayın olmadan hiçbir şeyi silmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你之後可以在「設定」中更改取用權；未經你確認，Alike 不會刪除任何內容。"
          }
        }
      }
    },
    "welcome.main.canGrantAccessNowReturn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant access now and return to cleanup whenever you're ready."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете надати доступ зараз і повернутися до очищення, коли будете готові."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conceder el acceso ahora y volver a la limpieza cuando quieras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conceder el acceso ahora y volver a la limpieza cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conceder o acesso agora e voltar à limpeza quando quiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Zugriff jetzt erteilen und jederzeit zum Aufräumen zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez autoriser l’accès maintenant et revenir au nettoyage quand vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi consentire l'accesso ora e tornare alla pulizia quando vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu toegang verlenen en later terugkomen om op te ruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przyznać dostęp teraz i wrócić do porządków, kiedy zechcesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimi şimdi verip temizliğe hazır olduğunda dönebilirsin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以現在授予取用權，等準備好時再回來清理。"
          }
        }
      }
    },
    "welcome.main.cleanUpLibraryWithConfidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up your library with confidence"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищуйте фототеку впевнено"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia tu fototeca con confianza"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia tu fototeca con confianza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe sua fototeca com confiança"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume deine Mediathek sicher auf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez votre photothèque en toute confiance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in ordine la libreria in tutta tranquillità"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim je bibliotheek met een gerust hart op"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporządkuj bibliotekę bez obaw"
          }
