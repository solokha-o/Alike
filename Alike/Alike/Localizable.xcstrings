    "guide.smartCategories.blurDetection.conservative.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike suggests only the softest few percent of your photos, and only when there are enough to compare."}},"uk":{"stringUnit":{"state":"translated","value":"Alike пропонує лише кілька відсотків найменш різких фото, і лише коли є з чим порівнювати."}}}},
    "guide.smartCategories.blurDetection.conservative.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only the clearest cases"}},"uk":{"stringUnit":{"state":"translated","value":"Лише найочевидніші випадки"}}}},
    "guide.smartCategories.blurDetection.favorites.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos you marked as favourites never appear here — mark a photo as a favourite to protect it."}},"uk":{"stringUnit":{"state":"translated","value":"Фото, позначені як обрані, тут ніколи не з'являються — позначте фото обраним, щоб захистити його."}}}},
    "guide.smartCategories.blurDetection.favorites.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Favourites are left alone"}},"uk":{"stringUnit":{"state":"translated","value":"Обрані не чіпаються"}}}},
    "guide.smartCategories.blurDetection.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A short list is intentional: a missed blurry photo costs you nothing, a wrongly flagged keepsake does."}},"uk":{"stringUnit":{"state":"translated","value":"Короткий список — це задум: пропущене розмите фото нічого не коштує, а помилково позначений спогад — так."}}}},
    "guide.smartCategories.blurDetection.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Why the blurred list is short"}},"uk":{"stringUnit":{"state":"translated","value":"Чому список розмитих короткий"}}}},
    "guide.smartCategories.categories.blurred.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos that look out of focus, based on on-device analysis. Worth checking before you remove them."}},"uk":{"stringUnit":{"state":"translated","value":"Фото, які виглядають нерізкими, за результатами аналізу на пристрої. Варто перевірити перед видаленням."}}}},
    "guide.smartCategories.categories.blurred.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Blurred Photos"}},"uk":{"stringUnit":{"state":"translated","value":"Розмиті фото"}}}},
    "guide.smartCategories.categories.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Both categories are part of Alike Pro. Tapping a locked one shows what it found first."}},"uk":{"stringUnit":{"state":"translated","value":"Обидві категорії входять до Alike Pro. Торкнувшись заблокованої, ви спершу побачите, що вона знайшла."}}}},
    "guide.smartCategories.categories.header": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Two extra categories"}},"uk":{"stringUnit":{"state":"translated","value":"Дві додаткові категорії"}}}},
