    "userGuide.cleanupQueue.controls.filters.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrow the list by review status, minimum group size, or favourites only. Sorting stays available on Alike Free."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звужуйте список за станом перегляду, мінімальним розміром групи або лише обраними. Сортування доступне й в Alike Free."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acota la lista por estado de revisión, tamaño mínimo del grupo o solo favoritas. El orden sigue disponible en Alike Free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acota la lista por estado de revisión, tamaño mínimo del grupo o solo favoritas. El orden sigue disponible en Alike Free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre a lista por status de revisão, tamanho mínimo do grupo ou apenas favoritas. A ordenação continua disponível no Alike Free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenze die Liste nach Prüfstatus, Mindestgröße der Gruppe oder nur Favoriten ein. Das Sortieren bleibt in Alike Free verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restreignez la liste par statut d’examen, taille minimale de groupe ou favoris uniquement. Le tri reste disponible dans Alike Free."
          }
        }
      }
    },
