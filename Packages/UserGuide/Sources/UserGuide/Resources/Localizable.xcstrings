    "userGuide.gettingStarted.scope.similar.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bursts and near-duplicates that look alike — the same moment shot several times."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серії та майже однакові знімки — один момент, зроблений кілька разів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ráfagas y casi duplicados que se parecen: el mismo momento fotografiado varias veces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ráfagas y casi duplicados que se parecen: el mismo momento fotografiado varias veces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequências e quase duplicatas parecidas — o mesmo momento fotografado várias vezes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien und Beinahe-Dubletten, die sich ähneln – derselbe Moment, mehrfach aufgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafales et quasi-doublons qui se ressemblent : le même instant photographié plusieurs fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffiche e quasi-duplicati che si somigliano: lo stesso momento scattato più volte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reeksopnamen en bijna-duplicaten die op elkaar lijken — hetzelfde moment meerdere keren vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie i niemal identyczne zdjęcia, które wyglądają podobnie — ten sam moment uchwycony kilka razy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirine benzeyen seri çekimler ve neredeyse aynı kareler — aynı anın birkaç kez çekilmiş hâli."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看起來相似的連拍與近乎重複的照片，也就是同一瞬間拍了好幾張。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللقطات المتتابعة وشبه المكررة التي تبدو متشابهة — اللحظة نفسها مصوَّرة عدة مرات."
          }
        }
      }
    },
