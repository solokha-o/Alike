    "welcome.main.canChangeAccessLaterSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change access later in Settings, and Alike never deletes anything without your confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пізніше ви можете змінити доступ у Налаштуваннях, а Alike нічого не видаляє без вашого підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el acceso más tarde en Configuración, y Alike nunca elimina nada sin tu confirmación."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el acceso más tarde en Ajustes, y Alike nunca elimina nada sin tu confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar o acesso depois nos Ajustes, e o Alike nunca apaga nada sem a sua confirmação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Zugriff später in den Einstellungen ändern, und Alike löscht nie etwas ohne deine Bestätigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez modifier l’accès plus tard dans Réglages, et Alike ne supprime jamais rien sans votre confirmation."
          }
        }
      }
    },
    "welcome.main.canGrantAccessNowReturn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant access now and return to cleanup whenever you're ready."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете надати доступ зараз і повернутися до очищення, коли будете готові."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conceder el acceso ahora y volver a la limpieza cuando quieras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conceder el acceso ahora y volver a la limpieza cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conceder o acesso agora e voltar à limpeza quando quiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Zugriff jetzt erteilen und jederzeit zum Aufräumen zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez autoriser l’accès maintenant et revenir au nettoyage quand vous le souhaitez."
          }
        }
      }
    },
