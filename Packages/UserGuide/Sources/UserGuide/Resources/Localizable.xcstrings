    "userGuide.privacy.onDevice.analysis.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are compared using Apple's on-device vision framework, and the results are stored locally."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото порівнюються за допомогою системного фреймворку Apple на пристрої, а результати зберігаються локально."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se comparan con el framework de visión en el dispositivo de Apple y los resultados se guardan localmente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se comparan con el framework de visión en el dispositivo de Apple y los resultados se guardan localmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são comparadas com o framework de visão no dispositivo da Apple, e os resultados ficam salvos localmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden mit Apples Vision-Framework auf dem Gerät verglichen, und die Ergebnisse bleiben lokal gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont comparées avec le framework de vision sur l’appareil d’Apple, et les résultats sont stockés localement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono confrontate con il framework di visione sul dispositivo di Apple e i risultati restano in locale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's worden vergeleken met Apples vision-framework op het apparaat, en de resultaten worden lokaal bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są porównywane przy użyciu działającego na urządzeniu frameworku wizyjnego Apple, a wyniki są zapisywane lokalnie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar Apple'ın aygıt üzerindeki görüntü işleme çerçevesiyle karşılaştırılır ve sonuçlar yerelde saklanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會透過 Apple 的裝置端視覺框架進行比較，結果儲存在本機。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقارن الصور باستخدام إطار عمل الرؤية من Apple على الجهاز، وتُخزَّن النتائج محليًا."
          }
        }
      }
    },
