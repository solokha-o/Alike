    "userGuide.comparingPhotos.personalization.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Alike learns stays on this device and is never uploaded."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يتعلّمه Alike يظل على هذا الجهاز ولا يُرفع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Alike lernt, bleibt auf diesem Gerät und wird nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que Alike aprende se queda en este dispositivo y nunca se sube."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que Alike aprende se queda en este dispositivo y nunca se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'Alike apprend reste sur cet appareil et n'est jamais envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che Alike impara resta su questo dispositivo e non viene mai caricato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Alike leert, blijft op dit apparaat en wordt nooit geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, czego uczy się Alike, pozostaje na tym urządzeniu i nigdy nie jest przesyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Alike aprende fica neste dispositivo e nunca é enviado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın öğrendikleri bu cihazda kalır ve asla yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, чого навчається Alike, залишається на цьому пристрої і ніколи не завантажується."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 學到的內容只留在這部裝置上，絕不會被上傳。"
          }
        }
      }
    },
    "userGuide.comparingPhotos.personalization.learns.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike learns from your picks"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلّم Alike من اختياراتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike lernt aus deiner Auswahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike aprende de tus selecciones"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike aprende de tus selecciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike apprend de vos choix"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike impara dalle tue scelte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike leert van je keuzes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike uczy się z Twoich wyborów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike aprende com suas escolhas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike seçimlerinden öğrenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike вчиться на ваших виборах"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 會從你的選擇中學習"
          }
        }
      }
    },
    "userGuide.comparingPhotos.personalization.learns.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you choose a different Best Shot than the one Alike suggested, it remembers what you preferred and leans that way a little more next time. It takes a handful of picks before you notice a difference."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كل مرة تختار فيها أفضل لقطة غير التي اقترحها Alike، يتذكر ما فضّلته فيها ويميل قليلاً أكثر إلى ذلك في المجموعات القادمة. يستغرق الأمر عدة اختيارات قبل أن تلاحظ فرقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn du eine andere beste Aufnahme wählst als die von Alike vorgeschlagene, merkt sich Alike, was dir daran gefallen hat, und richtet sich beim nächsten Mal etwas mehr danach. Es dauert ein paar Auswahlen, bis du einen Unterschied merkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que eliges una mejor toma distinta a la que Alike sugirió, recuerda lo que preferiste y se inclina un poco más hacia eso la próxima vez. Hacen falta varias elecciones antes de notar una diferencia."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que eliges una mejor toma distinta a la que Alike sugirió, recuerda lo que preferiste y se inclina un poco más hacia eso la próxima vez. Hacen falta varias elecciones antes de notar una diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fois que vous choisissez une meilleure photo différente de celle proposée par Alike, il se souvient de ce que vous avez préféré et penche un peu plus dans ce sens la fois suivante. Il faut plusieurs choix avant que vous remarquiez une différence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che scegli uno scatto migliore diverso da quello suggerito da Alike, ricorda cosa hai preferito e la volta successiva pende un po' di più in quella direzione. Servono alcune scelte prima che tu noti una differenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer dat je een andere beste opname kiest dan die Alike voorstelde, onthoudt het wat je fijner vond en helt de volgende keer iets meer die kant op. Het duurt een paar keuzes voordat je een verschil merkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym razem, gdy wybierzesz inne najlepsze ujęcie niż to zaproponowane przez Alike, zapamiętuje on, co Ci się w nim podobało, i następnym razem nieco bardziej skłania się w tę stronę. Potrzeba kilku wyborów, zanim zauważysz różnicę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda vez que você escolhe uma melhor foto diferente da sugerida pelo Alike, ele lembra o que você preferiu e passa a pender um pouco mais nessa direção da próxima vez. São necessárias algumas escolhas antes que você note uma diferença."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike'ın önerdiğinden farklı bir en iyi kare seçtiğinde, neyi tercih ettiğini hatırlar ve bir sonraki sefer biraz daha o yöne kayar. Bir farkı fark etmen için birkaç seçim gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоразу, коли ви обираєте інший найкращий кадр, ніж запропонував Alike, він запам'ятовує, що вам сподобалось, і наступного разу трохи більше схиляється в той бік. Потрібно кілька виборів, перш ніж ви помітите різницю."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次你選擇的最佳照片和 Alike 建議的不同時，它會記住你偏好的地方，下次就會稍微多考慮這一點。要累積幾次選擇之後，你才會注意到差異。"
          }
        }
      }
    },
    "userGuide.comparingPhotos.personalization.limits.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it won't do"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما لا يفعله"
          }
        },
        "de": {
