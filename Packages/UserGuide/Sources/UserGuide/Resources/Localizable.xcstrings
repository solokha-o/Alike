    "userGuide.gettingStarted.loop.review.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a group on the Cleanup tab, compare the photos, and choose which ones you no longer need."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте групу на вкладці «Очищення», порівняйте фото й оберіть ті, які більше не потрібні."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un grupo en la pestaña Limpieza, compara las fotos y elige las que ya no necesitas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un grupo en la pestaña Limpieza, compara las fotos y elige las que ya no necesitas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um grupo na aba Limpeza, compare as fotos e escolha as que você não precisa mais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne im Tab „Aufräumen“ eine Gruppe, vergleiche die Fotos und wähle die, die du nicht mehr brauchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un groupe dans l’onglet Nettoyage, comparez les photos et choisissez celles dont vous n’avez plus besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un gruppo nella scheda Pulizia, confronta le foto e scegli quelle che non ti servono più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een groep op het tabblad Opruimen, vergelijk de foto's en kies welke je niet meer nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz grupę na karcie Porządki, porównaj zdjęcia i wybierz te, których już nie potrzebujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlik sekmesinde bir grup aç, fotoğrafları karşılaştır ve artık istemediklerini seç."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「清理」標籤頁打開群組，比較照片並挑出你不再需要的。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مجموعة في علامة تبويب التنظيف، وقارن بين الصور، واختر ما لم تعد بحاجة إليه."
          }
        }
      }
    },
