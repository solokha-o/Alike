    "welcome.main.analysisStaysDeviceNothingDeleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis stays on your device, and nothing is deleted automatically."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз виконується на вашому пристрої, і нічого не видаляється автоматично."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se queda en tu dispositivo y no se elimina nada automáticamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se queda en tu dispositivo y no se elimina nada automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise fica no seu dispositivo, e nada é apagado automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse bleibt auf deinem Gerät, und nichts wird automatisch gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse reste sur votre appareil et rien n’est supprimé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analisi resta sul tuo dispositivo e nulla viene eliminato automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De analyse blijft op je apparaat en er wordt niets automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza pozostaje na Twoim urządzeniu, a nic nie jest usuwane automatycznie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz aygıtında kalır ve hiçbir şey otomatik olarak silinmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析全程留在你的裝置上，也不會自動刪除任何內容。"
          }
        }
      }
    },
