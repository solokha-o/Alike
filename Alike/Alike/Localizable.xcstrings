    "guide.freeAndPro.pro.batch.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move your entire selection in one step instead of one photo at a time."}},"uk":{"stringUnit":{"state":"translated","value":"Переміщуйте весь вибір за один крок, а не по одному фото."}}}},
