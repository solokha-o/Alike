    "userGuide.cleanupQueue.controls.sort.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order groups by newest, most space to save, largest group, highest similarity, or review status."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядковуйте групи за новизною, обсягом економії, розміром групи, схожістю або станом перегляду."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los grupos por más recientes, mayor ahorro de espacio, grupo más grande, mayor similitud o estado de revisión."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los grupos por más recientes, mayor ahorro de espacio, grupo más grande, mayor similitud o estado de revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene os grupos por mais recentes, maior economia de espaço, maior grupo, maior semelhança ou status de revisão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Gruppen nach neuesten, größter Ersparnis, größter Gruppe, höchster Ähnlichkeit oder Prüfstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les groupes par plus récents, plus grande économie d’espace, plus grand groupe, similarité la plus élevée ou statut d’examen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina i gruppi per più recenti, spazio da recuperare, gruppo più grande, somiglianza più alta o stato di controllo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer groepen op nieuwste, meeste ruimtewinst, grootste groep, grootste gelijkenis of beoordelingsstatus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortuj grupy według najnowszych, największej oszczędności miejsca, największej grupy, największego podobieństwa lub stanu przeglądu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupları en yeniye, en çok yer kazandırana, en büyük gruba, en yüksek benzerliğe ya da gözden geçirme durumuna göre sırala."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依最新、可省下最多空間、最大群組、相似度最高或檢視狀態來排序群組。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب المجموعات حسب الأحدث، أو الأكثر توفيرًا للمساحة، أو الأكبر حجمًا، أو الأعلى تشابهًا، أو حالة المراجعة."
          }
        }
      }
    },
