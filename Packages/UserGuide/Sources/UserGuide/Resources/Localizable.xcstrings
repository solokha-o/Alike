    "userGuide.cleanupQueue.badges.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the badges mean"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що означають позначки"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué significan las etiquetas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué significan las etiquetas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que significam os selos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Markierungen bedeuten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que signifient les pastilles"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.inReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've selected photos here but haven't marked the group as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вибрали фото в цій групі, але ще не позначили її як переглянуту."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionaste fotos aquí, pero no marcaste el grupo como revisado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has seleccionado fotos aquí, pero no has marcado el grupo como revisado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você selecionou fotos aqui, mas não marcou o grupo como revisado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast hier Fotos ausgewählt, die Gruppe aber nicht als geprüft markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez sélectionné des photos ici, mais sans marquer le groupe comme examiné."
          }
        }
      }
    },
