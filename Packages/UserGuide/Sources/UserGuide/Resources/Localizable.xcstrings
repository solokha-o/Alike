        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus totais acumulados: espaço recuperado, fotos movidas e sessões de limpeza concluídas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine laufenden Summen: freigegebener Speicher, bewegte Fotos und abgeschlossene Aufräum-Sitzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos totaux cumulés : espace récupéré, photos déplacées et sessions de nettoyage terminées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi totali progressivi: spazio recuperato, foto spostate e sessioni di pulizia completate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lopende totalen: vrijgemaakte ruimte, verplaatste foto's en voltooide opruimsessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje sumy narastające: odzyskane miejsce, przeniesione zdjęcia i ukończone sesje porządków."
