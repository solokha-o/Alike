    "cleanup.main.photosWereDeletedButLibrary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos were deleted, but the library refresh failed. Run a new scan to refresh your results."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото видалено, але оновити фототеку не вдалося. Запустіть нове сканування, щоб оновити результати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se eliminaron, pero no se pudo actualizar la fototeca. Haz un nuevo análisis para actualizar tus resultados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se han eliminado, pero no se ha podido actualizar la fototeca. Haz un nuevo análisis para actualizar tus resultados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos foram apagadas, mas a atualização da fototeca falhou. Faça uma nova análise para atualizar seus resultados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos wurden gelöscht, aber die Mediathek konnte nicht aktualisiert werden. Starte einen neuen Scan, um deine Ergebnisse zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos ont été supprimées, mais l’actualisation de la photothèque a échoué. Lancez une nouvelle analyse pour actualiser vos résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto sono state eliminate, ma l'aggiornamento della libreria non è riuscito. Esegui una nuova scansione per aggiornare i risultati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto's zijn verwijderd, maar het vernieuwen van de bibliotheek is mislukt. Voer een nieuwe scan uit om je resultaten bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia zostały usunięte, ale odświeżenie biblioteki się nie powiodło. Uruchom nowe skanowanie, aby odświeżyć wyniki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar silindi ama kitaplık yenilemesi başarısız oldu. Sonuçlarını yenilemek için yeni bir tarama yap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片已刪除，但圖庫更新失敗。請重新掃描以更新結果。"
          }
        }
      }
    },
