    "userGuide.smartCategories.workflow.select.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One button selects everything or clears the selection, and the summary keeps a running total."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка вибирає все або знімає вибір, а зведення показує поточний підсумок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón selecciona todo o quita la selección, y el resumen mantiene el total actualizado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón selecciona todo o quita la selección, y el resumen mantiene el total actualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão seleciona tudo ou limpa a seleção, e o resumo mantém o total atualizado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Button wählt alles aus oder hebt die Auswahl auf, und die Zusammenfassung hält die Summe aktuell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton sélectionne tout ou efface la sélection, et le résumé tient le total à jour."
          }
        }
      }
    },
