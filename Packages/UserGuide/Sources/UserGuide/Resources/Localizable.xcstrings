    "userGuide.settingsAndReminders.analysis.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing sensitivity asks for a rescan, because the groups have to be built again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна чутливості потребує пересканування, бо групи доводиться будувати заново."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad pide un nuevo análisis, porque los grupos se tienen que armar otra vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad pide un nuevo análisis, porque los grupos se tienen que armar otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a sensibilidade pede uma nova análise, porque os grupos precisam ser montados novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geänderte Empfindlichkeit verlangt einen neuen Scan, weil die Gruppen neu gebildet werden müssen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la sensibilité demande une nouvelle analyse, car les groupes doivent être reconstruits."
          }
        }
      }
    },
