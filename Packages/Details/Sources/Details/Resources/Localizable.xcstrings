    "details.clusterDetails.enhancementReplacesOtherEdit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying replaces the edit made in another app. The original stays recoverable."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосування замінить правку з іншого застосунку. Оригінал лишається можливим повернути."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar se reemplaza la edición hecha en otra app. El original sigue recuperable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar se reemplaza la edición hecha en otra app. El original sigue recuperable."
          }
        },
        "pt-BR": {
