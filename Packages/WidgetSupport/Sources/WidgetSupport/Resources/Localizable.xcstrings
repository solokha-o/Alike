    "widgetsupport.widget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار المساحة التي يمكنك استعادتها، والمراجعة التي لم تُكملها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Speicher frei werden kann – und die noch offene Prüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much space you can reclaim, and the review you left unfinished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto espacio puedes recuperar y la revisión que dejaste a medias."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto espacio puedes recuperar y la revisión que dejaste a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace que vous pouvez récupérer, et le tri resté inachevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto spazio puoi recuperare e la revisione rimasta a metà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel ruimte je kunt vrijmaken, en je onafgemaakte beoordeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile miejsca możesz odzyskać — i nieukończony przegląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto espaço você pode recuperar e a revisão que ficou pela metade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar alan kazanabileceğin ve yarım kalan incelemen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки місця можна звільнити — і перегляд, який ви не завершили."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以釋出多少空間，以及尚未完成的檢視。"
          }
        }
      }
    },
