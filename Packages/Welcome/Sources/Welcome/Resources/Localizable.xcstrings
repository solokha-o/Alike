    "welcome.main.photoAccessLetsAlikeScan" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح إذن الوصول إلى الصور لـ Alike فحص مكتبتك وتجميع الصور المتشابهة وإعداد اقتراحات تنظيف لتراجعها — وكذلك، عندما تطلب ذلك بنفسك فقط، حفظ نسخة محسّنة من صورة تحتفظ بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Fotozugriff kann Alike deine Mediathek scannen, ähnliche Fotos gruppieren und Aufräumvorschläge für dich vorbereiten — und, nur wenn du es verlangst, eine verbesserte Version eines Fotos sichern, das du behältst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review — and, only when you ask for it, save an enhanced version of a photo you keep."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review — and, only when you ask for it, save an enhanced version of a photo you keep."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review — and, only when you ask for it, save an enhanced version of a photo you keep."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review — and, only when you ask for it, save an enhanced version of a photo you keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a las fotos permite que Alike analice tu fototeca, agrupe fotos similares y prepare sugerencias de limpieza para que las revises y, solo cuando tú lo pidas, guarde una versión mejorada de la foto que conservas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a las fotos permite que Alike analice tu fototeca, agrupe fotos similares y prepare sugerencias de limpieza para que las revises y, solo cuando tú lo pidas, guarde una versión mejorada de la foto que conservas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos permet à Alike d’analyser votre photothèque, de regrouper les photos similaires et de préparer des suggestions de nettoyage à examiner — et, uniquement à votre demande, d’enregistrer une version améliorée d’une photo que vous gardez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos permet à Alike d’analyser votre photothèque, de regrouper les photos similaires et de préparer des suggestions de nettoyage à examiner — et, uniquement à votre demande, d’enregistrer une version améliorée d’une photo que vous gardez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alle foto permette ad Alike di analizzare la libreria, raggruppare le foto simili e preparare suggerimenti di pulizia da controllare — e, solo se lo chiedi tu, di salvare una versione migliorata di una foto che tieni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met fototoegang kan Alike je bibliotheek scannen, vergelijkbare foto's groeperen en opruimsuggesties voorbereiden die jij kunt bekijken — en, alleen als jij daarom vraagt, een verbeterde versie bewaren van een foto die je houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do zdjęć pozwala Alike przeskanować bibliotekę, pogrupować podobne zdjęcia i przygotować propozycje porządków do Twojego przejrzenia — a także, tylko na Twoje żądanie, zapisać poprawioną wersję zdjęcia, które zostawiasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotos permite que o Alike analise sua fototeca, agrupe fotos semelhantes e prepare sugestões de limpeza para você revisar — e, somente quando você pedir, salve uma versão aprimorada de uma foto que você mantém."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotografias permite ao Alike analisar a tua fototeca, agrupar fotografias semelhantes e preparar sugestões de limpeza para reveres. Permite também guardar uma versão melhorada de uma fotografia que manténs, mas apenas quando o pedes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf erişimi, Alike'ın fotoğraf arşivini taramasını, benzer fotoğrafları gruplamasını ve gözden geçirmen için temizlik önerileri hazırlamasını sağlar. Yalnızca sen istediğinde, sakladığın bir fotoğrafın iyileştirilmiş sürümünü de kaydedebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до фото дозволяє Alike сканувати фототеку, групувати схожі фото та готувати рекомендації для перегляду — і, лише коли ви самі про це попросите, зберігати покращену версію фото, яке ви залишаєте."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取用照片後，Alike 就能掃描你的圖庫、將相似照片分組，並準備清理建議供你檢視；也只有在你要求時，才會儲存你所保留照片的優化版本。"
          }
        }
      }
    },
