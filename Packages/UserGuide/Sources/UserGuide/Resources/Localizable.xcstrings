    "userGuide.gettingStarted.loop.scan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike looks through your photo library on the Scanner tab and groups photos that look alike."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вкладці «Сканер» Alike переглядає вашу медіатеку та групує схожі фото."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recorre tu fototeca desde la pestaña Análisis y agrupa las fotos que se parecen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recorre tu fototeca desde la pestaña Análisis y agrupa las fotos que se parecen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike percorre sua fototeca na aba Análise e agrupa as fotos parecidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike durchsucht im Tab „Scan“ deine Mediathek und gruppiert Fotos, die sich ähneln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike parcourt votre photothèque depuis l’onglet Analyse et regroupe les photos qui se ressemblent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike esamina la libreria foto dalla scheda Scanner e raggruppa le foto che si somigliano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike doorzoekt je fotobibliotheek op het tabblad Scanner en groepeert foto's die op elkaar lijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike przegląda bibliotekę zdjęć na karcie Skaner i grupuje zdjęcia, które wyglądają podobnie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike, Tarayıcı sekmesinde fotoğraf kitaplığınıza bakar ve birbirine benzeyen fotoğrafları gruplar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 會在「掃描」標籤頁瀏覽你的照片圖庫，並將外觀相似的照片分組。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث Alike في مكتبة صورك من علامة تبويب الفحص ويجمّع الصور المتشابهة."
          }
        }
      }
    },
