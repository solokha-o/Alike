    "userGuide.comparingPhotos.personalization.reset.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, Reset Best Shot Learning forgets everything Alike has picked up and returns to the default ranking."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الإعدادات، تؤدي «إعادة تعيين تعلّم أفضل لقطة» إلى نسيان كل ما تعلّمه Alike والعودة إلى الترتيب الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen setzt „Lernen für die beste Aufnahme zurücksetzen“ alles zurück, was Alike gelernt hat, und stellt das Standard-Ranking wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, «Restablecer aprendizaje de Mejor Toma» olvida todo lo que Alike ha aprendido y vuelve a la clasificación predeterminada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración, «Restablecer aprendizaje de Mejor Toma» olvida todo lo que Alike ha aprendido y vuelve a la clasificación predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, « Réinitialiser l'apprentissage de la Meilleure Photo » oublie tout ce qu'Alike a appris et revient au classement par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni, «Ripristina apprendimento Scatto Migliore» dimentica tutto ciò che Alike ha imparato e torna alla classifica predefinita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Instellingen zorgt 'Leren voor Beste Opname resetten' ervoor dat alles wat Alike heeft geleerd wordt vergeten en keert het terug naar de standaardrangschikking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach opcja „Zresetuj naukę Najlepszego ujęcia” zapomina wszystko, czego nauczył się Alike, i przywraca domyślny ranking."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes, “Redefinir aprendizado da Melhor Foto” esquece tudo o que o Alike aprendeu e volta à classificação padrão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'da 'En İyi Kare Öğrenimini Sıfırla', Alike'ın öğrendiği her şeyi unutur ve varsayılan sıralamaya döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Налаштуваннях пункт «Скинути навчання Найкращого кадру» забуває все, чого навчився Alike, і повертає стандартний рейтинг."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中，重設「最佳照片」學習內容會忘記 Alike 學到的一切，並回到預設排序。"
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.fullscreen.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the photo full screen. Swipe between the photos in the group and pinch to zoom in on the details."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває фото на весь екран. Гортайте фото групи та зводьте пальці, щоб роздивитися деталі."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la foto a pantalla completa. Desliza entre las fotos del grupo y pellizca para acercarte a los detalles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la foto a pantalla completa. Desliza entre las fotos del grupo y pellizca para acercarte a los detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a foto em tela cheia. Deslize entre as fotos do grupo e use o gesto de pinça para ampliar os detalhes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Foto im Vollbild. Streiche durch die Fotos der Gruppe und zoome mit zwei Fingern in die Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la photo en plein écran. Balayez entre les photos du groupe et pincez pour zoomer sur les détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la foto a schermo intero. Scorri tra le foto del gruppo e pizzica per ingrandire i dettagli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de foto schermvullend. Veeg tussen de foto's in de groep en knijp om in te zoomen op details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera zdjęcie na pełnym ekranie. Przesuwaj między zdjęciami w grupie i rozsuwaj palce, aby przybliżyć szczegóły."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı tam ekran açar. Gruptaki fotoğraflar arasında kaydır ve ayrıntılara yakınlaşmak için sıkıştır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以全螢幕打開照片。在群組照片間滑動，並用縮放手勢放大細節。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الصورة بملء الشاشة. مرّر بين صور المجموعة واستخدم القرص للتكبير على التفاصيل."
          }
        }
      }
    },
