    "userGuide.comparingPhotos.review.move.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button at the bottom appears once something is selected, and always asks for confirmation first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка внизу з'являється, щойно щось вибрано, і завжди спершу запитує підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de abajo aparece cuando hay algo seleccionado y siempre pide confirmación antes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de abajo aparece cuando hay algo seleccionado y siempre pide confirmación antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão na parte de baixo aparece quando há algo selecionado e sempre pede confirmação antes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Button unten erscheint, sobald etwas ausgewählt ist, und fragt immer vorher nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton du bas apparaît dès qu’un élément est sélectionné, et demande toujours confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante in basso compare quando qualcosa è selezionato e chiede sempre conferma prima di agire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De knop onderin verschijnt zodra er iets is geselecteerd en vraagt altijd eerst om bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk na dole pojawia się, gdy coś jest wybrane, i zawsze najpierw prosi o potwierdzenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alttaki düğme bir şey seçildiğinde görünür ve her zaman önce onay ister."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部的按鈕會在你選取項目後出現，並且一定會先請你確認。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الزر في الأسفل بمجرد تحديد شيء، وهو يطلب التأكيد دائمًا أولًا."
          }
        }
      }
    },
