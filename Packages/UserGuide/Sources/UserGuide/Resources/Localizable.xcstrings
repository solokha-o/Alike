          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllati, Rimanenti, Selezionate, Risparmio stimato"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekeken, Resterend, Geselecteerd, Geschatte besparing"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
