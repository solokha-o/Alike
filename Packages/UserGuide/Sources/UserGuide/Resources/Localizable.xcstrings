    "userGuide.deletingSafely.flow.recentlyDeleted.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos land in the Photos app's Recently Deleted album, where you can restore any of them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото потрапляють до альбому «Нещодавно видалені» у застосунку «Фото», звідки їх можна відновити."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos llegan al álbum Eliminados recientemente de la app Fotos, donde puedes recuperar cualquiera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos llegan al álbum Eliminados recientemente de la app Fotos, donde puedes recuperar cualquiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos vão para o álbum Apagados recentemente do app Fotos, de onde você pode recuperar qualquer uma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos landen im Album „Zuletzt gelöscht“ der Fotos-App, wo du jedes wiederherstellen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos arrivent dans l’album Supprimés récemment de l’app Photos, d’où vous pouvez toutes les restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto finiscono nell'album «Eliminati di recente» dell'app Foto, dove puoi ripristinarle tutte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's belanden in het album 'Recent verwijderd' van de Foto's-app, waar je ze allemaal kunt terugzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia trafiają do albumu „Ostatnio usunięte” w aplikacji Zdjęcia, skąd możesz je przywrócić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar, Fotoğraflar uygulamasındaki Son Silinenler albümüne gider ve buradan istediğini geri alabilirsin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會進入「照片」App 的「最近刪除」相簿，你可以從那裡回復任何一張。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي الصور إلى ألبوم «المحذوفة مؤخرًا» في تطبيق الصور، حيث يمكنك استعادة أي منها."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.recentlyDeleted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
