    "userGuide.comparingPhotos.review.keepAll.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If every photo in a group is worth keeping, mark it reviewed and move on. Nothing has to be removed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо всі фото в групі варті збереження, позначте її переглянутою та йдіть далі. Видаляти нічого не обов'язково."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vale la pena conservar todas las fotos de un grupo, márcalo como revisado y sigue. No hace falta eliminar nada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si merece la pena conservar todas las fotos de un grupo, márcalo como revisado y sigue. No hace falta eliminar nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vale a pena manter todas as fotos de um grupo, marque como revisado e siga em frente. Nada precisa ser removido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jedes Foto einer Gruppe bleiben soll, markiere sie als geprüft und mach weiter. Es muss nichts entfernt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si toutes les photos d’un groupe méritent d’être gardées, marquez-le comme examiné et passez à la suite. Rien n’a besoin d’être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in un gruppo vale la pena conservare ogni foto, segnalo come controllato e vai avanti. Non serve rimuovere nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als elke foto in een groep het bewaren waard is, markeer je de groep als bekeken en ga je verder. Er hoeft niets weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli warto zachować każde zdjęcie w grupie, oznacz ją jako przejrzaną i idź dalej. Nic nie musi zostać usunięte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gruptaki her fotoğraf saklanmaya değerse grubu gözden geçirildi olarak işaretle ve devam et. Hiçbir şeyin kaldırılması gerekmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果群組中的每張照片都值得保留，就標示為已檢視並繼續。不必移除任何東西。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت كل صورة في المجموعة تستحق الاحتفاظ، ضع علامة أنها روجعت وانتقل إلى غيرها. لا يلزم إزالة أي شيء."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.keepAll.title": {
