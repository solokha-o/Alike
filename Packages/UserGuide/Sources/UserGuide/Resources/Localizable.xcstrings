        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse ne s’est pas terminée"
          }
        }
      }
    },
    "userGuide.scanning.rescan.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refresh that runs by itself after you move photos does not count against your free scans."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення, яке запускається саме після переміщення фото, не витрачає безкоштовні сканування."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actualización que se ejecuta sola después de mover fotos no cuenta para tus análisis gratuitos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actualización que se ejecuta sola después de mover fotos no cuenta para tus análisis gratuitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atualização que roda sozinha depois de você mover fotos não conta nas suas análises gratuitas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aktualisierung, die nach dem Bewegen von Fotos von selbst läuft, zählt nicht auf deine kostenlosen Scans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une actualisation qui se lance d’elle-même après un déplacement de photos n’est pas décomptée de vos analyses gratuites."
          }
        }
      }
    },
    "userGuide.scanning.rescan.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to scan again"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сканувати знову"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo volver a analizar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo volver a analizar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando analisar de novo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann du erneut scannen solltest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand relancer une analyse"
          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add or remove photos elsewhere, Alike marks the results as needing a refresh and offers to rescan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви додаєте чи видаляєте фото деінде, Alike позначає результати як застарілі й пропонує пересканувати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando agregas o quitas fotos en otro lugar, Alike marca los resultados como pendientes de actualizar y ofrece analizar de nuevo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando añades o quitas fotos en otro lugar, Alike marca los resultados como pendientes de actualizar y ofrece analizar de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você adiciona ou remove fotos em outro lugar, o Alike marca os resultados como desatualizados e oferece uma nova análise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du anderswo Fotos hinzufügst oder entfernst, markiert Alike die Ergebnisse als aktualisierungsbedürftig und bietet einen neuen Scan an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ajoutez ou retirez des photos ailleurs, Alike signale que les résultats doivent être actualisés et propose une nouvelle analyse."
          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека змінилася"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca cambió"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca ha cambiado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua fototeca mudou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek hat sich geändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque a changé"
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity decides how alike two photos must be to land in the same group, so Alike asks to rescan after you change it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чутливість визначає, наскільки схожими мають бути фото для однієї групи, тому після зміни Alike пропонує пересканувати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad decide cuánto deben parecerse dos fotos para caer en el mismo grupo, así que Alike pide analizar de nuevo cuando la cambias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad decide cuánto deben parecerse dos fotos para caer en el mismo grupo, así que Alike pide analizar de nuevo cuando la cambias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensibilidade decide o quanto duas fotos precisam se parecer para caírem no mesmo grupo, por isso o Alike pede uma nova análise depois que você a altera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfindlichkeit entscheidet, wie ähnlich sich zwei Fotos sein müssen, um in dieselbe Gruppe zu kommen – deshalb bittet Alike nach einer Änderung um einen neuen Scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilité détermine à quel point deux photos doivent se ressembler pour tomber dans le même groupe : Alike propose donc une nouvelle analyse après un changement."
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed sensitivity"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви змінили чутливість"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste la sensibilidad"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cambiado la sensibilidad"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você alterou a sensibilidade"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Empfindlichkeit geändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez changé la sensibilité"
          }
        }
      }
    },
    "userGuide.scanning.run.background.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning continues when you switch tabs. Cleanup refreshes on its own once it finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування триває, коли ви перемикаєте вкладки. Після завершення «Очищення» оновиться саме."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis continúa cuando cambias de pestaña. La limpieza se actualiza sola cuando termina."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis continúa cuando cambias de pestaña. La limpieza se actualiza sola cuando termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise continua quando você troca de aba. A limpeza é atualizada sozinha assim que ela termina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan läuft weiter, wenn du den Tab wechselst. Das Aufräumen aktualisiert sich danach von selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse continue quand vous changez d’onglet. Le nettoyage s’actualise tout seul dès qu’elle est terminée."
          }
        }
      }
    },
    "userGuide.scanning.run.background.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep using the app while it works"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся застосунком під час сканування"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue usando la app mientras trabaja"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue usando la app mientras trabaja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue usando o app enquanto ele trabalha"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die App weiter, während sie arbeitet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à utiliser l’app pendant ce temps"
          }
        }
      }
    },
    "userGuide.scanning.run.cache.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike remembers what it learned about each photo and only re-analyses what actually changed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike запам'ятовує результати для кожного фото й повторно аналізує лише те, що справді змінилося."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recuerda lo que aprendió de cada foto y solo vuelve a analizar lo que realmente cambió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recuerda lo que aprendió de cada foto y solo vuelve a analizar lo que realmente cambió."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike guarda o que aprendeu sobre cada foto e só reanalisa o que de fato mudou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike merkt sich, was es über jedes Foto gelernt hat, und analysiert nur neu, was sich wirklich geändert hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike retient ce qu’il a appris de chaque photo et ne réanalyse que ce qui a réellement changé."
          }
        }
      }
    },
    "userGuide.scanning.run.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later scans are faster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступні сканування швидші"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis siguientes son más rápidos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis siguientes son más rápidos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As análises seguintes são mais rápidas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätere Scans sind schneller"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses suivantes sont plus rapides"
          }
        }
      }
    },
    "userGuide.scanning.run.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Scanner card changes as the scan progresses and tells you what to do next."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка сканера змінюється під час сканування й підказує, що робити далі."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de análisis cambia a medida que avanza y te dice qué hacer después."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de análisis cambia a medida que avanza y te dice qué hacer después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão da análise muda conforme ela avança e diz o que fazer em seguida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Scan-Karte verändert sich mit dem Fortschritt und sagt dir, was als Nächstes dran ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche d’analyse évolue avec la progression et vous indique quoi faire ensuite."
          }
        }
      }
    },
    "userGuide.scanning.run.header": {
