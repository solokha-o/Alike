    "details.clusterDetails.thisPhotoKeptAsBest" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ بهذه الصورة بوصفها أفضل لقطة. اضغط مطولًا على صورة أخرى لجعلها أفضل لقطة بدلًا منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto bleibt als beste Aufnahme erhalten. Halte ein anderes Foto gedrückt, um stattdessen dieses zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This photo is kept as the best shot. Long press another photo to make it the best shot instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This photo is kept as the best shot. Long press another photo to make it the best shot instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto se conserva como la mejor toma. Mantén pulsada otra foto para marcarla como la mejor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto se conserva como la mejor toma. Mantén pulsada otra foto para marcarla como la mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo est conservée comme la meilleure. Maintenez une autre photo pour la désigner à la place."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo est conservée comme la meilleure. Maintenez une autre photo pour la désigner à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa foto è conservata come scatto migliore. Tieni premuta un'altra foto per impostarla come scatto migliore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze foto wordt bewaard als beste opname. Houd een andere foto ingedrukt om die als beste opname in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zdjęcie jest zachowane jako najlepsze ujęcie. Przytrzymaj inne zdjęcie, aby to ono stało się najlepszym ujęciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto foi mantida como a melhor. Mantenha outra foto pressionada para defini-la como a melhor."
