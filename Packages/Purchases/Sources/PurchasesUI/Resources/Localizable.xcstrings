    "purchases.subscriptionPaywall.weCouldntCompletePurchaseCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't complete your purchase. Check your connection and try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити покупку. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos completar tu compra. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
