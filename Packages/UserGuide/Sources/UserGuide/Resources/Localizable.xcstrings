{
  "sourceLanguage": "en",
  "version": "1.1",
  "strings": {
    "userGuide.a11y.step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$d of %2$d: %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крок %1$d із %2$d: %3$@"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.changed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos were added to or removed from a group you had already reviewed, so it's worth another look."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вже переглянутій групі додалися або зникли фото, тож варто глянути ще раз."
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.changed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінено"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the badges mean"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що означають позначки"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.inReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've selected photos here but haven't marked the group as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вибрали фото в цій групі, але ще не позначили її як переглянуту."
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.inReview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In review"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У перегляді"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.new.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group appeared in the most recent scan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця група з'явилася під час останнього сканування."
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.new.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нове"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.notReviewed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't opened this group yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не відкривали цю групу."
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.notReviewed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not reviewed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не переглянуто"
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.reviewed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've made your decision about this group — whatever that decision was."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ухвалили рішення щодо цієї групи — яким би воно не було."
          }
        }
      }
    },
    "userGuide.cleanupQueue.badges.reviewed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянуто"
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.columns.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between a roomy one-column layout and a denser grid from the toolbar on any photo screen. Alike remembers your choice between launches."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайтеся між просторим одноколонковим виглядом і щільнішою сіткою на панелі інструментів будь-якого екрана з фото. Alike запам’ятовує ваш вибір між запусками."
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.columns.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Columns"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колонки"
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.filters.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrow the list by review status, minimum group size, or favourites only. Sorting stays available on Alike Free."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звужуйте список за станом перегляду, мінімальним розміром групи або лише обраними. Сортування доступне й в Alike Free."
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.filters.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced filters"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розширені фільтри"
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset controls puts sorting and filters back to their defaults."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скинути параметри» повертає сортування та фільтри до типових значень."
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting, filters and layout"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортування, фільтри та вигляд"
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.sort.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order groups by newest, most space to save, largest group, highest similarity, or review status."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядковуйте групи за новизною, обсягом економії, розміром групи, схожістю або станом перегляду."
          }
        }
      }
    },
    "userGuide.cleanupQueue.controls.sort.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортування"
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.continue.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the next group that still needs your attention, so you never have to hunt for where you stopped."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває наступну групу, яка ще потребує уваги, тож не доведеться шукати, де ви зупинилися."
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.continue.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Review"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити перегляд"
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш прогрес"
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.history.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows everything you've cleaned up so far, grouped by month, with your all-time total."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує все, що ви очистили, згруповане за місяцями, разом із підсумком за весь час."
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.history.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія"
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.metrics.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated Savings is how much space your current selection would free once the photos are permanently deleted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оцінена економія» — це місце, яке звільнить поточний вибір після остаточного видалення фото."
          }
        }
      }
    },
    "userGuide.cleanupQueue.progress.metrics.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed, Remaining, Selected, Estimated Savings"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянуто, Залишилося, Вибрано, Оцінена економія"
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.all.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every group Alike found, including the ones you already marked as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі знайдені Alike групи, зокрема ті, які ви вже позначили як переглянуті."
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.all.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All clusters"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі групи"
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review appears only when there is something new or changed to look at."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Потребує перегляду» з'являється лише тоді, коли є щось нове або змінене."
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two lists of groups"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два списки груп"
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.needsReview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups you haven't decided on yet, plus ones a rescan changed. Start here."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи, щодо яких ви ще не вирішили, і ті, що змінилися після пересканування. Почніть звідси."
          }
        }
      }
    },
    "userGuide.cleanupQueue.sections.needsReview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребує перегляду"
          }
        }
      }
    },
    "userGuide.cleanupQueue.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress, the two cluster sections, badges, sorting and filters."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш прогрес, два розділи груп, позначки, сортування та фільтри."
          }
        }
      }
    },
    "userGuide.cleanupQueue.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working through Cleanup"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робота з очищенням"
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.auto.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites come first, then the highest resolution, then the most recent shot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу обрані, потім найвища роздільна здатність, далі — найновіший знімок."
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.auto.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Alike picks it"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як Alike його обирає"
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your manual choice stays in place for as long as that photo exists."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ручний вибір діє, доки це фото існує."
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Best Shot"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкращий кадр"
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.override.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disagree? Press and hold any photo and choose Make Best Shot. The previous keeper joins your selection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згодні? Утримуйте будь-яке фото й виберіть «Зробити найкращим кадром». Попередній кадр перейде до вибору."
          }
        }
      }
    },
    "userGuide.comparingPhotos.bestShot.override.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Best Shot"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробити найкращим кадром"
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.fullscreen.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the photo full screen. Swipe between the photos in the group and pinch to zoom in on the details."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває фото на весь екран. Гортайте фото групи та зводьте пальці, щоб роздивитися деталі."
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.fullscreen.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Original"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити оригінал"
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking closer"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Детальний перегляд"
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.info.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a photo for resolution, file type, dates, favourite status, and where it was taken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте фото, щоб побачити роздільну здатність, тип файлу, дати, статус обраного та місце зйомки."
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.info.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Info"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати інформацію"
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking a group reviewed is your decision, not a consequence of selecting photos. You can reopen it at any time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка «переглянуто» — це ваше рішення, а не наслідок вибору фото. Ви завжди можете повернути групу в роботу."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing a group"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершення групи"
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.keepAll.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If every photo in a group is worth keeping, mark it reviewed and move on. Nothing has to be removed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо всі фото в групі варті збереження, позначте її переглянутою та йдіть далі. Видаляти нічого не обов'язково."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.keepAll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping everything counts too"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишити все — теж рішення"
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.move.body": {
