    "scanner.scannerHome.canSwitchTabsWhileScanning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch tabs while scanning. Your cleanup results will refresh when it finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час сканування можна переходити між вкладками. Результати очищення оновляться після його завершення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de pestaña mientras se analiza. Tus resultados de limpieza se actualizarán al terminar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de pestaña mientras se analiza. Tus resultados de limpieza se actualizarán al terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode trocar de aba durante a análise. Seus resultados de limpeza serão atualizados ao final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst während des Scans den Tab wechseln. Deine Ergebnisse werden nach Abschluss aktualisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer d’onglet pendant l’analyse. Vos résultats seront actualisés à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare scheda durante la scansione. I risultati della pulizia si aggiorneranno al termine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt tijdens het scannen naar een ander tabblad gaan. Je opruimresultaten worden bijgewerkt zodra het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas skanowania możesz przełączać karty. Wyniki porządków odświeżą się po zakończeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama sürerken sekmeler arasında geçiş yapabilirsin. Temizlik sonuçların tamamlandığında yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描期間可以切換標籤頁。掃描完成後，清理結果會自動更新。"
          }
        }
      }
    },
