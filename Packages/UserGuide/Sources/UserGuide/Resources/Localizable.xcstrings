    "userGuide.deletingSafely.flow.icloud.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud Photos is on, the same photos move to Recently Deleted on your other devices."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено «Фото iCloud», ті самі фото перемістяться до «Нещодавно видалених» на інших ваших пристроях."
          }
        }
      }
