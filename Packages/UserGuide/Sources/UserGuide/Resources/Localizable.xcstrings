    "userGuide.scanning.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running a scan, reading the Scanner card, and knowing when to rescan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як запустити сканування, читати картку сканера та коли повторювати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer un análisis, leer la tarjeta y saber cuándo volver a analizar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer un análisis, leer la tarjeta y saber cuándo volver a analizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer uma análise, ler o cartão e saber quando analisar de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Scan starten, die Scan-Karte lesen und wissen, wann du erneut scannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer une analyse, lire la fiche, et savoir quand relancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
