          "stringUnit": {
            "state": "translated",
            "value": "Find it in Settings, under Data & Privacy. It can't be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдете в «Налаштуваннях», у розділі «Дані та приватність». Скасувати неможливо."
          }
        }
      }
    },
    "userGuide.privacy.deleteData.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Alike Data"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити дані Alike"
          }
        }
      }
    },
    "userGuide.privacy.deleteData.kept.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos, your Recently Deleted album, your photo access, and your Alike Pro subscription."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото, альбом «Нещодавно видалені», доступ до фото та підписка Alike Pro."
          }
        }
      }
    },
    "userGuide.privacy.deleteData.kept.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays untouched"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що залишається недоторканим"
          }
        }
      }
    },
    "userGuide.privacy.deleteData.removed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan results and analysis caches, cleanup progress and history, and your Alike preferences."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати сканування й кеші аналізу, прогрес та історія очищення, а також ваші налаштування Alike."
          }
        }
      }
    },
    "userGuide.privacy.deleteData.removed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What gets erased"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що стирається"
          }
        }
      }
    },
    "userGuide.privacy.deleteData.replay.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike shows its introduction again afterwards, without asking for photo access a second time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього Alike знову покаже вступ, не запитуючи доступ до фото вдруге."
          }
        }
      }
    },
    "userGuide.privacy.deleteData.replay.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting fresh"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початок з чистого аркуша"
          }
        }
      }
    },
    "userGuide.privacy.onDevice.analysis.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are compared using Apple's on-device vision framework, and the results are stored locally."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото порівнюються за допомогою системного фреймворку Apple на пристрої, а результати зберігаються локально."
          }
        }
      }
    },
    "userGuide.privacy.onDevice.analysis.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis never leaves your iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз не залишає ваш iPhone"
          }
        }
      }
    },
    "userGuide.privacy.onDevice.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike has no account, no sign-in, and no server of its own."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В Alike немає облікового запису, входу чи власного сервера."
          }
        }
      }
    },
    "userGuide.privacy.onDevice.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your device"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому пристрої"
          }
        }
      }
    },
    "userGuide.privacy.onDevice.network.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only network requests Alike makes are to the App Store, for subscriptions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Єдині мережеві запити Alike — до App Store, для підписок."
          }
        }
      }
    },
    "userGuide.privacy.onDevice.network.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos are never uploaded"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото ніколи не завантажуються"
          }
        }
      }
    },
    "userGuide.privacy.permissions.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Alike asks for"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що запитує Alike"
          }
        }
      }
    },
    "userGuide.privacy.permissions.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested only if you turn on the weekly cleanup reminder, and never otherwise."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуються, лише якщо ви ввімкнете щотижневе нагадування, і більше ніколи."
          }
        }
      }
    },
    "userGuide.privacy.permissions.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення"
          }
        }
      }
    },
    "userGuide.privacy.permissions.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested once at the start. You can change or limit it any time in iOS Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитується один раз на початку. Ви можете змінити або обмежити доступ будь-коли в Налаштуваннях iOS."
          }
        }
      }
    },
    "userGuide.privacy.permissions.photos.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo library"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека"
          }
        }
      }
    },
    "userGuide.privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays on your device, what Alike asks for, and how to erase its data."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що залишається на пристрої, що запитує Alike і як стерти його дані."
          }
        }
      }
    },
    "userGuide.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and your data"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватність і ваші дані"
          }
        }
      }
    },
    "userGuide.scanning.rescan.error.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card explains what went wrong and offers Retry. Earlier results stay available in the meantime."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка пояснює, що сталося, і пропонує повторити. Попередні результати тим часом залишаються доступними."
          }
        }
      }
    },
    "userGuide.scanning.rescan.error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scan didn't finish"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування не завершилося"
          }
        }
      }
    },
    "userGuide.scanning.rescan.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refresh that runs by itself after you move photos does not count against your free scans."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення, яке запускається саме після переміщення фото, не витрачає безкоштовні сканування."
          }
        }
      }
    },
    "userGuide.scanning.rescan.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to scan again"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сканувати знову"
          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add or remove photos elsewhere, Alike marks the results as needing a refresh and offers to rescan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви додаєте чи видаляєте фото деінде, Alike позначає результати як застарілі й пропонує пересканувати."
          }
        }
      }
    },
    "userGuide.scanning.rescan.libraryChanged.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library changed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека змінилася"
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity decides how alike two photos must be to land in the same group, so Alike asks to rescan after you change it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чутливість визначає, наскільки схожими мають бути фото для однієї групи, тому після зміни Alike пропонує пересканувати."
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed sensitivity"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви змінили чутливість"
          }
        }
      }
    },
    "userGuide.scanning.run.background.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning continues when you switch tabs. Cleanup refreshes on its own once it finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування триває, коли ви перемикаєте вкладки. Після завершення «Очищення» оновиться саме."
          }
        }
      }
    },
    "userGuide.scanning.run.background.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep using the app while it works"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся застосунком під час сканування"
          }
        }
      }
    },
    "userGuide.scanning.run.cache.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike remembers what it learned about each photo and only re-analyses what actually changed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike запам'ятовує результати для кожного фото й повторно аналізує лише те, що справді змінилося."
          }
        }
      }
    },
    "userGuide.scanning.run.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later scans are faster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступні сканування швидші"
          }
        }
      }
    },
    "userGuide.scanning.run.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Scanner card changes as the scan progresses and tells you what to do next."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка сканера змінюється під час сканування й підказує, що робити далі."
          }
        }
      }
    },
    "userGuide.scanning.run.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running a scan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск сканування"
          }
        }
      }
    },
    "userGuide.scanning.run.start.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button on the Scanner tab. A progress bar shows how far along the analysis is."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку на вкладці «Сканер». Індикатор покаже, скільки залишилося аналізувати."
          }
        }
      }
    },
    "userGuide.scanning.run.start.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start scanning"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати сканування"
          }
        }
      }
    },
    "userGuide.scanning.status.allowance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free includes three scans each calendar month. The counter resets at the start of the next month."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free містить три сканування щокалендарного місяця. Лічильник оновлюється на початку наступного місяця."
          }
        }
      }
    },
    "userGuide.scanning.status.allowance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free scans remaining"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок безкоштовних сканувань"
          }
        }
      }
    },
    "userGuide.scanning.status.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your first scan the card shows when it ran, how many opportunities were found, and how much space they hold."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після першого сканування картка показує, коли воно відбулося, скільки знайдено можливостей і скільки місця вони займають."
          }
        }
      }
    },
    "userGuide.scanning.status.card.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last scan at a glance"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Огляд останнього сканування"
          }
        }
      }
    },
    "userGuide.scanning.status.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library status"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан медіатеки"
          }
        }
      }
    },
    "userGuide.scanning.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running a scan, reading the Scanner card, and knowing when to rescan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як запустити сканування, читати картку сканера та коли повторювати."
          }
        }
      }
    },
    "userGuide.scanning.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning your library"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування медіатеки"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing sensitivity asks for a rescan, because the groups have to be built again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна чутливості потребує пересканування, бо групи доводиться будувати заново."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuning the results"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування результатів"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.language.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike is available in English and Ukrainian. The switch opens the iOS Settings page for the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike доступний англійською та українською. Перемикач відкриває сторінку застосунку в Налаштуваннях iOS."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.language.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Language"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити мову"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.sensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low groups only near-identical photos. High casts a wider net and finds more, but loosely related, matches."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Низька» групує лише майже однакові фото. «Висока» шукає ширше й знаходить більше, але менш споріднених збігів."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.analysis.sensitivity.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чутливість"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reminder is off until you turn it on, and asks for notification permission the first time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування вимкнене, доки ви його не ввімкнете, і першого разу запитує дозвіл на сповіщення."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly cleanup reminder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щотижневе нагадування про очищення"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.schedule.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro lets you move the reminder to whichever day and time suits you."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Pro дозволяє перенести нагадування на зручні вам день і час."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.schedule.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your own day and time"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть свій день і час"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.weekly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder to spend a few minutes on cleanup. On Alike Free it arrives on Sunday evening."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Делікатне нагадування приділити кілька хвилин очищенню. В Alike Free воно приходить у неділю ввечері."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.reminder.weekly.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge once a week"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування раз на тиждень"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.subscription.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша підписка"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.subscription.restore.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a new device, or after reinstalling, this brings your existing subscription back."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На новому пристрої або після перевстановлення це поверне вашу наявну підписку."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.subscription.restore.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Purchases"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити покупки"
          }
        }
      }
    },
    "userGuide.settingsAndReminders.subscription.status.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card at the top of Settings shows whether Alike Pro is active and when it renews."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка вгорі «Налаштувань» показує, чи активна Alike Pro і коли вона поновлюється."
          }
        }
      }
    },
    "userGuide.settingsAndReminders.subscription.status.title": {
