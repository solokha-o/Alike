    "widgetsupport.widget.libraryDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعات الصور المتشابهة ولقطات الشاشة والصور الضبابية في لمحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Gruppen, Screenshots und unscharfe Fotos auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar groups, screenshots and blurred photos, at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos de similares, capturas y fotos borrosas de un vistazo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos de similares, capturas y fotos borrosas de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupes de photos similaires, captures d’écran et photos floues en un coup d’œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppi di foto simili, screenshot e foto sfocate a colpo d’occhio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkbare groepen, schermafbeeldingen en onscherpe foto’s in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupy podobnych, zrzuty ekranu i rozmyte zdjęcia na pierwszy rzut oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos de semelhantes, capturas de tela e fotos desfocadas num relance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzer gruplar, ekran görüntüleri ve bulanık fotoğraflar bir bakışta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи схожих, скриншоти й розмиті фото — з одного погляду."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼掌握相似群組、螢幕截圖與模糊照片。"
          }
        }
      }
