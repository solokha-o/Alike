    "userGuide.scanning.rescan.error.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card explains what went wrong and offers Retry. Earlier results stay available in the meantime."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка пояснює, що сталося, і пропонує повторити. Попередні результати тим часом залишаються доступними."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta explica qué salió mal y ofrece Reintentar. Mientras tanto, los resultados anteriores siguen disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta explica qué ha ido mal y ofrece Reintentar. Mientras tanto, los resultados anteriores siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão explica o que deu errado e oferece Tentar novamente. Os resultados anteriores continuam disponíveis enquanto isso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte erklärt, was schiefging, und bietet „Wiederholen“ an. Frühere Ergebnisse bleiben solange verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche explique ce qui n’a pas fonctionné et propose Réessayer. Les résultats précédents restent disponibles entre-temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda spiega cosa è andato storto e propone «Riprova». Nel frattempo i risultati precedenti restano disponibili."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart legt uit wat er misging en biedt Opnieuw aan. Eerdere resultaten blijven ondertussen beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta wyjaśnia, co poszło nie tak, i proponuje Ponów. W międzyczasie wcześniejsze wyniki pozostają dostępne."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart neyin ters gittiğini açıklar ve Yeniden Dene seçeneği sunar. Bu sırada önceki sonuçlar kullanılabilir kalır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片會說明出了什麼問題並提供「重試」。在此期間，先前的結果仍可使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توضّح البطاقة ما الذي حدث وتتيح «إعادة المحاولة». وتبقى النتائج السابقة متاحة في هذه الأثناء."
          }
        }
      }
    },
    "userGuide.scanning.rescan.error.title": {
      "extractionState": "manual",
      "localizations": {
