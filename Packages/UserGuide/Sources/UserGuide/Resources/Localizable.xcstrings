    "userGuide.settingsAndReminders.reminder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reminder is off until you turn it on, and asks for notification permission the first time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування вимкнене, доки ви його не ввімкнете, і першого разу запитує дозвіл на сповіщення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatorio está desactivado hasta que lo actives, y la primera vez pide permiso de notificaciones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatorio está desactivado hasta que lo actives, y la primera vez pide permiso de notificaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lembrete fica desativado até você ligá-lo, e pede permissão de notificações na primeira vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerung ist aus, bis du sie einschaltest, und fragt beim ersten Mal nach der Mitteilungserlaubnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rappel est désactivé tant que vous ne l’activez pas, et demande l’autorisation de notification la première fois."
          }
        }
      }
    },
