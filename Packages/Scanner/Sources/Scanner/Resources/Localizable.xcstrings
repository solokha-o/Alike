    "scanner.alike.libraryChanged.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again to refresh your cleanup opportunities."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проскануйте знову, щоб оновити можливості для очищення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza de nuevo para actualizar tus oportunidades de limpieza."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza de nuevo para actualizar tus oportunidades de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise novamente para atualizar suas oportunidades de limpeza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne erneut, um deine Aufräummöglichkeiten zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez une analyse pour actualiser vos possibilités de nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti la scansione per aggiornare le occasioni di pulizia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan opnieuw om je opruimkansen bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ponownie, aby odświeżyć okazje do porządków."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlik fırsatlarını yenilemek için yeniden tara."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新掃描以更新可清理的項目。"
          }
        }
      }
    },
