    "userGuide.cleanupQueue.progress.continue.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the next group that still needs your attention, so you never have to hunt for where you stopped."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває наступну групу, яка ще потребує уваги, тож не доведеться шукати, де ви зупинилися."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el siguiente grupo que aún necesita tu atención, para que nunca tengas que buscar dónde te quedaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el siguiente grupo que aún necesita tu atención, para que nunca tengas que buscar dónde te quedaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o próximo grupo que ainda precisa da sua atenção, para você nunca ter que procurar onde parou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die nächste Gruppe, die noch offen ist – du musst nie suchen, wo du aufgehört hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le groupe suivant qui demande encore votre attention : plus besoin de chercher où vous vous êtes arrêté."
          }
        }
      }
    },
