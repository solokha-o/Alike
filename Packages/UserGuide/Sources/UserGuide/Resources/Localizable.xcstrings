    "userGuide.gettingStarted.scope.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analyses photos only. Videos are never read or included in a scan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike аналізує лише фото. Відео ніколи не зчитуються й не потрапляють у сканування."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analiza solo fotos. Los videos nunca se leen ni se incluyen en un análisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analiza solo fotos. Los vídeos nunca se leen ni se incluyen en un análisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike analisa apenas fotos. Vídeos nunca são lidos nem incluídos em uma análise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analysiert ausschließlich Fotos. Videos werden nie gelesen und nie in einen Scan einbezogen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike analyse uniquement les photos. Les vidéos ne sont jamais lues ni incluses dans une analyse."
          }
        }
      }
    },
    "userGuide.gettingStarted.scope.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Alike looks at"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що аналізує Alike"
          }
        },
        "es-419": {
