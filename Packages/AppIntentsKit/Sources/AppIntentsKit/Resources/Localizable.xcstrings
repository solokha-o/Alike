    "appintents.showReclaimable.nothingToFree": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to free right now. Your library is tidy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз нічого звільняти. Бібліотека впорядкована."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que liberar ahora. Tu biblioteca está ordenada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que liberar ahora. Tu fototeca está ordenada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para liberar agora. Sua biblioteca está em ordem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade nichts freizugeben. Deine Mediathek ist aufgeräumt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à libérer pour le moment. Votre photothèque est en ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da liberare al momento. La libreria è in ordine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets vrij te maken op dit moment. Je bibliotheek is opgeruimd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma teraz nic do odzyskania. Biblioteka jest uporządkowana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda boşaltılacak bir şey yok. Arşiviniz düzenli."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可釋放的空間。你的圖庫很整潔。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لتحريره الآن. مكتبتك مرتبة."
          }
        }
      }
    },
    "appintents.showReclaimable.result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can free about %@ with Alike."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike може звільнити близько %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes liberar unos %@ con Alike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes liberar unos %@ con Alike."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode liberar cerca de %@ com o Alike."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst mit Alike etwa %@ freigeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez libérer environ %@ avec Alike."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi liberare circa %@ con Alike."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ongeveer %@ vrijmaken met Alike."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz odzyskać około %@ dzięki Alike."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ile yaklaşık %@ boşaltabilirsiniz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以透過 Alike 釋放約 %@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحرير نحو %@ باستخدام Alike."
          }
        }
      }
    },
    "appintents.showReclaimable.scanFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan your library in Alike first, then ask again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку проскануйте бібліотеку в Alike, потім запитайте знову."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero escanea tu biblioteca en Alike y vuelve a preguntar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero escanea tu fototeca en Alike y vuelve a preguntar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro analise sua biblioteca no Alike e depois pergunte de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne zuerst deine Mediathek in Alike und frag dann noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez d’abord votre photothèque dans Alike, puis redemandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima analizza la libreria in Alike, poi chiedi di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan eerst je bibliotheek in Alike en vraag het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw przeskanuj bibliotekę w Alike, a potem zapytaj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Alike’ta arşivinizi tarayın, sonra yeniden sorun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 Alike 中掃描圖庫，然後再詢問。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مكتبتك في Alike أولًا، ثم اسأل مرة أخرى."
          }
        }
      }
    }
  },
  "version": "1.1"
