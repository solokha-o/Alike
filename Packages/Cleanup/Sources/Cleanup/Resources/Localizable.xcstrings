        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Alike esta semana para tirar o excesso e continuar economizando espaço."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Alike diese Woche, räume auf und spare weiter Speicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Alike cette semaine pour faire le tri et continuer à gagner de l’espace."
