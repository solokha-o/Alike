    "userGuide.privacy.permissions.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested only if you turn on the weekly cleanup reminder, and never otherwise."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуються, лише якщо ви ввімкнете щотижневе нагадування, і більше ніколи."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide solo si activas el recordatorio semanal de limpieza; nunca en otro caso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide solo si activas el recordatorio semanal de limpieza; nunca en otro caso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido apenas se você ativar o lembrete semanal de limpeza, e nunca em outra situação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur angefragt, wenn du die wöchentliche Aufräum-Erinnerung einschaltest, sonst nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé uniquement si vous activez le rappel de nettoyage hebdomadaire, jamais autrement."
          }
        }
      }
    },
    "userGuide.privacy.permissions.notifications.title": {
      "extractionState": "manual",
      "localizations": {
