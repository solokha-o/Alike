    "userGuide.privacy.deleteData.removed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan results and analysis caches, cleanup progress and history, and your Alike preferences."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати сканування й кеші аналізу, прогрес та історія очищення, а також ваші налаштування Alike."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de los análisis y sus cachés, el progreso e historial de limpieza y tus preferencias de Alike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de los análisis y sus cachés, el progreso e historial de limpieza y tus preferencias de Alike."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados das análises e caches de análise, progresso e histórico de limpeza e suas preferências do Alike."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan-Ergebnisse und Analyse-Caches, Aufräum-Fortschritt und -Verlauf sowie deine Alike-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats d’analyse et leurs caches, la progression et l’historique de nettoyage, et vos préférences Alike."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risultati delle scansioni e cache di analisi, avanzamento e cronologia della pulizia, e le tue preferenze di Alike."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanresultaten en analysecaches, opruimvoortgang en -geschiedenis, en je Alike-voorkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki skanowania i pamięci podręczne analizy, postęp i historia porządków oraz Twoje preferencje Alike."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama sonuçları ve analiz önbellekleri, temizlik ilerlemesi ve geçmişi ile Alike tercihlerin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描結果與分析快取、清理進度與歷史記錄，以及你的 Alike 偏好設定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتائج الفحص وذواكر التحليل المؤقتة، وتقدّم التنظيف وسجله، وتفضيلات Alike لديك."
          }
        }
      }
    },
