        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel het opruimen van schermafbeeldingen om ze te bekijken en te verwijderen, met dezelfde veilige bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj porządki w zrzutach ekranu, aby przeglądać je i usuwać z tym samym bezpiecznym potwierdzeniem."
