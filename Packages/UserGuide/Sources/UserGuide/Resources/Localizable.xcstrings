          }
        }
      }
    },
    "userGuide.gettingStarted.loop.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop after any step and pick up later — your progress is saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете зупинитися на будь-якому кроці й повернутися пізніше — прогрес зберігається."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes parar después de cualquier paso y retomarlo más tarde: tu progreso se guarda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes parar después de cualquier paso y retomarlo más tarde: tu progreso se guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode parar depois de qualquer etapa e continuar depois — seu progresso é salvo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nach jedem Schritt aufhören und später weitermachen – dein Fortschritt wird gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous arrêter après n’importe quelle étape et reprendre plus tard : votre progression est enregistrée."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three-step loop"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл із трьох кроків"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El ciclo de tres pasos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ciclo de tres pasos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ciclo de três etapas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dreischritt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boucle en trois étapes"
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm, and the selected photos go to Recently Deleted, where iOS keeps them for 30 days."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте — і вибрані фото потраплять до «Нещодавно видалених», де iOS зберігає їх 30 днів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma y las fotos seleccionadas pasan a Eliminados recientemente, donde iOS las guarda 30 días."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma y las fotos seleccionadas pasan a Eliminados recientemente, donde iOS las guarda 30 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme e as fotos selecionadas vão para Apagados recentemente, onde o iOS as mantém por 30 dias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, und die ausgewählten Fotos wandern in „Zuletzt gelöscht“, wo iOS sie 30 Tage aufbewahrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez, et les photos sélectionnées partent dans Supprimés récemment, où iOS les garde 30 jours."
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.move.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
