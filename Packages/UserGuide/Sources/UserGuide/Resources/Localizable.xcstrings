    "userGuide.comparingPhotos.bestShot.override.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disagree? Press and hold any photo and choose Make Best Shot. The previous keeper joins your selection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згодні? Утримуйте будь-яке фото й виберіть «Зробити найкращим кадром». Попередній кадр перейде до вибору."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No estás de acuerdo? Mantén pulsada cualquier foto y elige «Marcar como mejor toma». La anterior pasa a tu selección."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No estás de acuerdo? Mantén pulsada cualquier foto y elige «Marcar como mejor toma». La anterior pasa a tu selección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não concorda? Mantenha qualquer foto pressionada e escolha “Definir como melhor foto”. A anterior entra na sua seleção."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anderer Meinung? Halte ein beliebiges Foto gedrückt und wähle „Als beste Aufnahme festlegen“. Die bisherige wandert in deine Auswahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accord ? Maintenez n’importe quelle photo et choisissez « Définir comme meilleure photo ». La précédente rejoint votre sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei d'accordo? Tieni premuta una foto e scegli «Imposta come scatto migliore». Quella precedente entra nella selezione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet mee eens? Houd een foto ingedrukt en kies 'Maak beste opname'. De vorige favoriet gaat mee in je selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zgadzasz się? Przytrzymaj dowolne zdjęcie i wybierz „Ustaw jako najlepsze ujęcie”. Poprzednie trafi do Twojego wyboru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmıyor musun? Herhangi bir fotoğrafa uzun bas ve En İyi Kare Yap'ı seç. Önceki fotoğraf seçimine katılır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不同意嗎？長按任一張照片並選擇「設為最佳照片」。原本保留的那張會加入你的選取範圍。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توافق؟ اضغط مطولًا على أي صورة واختر «جعلها أفضل لقطة». وتنضم اللقطة السابقة إلى تحديدك."
          }
        }
      }
    },
