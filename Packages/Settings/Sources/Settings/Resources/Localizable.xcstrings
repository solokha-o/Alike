          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze overschrijving is alleen beschikbaar in debugversies en heeft invloed op de lokale premiumtoegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nadpisanie jest dostępne tylko w kompilacjach debugowania i wpływa na lokalne ograniczenia premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
