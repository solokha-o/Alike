  "strings": {
    "scanner.alike.libraryChanged.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan New Photos"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканувати нові фото"
          }
        }
      }
    },
    "scanner.alike.libraryChanged.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New photos detected."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виявлено нові фото."
          }
        }
      }
    },
    "scanner.alike.libraryChanged.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again to refresh your cleanup opportunities."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проскануйте знову, щоб оновити можливості для очищення."
          }
        }
      }
    },
    "scanner.alike.ready.cta": {
      "extractionState": "manual",
      "localizations": {
