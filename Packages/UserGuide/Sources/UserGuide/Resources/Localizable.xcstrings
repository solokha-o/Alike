            "value": "Zugriff und Sicherheit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès et sécurité"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike only ever suggests. Every removal needs your selection and the system confirmation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike лише пропонує. Кожне видалення потребує вашого вибору та системного підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike solo sugiere. Cada eliminación necesita tu selección y la confirmación del sistema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike solo sugiere. Cada eliminación necesita tu selección y la confirmación del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike apenas sugere. Toda remoção depende da sua seleção e da confirmação do sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike schlägt immer nur vor. Jede Entfernung braucht deine Auswahl und die Bestätigung des Systems."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike se contente de suggérer. Chaque suppression passe par votre sélection et la confirmation du système."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.noAutoDelete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted automatically"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється автоматично"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado automaticamente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird automatisch gelöscht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé automatiquement"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are analysed on device. Nothing is uploaded anywhere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото аналізуються на пристрої. Нічого нікуди не завантажується."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se analizan en el dispositivo. No se sube nada a ningún lado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se analizan en el dispositivo. No se sube nada a ningún lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são analisadas no dispositivo. Nada é enviado para lugar nenhum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden auf dem Gerät analysiert. Nichts wird irgendwohin hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont analysées sur l’appareil. Rien n’est envoyé où que ce soit."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.onDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе працює на вашому iPhone"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en tu iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en tu iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo roda no seu iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se passe sur votre iPhone"
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs read and write access to your library: read to analyse photos, write to move the ones you pick."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до медіатеки на читання й запис: читання — щоб аналізувати фото, запис — щоб переміщувати вибрані."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso de lectura y escritura a tu fototeca: lectura para analizar las fotos y escritura para mover las que elijas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso de lectura y escritura a tu fototeca: lectura para analizar las fotos y escritura para mover las que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike precisa de acesso de leitura e gravação à sua fototeca: leitura para analisar as fotos e gravação para mover as que você escolher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike braucht Lese- und Schreibzugriff auf deine Mediathek: Lesen, um Fotos zu analysieren, Schreiben, um die von dir gewählten zu bewegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike a besoin d’un accès en lecture et en écriture à votre photothèque : la lecture pour analyser les photos, l’écriture pour déplacer celles que vous choisissez."
          }
        }
      }
    },
    "userGuide.gettingStarted.access.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access"
          }
        },
        "uk": {
          "stringUnit": {
