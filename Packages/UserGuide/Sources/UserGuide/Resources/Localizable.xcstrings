    "userGuide.comparingPhotos.selection.batch.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free moves one photo at a time. Alike Pro removes your whole selection in a single step."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free переміщує по одному фото. Alike Pro видаляє весь вибір за один крок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free mueve una foto a la vez. Alike Pro elimina toda tu selección en un solo paso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free mueve una foto a la vez. Alike Pro elimina toda tu selección en un solo paso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike Free move uma foto por vez. O Alike Pro remove toda a sua seleção em uma única etapa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free bewegt ein Foto nach dem anderen. Alike Pro entfernt deine ganze Auswahl in einem Schritt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free déplace une photo à la fois. Alike Pro supprime toute votre sélection en une seule étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free sposta una foto alla volta. Alike Pro rimuove l'intera selezione in un solo passaggio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free verplaatst één foto tegelijk. Alike Pro verwijdert je hele selectie in één stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free przenosi po jednym zdjęciu. Alike Pro usuwa cały wybór w jednym kroku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free fotoğrafları teker teker taşır. Alike Pro tüm seçimini tek adımda kaldırır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free 一次移動一張照片。Alike Pro 可一步移除整組選取項目。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقل Alike المجاني صورة واحدة في كل مرة. أما Alike Pro فيزيل تحديدك كاملًا في خطوة واحدة."
          }
        }
      }
    },
