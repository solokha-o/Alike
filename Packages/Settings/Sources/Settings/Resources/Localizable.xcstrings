    "settings.main.thisPermanentlyDeletesAlikesLocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف نتائج Alike المحلية وسجل التنظيف والتفضيلات نهائيًا. أما صورك واشتراكك فسيبقيان كما هما."
