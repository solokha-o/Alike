    "userGuide.deletingSafely.flow.icloud.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud Photos is on, the same photos move to Recently Deleted on your other devices."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено «Фото iCloud», ті самі фото перемістяться до «Нещодавно видалених» на інших ваших пристроях."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Fotos en iCloud está activado, las mismas fotos pasan a Eliminados recientemente en tus otros dispositivos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Fotos en iCloud está activado, las mismas fotos pasan a Eliminados recientemente en tus otros dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Fotos do iCloud estiver ativado, as mesmas fotos vão para Apagados recentemente nos seus outros dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist iCloud-Fotos aktiv, wandern dieselben Fotos auch auf deinen anderen Geräten in „Zuletzt gelöscht“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Photos iCloud est activé, les mêmes photos passent dans Supprimés récemment sur vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «Foto di iCloud» è attivo, le stesse foto passano in «Eliminati di recente» anche sugli altri tuoi dispositivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als iCloud-foto's aanstaat, gaan dezelfde foto's ook op je andere apparaten naar 'Recent verwijderd'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Zdjęcia iCloud są włączone, te same zdjęcia trafią do albumu „Ostatnio usunięte” także na innych Twoich urządzeniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Fotoğrafları açıksa aynı fotoğraflar diğer aygıtlarında da Son Silinenler'e taşınır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若已開啟「iCloud 照片」，同樣的照片也會在你的其他裝置上移到「最近刪除」。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت صور iCloud مفعّلة، تُنقل الصور نفسها إلى «المحذوفة مؤخرًا» على أجهزتك الأخرى."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.icloud.title": {
