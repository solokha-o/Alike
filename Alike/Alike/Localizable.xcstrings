    "guide.freeAndPro.free.sorting.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Every sort order in Cleanup is available without a subscription."}},"uk":{"stringUnit":{"state":"translated","value":"Усі варіанти сортування в «Очищенні» доступні без підписки."}}}},
