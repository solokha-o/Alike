    "details.common.someSelectedPhotosNoLonger" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد بعض الصور المحددة متاحة. قد يكون وصولك إلى المكتبة محدودًا، أو أن المكتبة تغيّرت منذ آخر فحص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige ausgewählte Fotos sind nicht mehr verfügbar. Möglicherweise ist dein Mediathek-Zugriff eingeschränkt oder die Mediathek hat sich seit dem letzten Scan geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some selected photos are no longer available. Your library access may be limited, or the library changed since the last scan."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some selected photos are no longer available. Your library access may be limited, or the library changed since the last scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas fotos seleccionadas ya no están disponibles. Puede que tu acceso a la fototeca sea limitado o que la fototeca haya cambiado desde el último análisis."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas fotos seleccionadas ya no están disponibles. Puede que tu acceso a la fototeca sea limitado o que la fototeca haya cambiado desde el último análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines photos sélectionnées ne sont plus disponibles. Votre accès à la photothèque est peut-être limité, ou la photothèque a changé depuis la dernière analyse."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines photos sélectionnées ne sont plus disponibles. Votre accès à la photothèque est peut-être limité, ou la photothèque a changé depuis la dernière analyse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune foto selezionate non sono più disponibili. L'accesso alla tua libreria potrebbe essere limitato oppure la libreria è cambiata dall'ultima scansione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige geselecteerde foto's zijn niet meer beschikbaar. Je bibliotheektoegang is mogelijk beperkt, of de bibliotheek is sinds de laatste scan gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część wybranych zdjęć jest już niedostępna. Dostęp do biblioteki może być ograniczony lub biblioteka zmieniła się od ostatniego skanowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas fotos selecionadas não estão mais disponíveis. Seu acesso à fototeca pode estar limitado, ou a fototeca mudou desde a última análise."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas fotografias selecionadas já não estão disponíveis. O teu acesso à fototeca poderá estar limitado, ou a fototeca mudou desde a última análise."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili fotoğraflardan bazıları artık kullanılamıyor. Kitaplık erişimin sınırlı olabilir ya da kitaplık son taramadan bu yana değişmiş olabilir."
