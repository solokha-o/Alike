          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a completare l'acquisto. Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je aankoop niet voltooien. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało nam się dokończyć zakupu. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın almanı tamamlayamadık. Bağlantını denetleyip yeniden dene."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成你的購買。請檢查網路連線後再試一次。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام عملية الشراء. تحقق من اتصالك وحاول مرة أخرى."
          }
        }
      }
    },
    "purchases.subscriptionPaywall.weCouldntRestorePurchasesCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't restore your purchases. Check your connection and try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити покупки. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
