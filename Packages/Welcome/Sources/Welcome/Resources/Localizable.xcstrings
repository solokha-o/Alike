    "welcome.main.reviewSimilarPhotosFreeUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review similar photos, free up storage, and stay in control of every deletion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте схожі фото, звільняйте пам’ять і контролюйте кожне видалення."
          }
        }
      }
    },
    "welcome.main.reviewSuggestionsFirstConfirmEvery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You review suggestions first and confirm every cleanup action yourself."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви спочатку переглядаєте рекомендації й самі підтверджуєте кожну дію очищення."
          }
        }
      }
    },
