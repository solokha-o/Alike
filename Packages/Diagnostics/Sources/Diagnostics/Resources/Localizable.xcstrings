    "diagnostics.mail.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike created this crash report on my device. The attachment contains the crash stack trace, the app version, the iOS version and the device model. It contains no photos and no personal data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike створив цей звіт про збій на моєму пристрої. Вкладення містить стек викликів збою, версію застосунку, версію iOS і модель пристрою. У ньому немає фото чи особистих даних."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike creó este informe de fallo en mi dispositivo. El archivo adjunto contiene la traza del fallo, la versión de la app, la versión de iOS y el modelo del dispositivo. No contiene fotos ni datos personales."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike ha creado este informe de fallo en mi dispositivo. El archivo adjunto contiene la traza del fallo, la versión de la app, la versión de iOS y el modelo del dispositivo. No contiene fotos ni datos personales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike criou este relatório de falha no meu dispositivo. O anexo contém o rastreamento da falha, a versão do app, a versão do iOS e o modelo do dispositivo. Não contém fotos nem dados pessoais."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike hat diesen Absturzbericht auf meinem Gerät erstellt. Der Anhang enthält den Stacktrace des Absturzes, die App-Version, die iOS-Version und das Gerätemodell. Er enthält keine Fotos und keine persönlichen Daten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike a créé ce rapport de plantage sur mon appareil. La pièce jointe contient la trace du plantage, la version de l’app, la version d’iOS et le modèle de l’appareil. Elle ne contient ni photo ni donnée personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike ha creato questo report di arresto anomalo sul mio dispositivo. L’allegato contiene lo stack trace dell’arresto, la versione dell’app, la versione di iOS e il modello del dispositivo. Non contiene foto né dati personali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike heeft dit crashrapport op mijn apparaat gemaakt. De bijlage bevat de stacktrace van de crash, de appversie, de iOS-versie en het apparaatmodel. Er staan geen foto’s of persoonlijke gegevens in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike utworzył ten raport o awarii na moim urządzeniu. Załącznik zawiera ślad stosu awarii, wersję aplikacji, wersję iOS i model urządzenia. Nie zawiera zdjęć ani danych osobowych."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike bu çökme raporunu cihazımda oluşturdu. Ek; çökmenin yığın izini, uygulama sürümünü, iOS sürümünü ve cihaz modelini içerir. Fotoğraf veya kişisel veri içermez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike 在我的裝置上建立了這份當機報告。附件包含當機的堆疊追蹤、App 版本、iOS 版本和裝置型號，不含任何照片或個人資料。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشأ Alike تقرير التعطل هذا على جهازي. يحتوي المرفق على تتبّع مكدّس التعطل وإصدار التطبيق وإصدار iOS وطراز الجهاز. ولا يحتوي على أي صور أو بيانات شخصية."
          }
        }
      }
    },
    "diagnostics.prompt.shareFallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Mail account is set up, so the report goes through the share sheet. Pick a mail app there and send it to:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошту не налаштовано, тому звіт передається через аркуш надсилання. Оберіть там поштовий застосунок і надішліть його на адресу:"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta de Mail configurada, así que el informe se envía por la hoja para compartir. Elige ahí una app de correo y mándalo a:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta de Mail configurada, así que el informe se envía por la hoja para compartir. Elige ahí una app de correo y mándalo a:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há uma conta do Mail configurada, então o relatório passa pela folha de compartilhamento. Escolha um app de e-mail ali e envie para:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein Mail-Account eingerichtet, daher läuft der Bericht über das Teilen-Menü. Wähle dort eine Mail-App und sende ihn an:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte Mail n’est configuré : le rapport passe donc par la feuille de partage. Choisissez-y une app de messagerie et envoyez-le à :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account Mail è configurato, quindi il report passa dal pannello di condivisione. Scegli lì un’app di posta e invialo a:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen Mail-account ingesteld, dus het rapport gaat via het deelvenster. Kies daar een mailapp en stuur het naar:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie skonfigurowano konta Mail, więc raport przechodzi przez arkusz udostępniania. Wybierz tam aplikację pocztową i wyślij go na adres:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail hesabı ayarlanmadığı için rapor paylaşım sayfasından gidiyor. Orada bir e-posta uygulaması seçip şu adrese gönder:"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置尚未設定「郵件」帳號，因此報告會透過分享選單傳送。請在其中選擇郵件 App，並寄到："
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إعداد حساب بريد، لذا يمر التقرير عبر ورقة المشاركة. اختر تطبيق بريد هناك وأرسله إلى:"
          }
        }
      }
    },
