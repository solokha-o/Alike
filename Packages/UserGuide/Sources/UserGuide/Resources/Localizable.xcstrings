    "userGuide.freeAndPro.free.review.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open every group, compare photos, change the Best Shot, and mark groups as reviewed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривайте будь-яку групу, порівнюйте фото, змінюйте найкращий кадр і позначайте групи переглянутими."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos los grupos, compara fotos, cambia la mejor toma y marca grupos como revisados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos los grupos, compara fotos, cambia la mejor toma y marca grupos como revisados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra todos os grupos, compare fotos, mude a melhor foto e marque grupos como revisados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne jede Gruppe, vergleiche Fotos, ändere die beste Aufnahme und markiere Gruppen als geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez chaque groupe, comparez les photos, changez la meilleure photo et marquez les groupes comme examinés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri ogni gruppo, confronta le foto, cambia lo scatto migliore e segna i gruppi come controllati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open elke groep, vergelijk foto's, wijzig de beste opname en markeer groepen als bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieraj każdą grupę, porównuj zdjęcia, zmieniaj najlepsze ujęcie i oznaczaj grupy jako przejrzane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her grubu aç, fotoğrafları karşılaştır, En İyi Kare'yi değiştir ve grupları gözden geçirildi olarak işaretle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開每個群組、比較照片、更換最佳照片，並將群組標示為已檢視。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح كل مجموعة، وقارن بين الصور، وغيّر أفضل لقطة، وضع علامة على المجموعات بأنها روجعت."
          }
        }
      }
    },
