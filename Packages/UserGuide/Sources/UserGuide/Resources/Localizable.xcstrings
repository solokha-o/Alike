    "userGuide.comparingPhotos.selection.menu.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the ••• menu: select everything but the keeper in one go, or clear the whole selection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У меню ••• : вибрати все, крім кадру, який лишається, або зняти весь вибір."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú •••: selecciona todo menos la que se conserva, o quita toda la selección."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú •••: selecciona todo menos la que se conserva, o quita toda la selección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No menu •••: selecione tudo menos a que fica, ou limpe a seleção inteira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im •••-Menü: alles außer der besten Aufnahme auf einmal auswählen oder die ganze Auswahl aufheben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le menu ••• : sélectionnez tout sauf celle qui reste, ou effacez toute la sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel menu •••: seleziona tutto tranne la foto da conservare in un colpo solo, oppure azzera l'intera selezione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het •••-menu: selecteer in één keer alles behalve de bewaarde foto, of wis de hele selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W menu •••: zaznacz jednym ruchem wszystko oprócz zachowanego zdjęcia albo wyczyść cały wybór."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "••• menüsünde: saklanan kare hariç her şeyi tek seferde seç ya da tüm seçimi temizle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ••• 選單中：一次選取除保留照片外的全部，或清除整組選取。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من قائمة ••• : حدد كل شيء ما عدا اللقطة المحتفظ بها دفعة واحدة، أو امسح التحديد بالكامل."
          }
        }
      }
    },
    "userGuide.comparingPhotos.selection.menu.title": {
