          }
        }
      }
    },
    "userGuide.scanning.run.cache.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike remembers what it learned about each photo and only re-analyses what actually changed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike запам'ятовує результати для кожного фото й повторно аналізує лише те, що справді змінилося."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recuerda lo que aprendió de cada foto y solo vuelve a analizar lo que realmente cambió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike recuerda lo que aprendió de cada foto y solo vuelve a analizar lo que realmente cambió."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike guarda o que aprendeu sobre cada foto e só reanalisa o que de fato mudou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike merkt sich, was es über jedes Foto gelernt hat, und analysiert nur neu, was sich wirklich geändert hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike retient ce qu’il a appris de chaque photo et ne réanalyse que ce qui a réellement changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ricorda quello che ha imparato su ogni foto e rianalizza solo ciò che è effettivamente cambiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike onthoudt wat het over elke foto heeft geleerd en analyseert alleen opnieuw wat echt is veranderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike pamięta, czego dowiedział się o każdym zdjęciu, i ponownie analizuje tylko to, co faktycznie się zmieniło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike her fotoğraf hakkında öğrendiklerini hatırlar ve yalnızca gerçekten değişeni yeniden analiz eder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 會記住它對每張照片的分析結果，只重新分析真正有變動的部分。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتذكر Alike ما تعلّمه عن كل صورة ولا يعيد تحليل سوى ما تغيّر فعلًا."
          }
        }
      }
    },
