    "userGuide.deletingSafely.history.impact.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your running totals: space reclaimed, photos moved, and cleanup sessions completed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші загальні підсумки: звільнене місце, переміщені фото та завершені сеанси очищення."
          }
        },
        "es-419": {
