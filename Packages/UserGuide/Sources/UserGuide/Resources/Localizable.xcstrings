    "userGuide.gettingStarted.scope.screenshots.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen captures are kept out of similarity groups and collected in their own category."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки екрана не потрапляють до груп схожих фото, а збираються в окрему категорію."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla quedan fuera de los grupos de similitud y se reúnen en su propia categoría."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla quedan fuera de los grupos de similitud y se reúnen en su propia categoría."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela ficam fora dos grupos de semelhança e são reunidas na própria categoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos bleiben aus den Ähnlichkeitsgruppen heraus und landen in einer eigenen Kategorie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran restent hors des groupes de similarité et sont réunies dans leur propre catégorie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini dello schermo restano fuori dai gruppi di somiglianza e vengono raccolte in una categoria a parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermopnamen blijven buiten de gelijkenisgroepen en worden in een eigen categorie verzameld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu są trzymane poza grupami podobieństwa i zbierane we własnej kategorii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri benzerlik gruplarının dışında tutulur ve kendi kategorisinde toplanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
