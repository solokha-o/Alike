    "userGuide.comparingPhotos.bestShot.auto.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites come first, then the highest resolution, then the most recent shot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу обрані, потім найвища роздільна здатність, далі — найновіший знімок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van las favoritas, luego la mayor resolución y después la toma más reciente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van las favoritas, luego la mayor resolución y después la toma más reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As favoritas vêm primeiro, depois a maior resolução e então a foto mais recente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten kommen zuerst, dann die höchste Auflösung, dann die neueste Aufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris d’abord, puis la plus haute résolution, puis le cliché le plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima i preferiti, poi la risoluzione più alta, poi lo scatto più recente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten eerst, dan de hoogste resolutie, dan de meest recente opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw ulubione, potem najwyższa rozdzielczość, a potem najnowsze ujęcie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce favoriler, sonra en yüksek çözünürlük, sonra en yeni kare."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最愛優先，其次是解析度最高者，再其次是最新拍攝的。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي المفضلة أولًا، ثم الأعلى دقة، ثم أحدث لقطة."
          }
        }
      }
    },
