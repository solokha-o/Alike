    "userGuide.smartCategories.blurDetection.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short list is intentional: a missed blurry photo costs you nothing, a wrongly flagged keepsake does."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий список — це задум: пропущене розмите фото нічого не коштує, а помилково позначений спогад — так."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista corta es intencional: una foto borrosa que se escapa no te cuesta nada; un recuerdo marcado por error, sí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista corta es intencional: una foto borrosa que se escapa no te cuesta nada; un recuerdo marcado por error, sí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista curta é proposital: uma foto tremida que passa não custa nada; uma lembrança sinalizada por engano, sim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kurze Liste ist Absicht: ein übersehenes unscharfes Foto kostet dich nichts, eine fälschlich markierte Erinnerung schon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La brièveté de la liste est volontaire : une photo floue oubliée ne vous coûte rien, un souvenir signalé à tort, si."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elenco corto è voluto: una foto sfocata non rilevata non costa nulla, un ricordo segnalato per errore sì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte lijst is bewust: een gemiste wazige foto kost je niets, een ten onrechte gemarkeerde herinnering wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótka lista jest celowa: przeoczone rozmyte zdjęcie nic nie kosztuje, a błędnie oznaczona pamiątka — owszem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa liste bilinçli bir tercih: gözden kaçan bulanık bir fotoğrafın maliyeti yok, yanlışlıkla işaretlenen bir anının var."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單短是刻意的：漏掉一張模糊照片沒有損失，誤標一段回憶才有。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِصَر القائمة مقصود: تفويت صورة ضبابية لا يكلفك شيئًا، أما وضع علامة خاطئة على ذكرى عزيزة فيكلفك."
          }
        }
      }
    },
    "userGuide.smartCategories.blurDetection.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the blurred list is short"
          }
        },
        "uk": {
          "stringUnit": {
