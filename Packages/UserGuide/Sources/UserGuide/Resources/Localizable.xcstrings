    "userGuide.settingsAndReminders.subscription.status.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card at the top of Settings shows whether Alike Pro is active and when it renews."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка вгорі «Налаштувань» показує, чи активна Alike Pro і коли вона поновлюється."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de arriba en Configuración muestra si Alike Pro está activo y cuándo se renueva."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de arriba en Ajustes muestra si Alike Pro está activo y cuándo se renueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão no topo dos Ajustes mostra se o Alike Pro está ativo e quando ele renova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte oben in den Einstellungen zeigt, ob Alike Pro aktiv ist und wann es sich verlängert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche en haut des Réglages indique si Alike Pro est actif et quand il se renouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda in cima a Impostazioni mostra se Alike Pro è attivo e quando si rinnova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart boven aan Instellingen laat zien of Alike Pro actief is en wanneer het wordt verlengd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta u góry Ustawień pokazuje, czy Alike Pro jest aktywne i kiedy się odnawia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ın en üstündeki kart, Alike Pro'nun etkin olup olmadığını ve ne zaman yenileneceğini gösterir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」最上方的卡片會顯示 Alike Pro 是否啟用，以及何時續訂。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض البطاقة في أعلى الإعدادات ما إذا كان Alike Pro مُفعَّلًا ومتى يتجدد."
          }
        }
      }
    },
