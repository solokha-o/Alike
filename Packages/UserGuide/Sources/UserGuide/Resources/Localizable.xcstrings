          }
        }
      }
    },
    "userGuide.scanning.rescan.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refresh that runs by itself after you move photos does not count against your free scans."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення, яке запускається саме після переміщення фото, не витрачає безкоштовні сканування."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actualización que se ejecuta sola después de mover fotos no cuenta para tus análisis gratuitos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actualización que se ejecuta sola después de mover fotos no cuenta para tus análisis gratuitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atualização que roda sozinha depois de você mover fotos não conta nas suas análises gratuitas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aktualisierung, die nach dem Bewegen von Fotos von selbst läuft, zählt nicht auf deine kostenlosen Scans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une actualisation qui se lance d’elle-même après un déplacement de photos n’est pas décomptée de vos analyses gratuites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aggiornamento che parte da solo dopo aver spostato delle foto non incide sulle scansioni gratuite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verversing die vanzelf start nadat je foto's hebt verplaatst, telt niet mee voor je gratis scans."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżenie, które uruchamia się samo po przeniesieniu zdjęć, nie liczy się do darmowych skanowań."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları taşıdıktan sonra kendiliğinden çalışan bir yenileme, ücretsiz tarama hakkından düşmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動照片後自動執行的更新，不會計入你的免費掃描次數。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديث الذي يجري تلقائيًا بعد نقلك للصور لا يُحتسب من فحوصاتك المجانية."
          }
        }
      }
    },
    "userGuide.scanning.rescan.header": {
      "extractionState": "manual",
      "localizations": {
