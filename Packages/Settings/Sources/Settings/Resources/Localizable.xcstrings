    "settings.main.higherSensitivityFindsMoreSimilar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher sensitivity finds more similar photos but may include less alike images"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища чутливість знаходить більше схожих фото, але може включати менш подібні"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilidad más alta encuentra más fotos similares, pero puede incluir imágenes menos parecidas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilidad más alta encuentra más fotos similares, pero puede incluir imágenes menos parecidas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sensibilidade maior encontra mais fotos semelhantes, mas pode incluir imagens menos parecidas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine höhere Empfindlichkeit findet mehr ähnliche Fotos, kann aber auch weniger ähnliche Bilder einschließen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sensibilité plus élevée trouve davantage de photos similaires, mais peut inclure des images moins ressemblantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilità più alta trova più foto simili, ma può includere immagini meno somiglianti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hogere gevoeligheid vindt meer vergelijkbare foto's, maar kan ook minder gelijkende beelden bevatten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa czułość znajduje więcej podobnych zdjęć, ale może obejmować mniej podobne obrazy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek duyarlılık daha çok benzer fotoğraf bulur ama daha az benzeyen görüntüleri de içerebilir"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感度越高，找到的相似照片越多，但也可能納入相似度較低的影像"
          }
        }
      }
    },
