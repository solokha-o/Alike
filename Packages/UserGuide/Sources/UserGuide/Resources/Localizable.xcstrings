    "userGuide.privacy.deleteData.replay.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike shows its introduction again afterwards, without asking for photo access a second time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього Alike знову покаже вступ, не запитуючи доступ до фото вдруге."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, Alike vuelve a mostrar su introducción sin pedir acceso a las fotos otra vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, Alike vuelve a mostrar su introducción sin pedir acceso a las fotos otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois disso o Alike mostra a introdução novamente, sem pedir acesso às fotos outra vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike zeigt danach seine Einführung erneut, ohne noch einmal nach Fotozugriff zu fragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike réaffiche ensuite son introduction, sans redemander l’accès aux photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo, Alike mostra di nuovo la sua introduzione, senza chiedere una seconda volta l'accesso alle foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike toont daarna opnieuw de introductie, zonder een tweede keer om fototoegang te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike pokaże potem ponownie wprowadzenie, nie prosząc drugi raz o dostęp do zdjęć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike sonrasında tanıtımını yeniden gösterir, fotoğraf erişimini ikinci kez istemez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後 Alike 會再次顯示介紹流程，但不會再要求一次照片取用權。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Alike مقدمته من جديد بعد ذلك، دون أن يطلب إذن الوصول إلى الصور مرة ثانية."
          }
        }
      }
    },
