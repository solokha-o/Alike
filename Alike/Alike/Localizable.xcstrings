    "Couldn't Delete Alike Data": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't Delete Alike Data"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося видалити дані Alike"}}}},
