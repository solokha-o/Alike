    "userGuide.comparingPhotos.review.toggle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the seal button in the navigation bar when you're done with a group. Tap it again to reopen it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся кнопкою з печаткою у панелі навігації, коли завершите роботу з групою. Торкніться ще раз, щоб відкрити її знову."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón del sello en la barra de navegación cuando termines con un grupo. Tócalo de nuevo para volver a abrirlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón del sello en la barra de navegación cuando termines con un grupo. Tócalo de nuevo para volver a abrirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão de selo na barra de navegação quando terminar com um grupo. Toque nele de novo para reabrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Siegel-Button in der Navigationsleiste, wenn du mit einer Gruppe fertig bist. Noch einmal tippen öffnet sie wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton en forme de sceau dans la barre de navigation quand vous en avez fini avec un groupe. Touchez-le à nouveau pour le rouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il pulsante con il sigillo nella barra di navigazione quando hai finito con un gruppo. Toccalo di nuovo per riaprirlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de zegelknop in de navigatiebalk als je klaar bent met een groep. Tik er nogmaals op om de groep te heropenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy skończysz z grupą, użyj przycisku z pieczęcią na pasku nawigacji. Stuknij ponownie, aby otworzyć ją na nowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir grupla işin bittiğinde gezinme çubuğundaki mühür düğmesini kullan. Yeniden açmak için tekrar dokun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一個群組後，請使用導覽列上的印章按鈕。再點一下即可重新打開。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زر الختم في شريط التنقل عند انتهائك من مجموعة. انقره مرة أخرى لإعادة فتحها."
          }
        }
      }
    },
