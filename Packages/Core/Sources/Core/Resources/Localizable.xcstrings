    "core.cleanupCategory.likelyLowQualityPhotosBased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely low-quality photos based on on-device analysis. Review before deleting."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імовірно неякісні фото за результатами аналізу на пристрої. Перегляньте їх перед видаленням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos probablemente de baja calidad según el análisis en el dispositivo. Revísalas antes de eliminarlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos probablemente de baja calidad según el análisis en el dispositivo. Revísalas antes de eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos provavelmente de baixa qualidade, segundo a análise no dispositivo. Revise antes de apagar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Analyse auf dem Gerät wahrscheinlich Fotos in geringer Qualität. Vor dem Löschen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos probablement de faible qualité d’après l’analyse sur l’appareil. À examiner avant suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto probabilmente di bassa qualità in base all'analisi sul dispositivo. Controllale prima di eliminarle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschijnlijk foto's van lage kwaliteit, op basis van analyse op het apparaat. Bekijk ze voordat je ze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia prawdopodobnie niskiej jakości według analizy na urządzeniu. Przejrzyj je przed usunięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıttaki analize göre büyük olasılıkla düşük kaliteli fotoğraflar. Silmeden önce gözden geçir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據裝置端分析，這些照片品質可能偏低。請先檢視再刪除。"
          }
        }
      }
    },
