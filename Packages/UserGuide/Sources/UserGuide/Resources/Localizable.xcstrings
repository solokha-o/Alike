    "userGuide.smartCategories.categories.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both categories are part of Alike Pro. Tapping a locked one shows what it found first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві категорії входять до Alike Pro. Торкнувшись заблокованої, ви спершу побачите, що вона знайшла."
          }
        }
      }
    },
