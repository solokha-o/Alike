  "strings": {
    "Alike data deleted": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alike data deleted"}},"uk":{"stringUnit":{"state":"translated","value":"Дані Alike видалено"}}}},
