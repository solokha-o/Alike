    "userGuide.smartCategories.categories.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both categories are part of Alike Pro. Tapping a locked one shows what it found first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві категорії входять до Alike Pro. Торкнувшись заблокованої, ви спершу побачите, що вона знайшла."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos categorías son parte de Alike Pro. Al tocar una bloqueada, primero se ve lo que encontró."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos categorías son parte de Alike Pro. Al tocar una bloqueada, primero se ve lo que encontró."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas categorias fazem parte do Alike Pro. Ao tocar em uma bloqueada, você vê primeiro o que ela encontrou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Kategorien gehören zu Alike Pro. Tippst du auf eine gesperrte, siehst du zuerst, was sie gefunden hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux catégories font partie d’Alike Pro. Toucher une catégorie verrouillée montre d’abord ce qu’elle a trouvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le categorie fanno parte di Alike Pro. Toccandone una bloccata vedi prima cosa ha trovato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide categorieën horen bij Alike Pro. Als je op een vergrendelde tikt, zie je eerst wat die heeft gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie kategorie należą do Alike Pro. Stuknięcie zablokowanej najpierw pokaże, co znalazła."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki kategori de Alike Pro'ya dahildir. Kilitli olana dokunduğunda önce ne bulduğunu görürsün."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這兩個類別皆屬於 Alike Pro。點一下已鎖定的類別，會先顯示它找到了什麼。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلتا الفئتين جزء من Alike Pro. والنقر على فئة مقفلة يعرض أولًا ما عثرت عليه."
          }
