          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте"
          }
        }
      }
    },
    "userGuide.gettingStarted.loop.scan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike looks through your photo library on the Scanner tab and groups photos that look alike."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вкладці «Сканер» Alike переглядає вашу медіатеку та групує схожі фото."
