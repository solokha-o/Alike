    "userGuide.privacy.deleteData.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find it in Settings, under Data & Privacy. It can't be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдете в «Налаштуваннях», у розділі «Дані та приватність». Скасувати неможливо."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo encuentras en Configuración, en Datos y privacidad. No se puede deshacer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo encuentras en Ajustes, en Datos y privacidad. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você encontra isso nos Ajustes, em Dados e privacidade. Não dá para desfazer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du findest es in den Einstellungen unter „Daten & Datenschutz“. Es lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous le trouverez dans Réglages, sous Données et confidentialité. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trovi in Impostazioni, sotto «Dati e privacy». Non è reversibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vindt het in Instellingen, onder Gegevens en privacy. Het kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdziesz to w Ustawieniach, w sekcji Dane i prywatność. Nie można tego cofnąć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'da, Veriler ve Gizlilik altında bulabilirsin. Geri alınamaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」的「資料與隱私權」中可以找到。此操作無法還原。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجده في الإعدادات، ضمن «البيانات والخصوصية». ولا يمكن التراجع عنه."
          }
        }
      }
    },
