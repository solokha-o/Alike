    "userGuide.cleanupQueue.sections.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review appears only when there is something new or changed to look at."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Потребує перегляду» з'являється лише тоді, коли є щось нове або змінене."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "«Necesita revisión» aparece solo cuando hay algo nuevo o modificado que mirar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Necesita revisión» aparece solo cuando hay algo nuevo o modificado que mirar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Precisa de revisão” aparece apenas quando há algo novo ou alterado para ver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Prüfung nötig“ erscheint nur, wenn es etwas Neues oder Geändertes zu sehen gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À examiner » n’apparaît que lorsqu’il y a du nouveau ou du modifié à voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Da controllare» compare solo quando c'è qualcosa di nuovo o modificato da guardare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Moet worden bekeken' verschijnt alleen als er iets nieuws of gewijzigds te bekijken is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wymaga przeglądu” pojawia się tylko wtedy, gdy jest coś nowego lub zmienionego do obejrzenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözden geçirilmeli yalnızca bakılacak yeni ya da değişmiş bir şey olduğunda görünür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在有新增或變更的項目時，才會出現「待檢視」。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر «بحاجة إلى مراجعة» إلا عندما يكون هناك شيء جديد أو متغيّر لتنظر فيه."
          }
        }
      }
    },
