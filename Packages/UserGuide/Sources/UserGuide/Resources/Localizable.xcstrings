    "userGuide.freeAndPro.pro.filters.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter Cleanup by review status, minimum group size, or favourites only."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтруйте «Очищення» за станом перегляду, мінімальним розміром групи або лише обраними."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra la limpieza por estado de revisión, tamaño mínimo del grupo o solo favoritas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra la limpieza por estado de revisión, tamaño mínimo del grupo o solo favoritas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre a limpeza por status de revisão, tamanho mínimo do grupo ou apenas favoritas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtere das Aufräumen nach Prüfstatus, Mindestgröße der Gruppe oder nur Favoriten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrez le nettoyage par statut d’examen, taille minimale de groupe ou favoris uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra Pulizia per stato di controllo, dimensione minima del gruppo o solo preferiti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter Opruimen op beoordelingsstatus, minimale groepsgrootte of alleen favorieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruj Porządki według stanu przeglądu, minimalnego rozmiaru grupy lub tylko ulubionych."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlik'i gözden geçirme durumuna, en küçük grup boyutuna ya da yalnızca favorilere göre filtrele."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依檢視狀態、群組最小數量或僅限最愛來篩選「清理」。"
          }
        },
        "ar": {
