    "userGuide.a11y.step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$d of %2$d: %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крок %1$d із %2$d: %3$@"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %1$d de %2$d: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %1$d de %2$d: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo %1$d de %2$d: %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt %1$d von %2$d: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %1$d sur %2$d : %3$@"
