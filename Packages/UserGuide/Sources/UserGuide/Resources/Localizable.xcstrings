          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à utiliser l’app pendant ce temps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a usare l'app mentre lavora"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf de app gebruiken terwijl hij werkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystaj z aplikacji, gdy pracuje"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışırken uygulamayı kullanmayı sürdür"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
