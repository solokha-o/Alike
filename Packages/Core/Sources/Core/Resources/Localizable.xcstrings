    "core.cleanupCategory.alertTitleBlurredPhotos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Move %1$lld Selected Blurred Photo to Recently Deleted?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Move %1$lld Selected Blurred Photos to Recently Deleted?"
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Перемістити %1$lld вибране розмите фото до «Недавно видалені»?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Перемістити %1$lld вибрані розмиті фото до «Недавно видалені»?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
