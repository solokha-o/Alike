    "guide.freeAndPro.free.review.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Full review of similar photos"}},"uk":{"stringUnit":{"state":"translated","value":"Повний перегляд схожих фото"}}}},
    "guide.freeAndPro.free.scans.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Three scans each calendar month, with the counter resetting at the start of the next one."}},"uk":{"stringUnit":{"state":"translated","value":"Три сканування щокалендарного місяця; лічильник оновлюється на початку наступного."}}}},
    "guide.freeAndPro.free.scans.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Three scans a month"}},"uk":{"stringUnit":{"state":"translated","value":"Три сканування на місяць"}}}},
    "guide.freeAndPro.free.singlePhoto.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can move photos to Recently Deleted one by one."}},"uk":{"stringUnit":{"state":"translated","value":"Ви можете переміщувати фото до «Нещодавно видалених» по одному."}}}},
