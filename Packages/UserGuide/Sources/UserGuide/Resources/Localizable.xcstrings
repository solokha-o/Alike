    "userGuide.deletingSafely.flow.recentlyDeleted.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos land in the Photos app's Recently Deleted album, where you can restore any of them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото потрапляють до альбому «Нещодавно видалені» у застосунку «Фото», звідки їх можна відновити."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos llegan al álbum Eliminados recientemente de la app Fotos, donde puedes recuperar cualquiera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos llegan al álbum Eliminados recientemente de la app Fotos, donde puedes recuperar cualquiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos vão para o álbum Apagados recentemente do app Fotos, de onde você pode recuperar qualquer uma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos landen im Album „Zuletzt gelöscht“ der Fotos-App, wo du jedes wiederherstellen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos arrivent dans l’album Supprimés récemment de l’app Photos, d’où vous pouvez toutes les restaurer."
          }
        }
      }
    },
    "userGuide.deletingSafely.flow.recentlyDeleted.title": {
