    "core.cleanupCategory.selectedPhotoWillBeRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photo will be removed from your library and other devices using iCloud Photos, then remain in Recently Deleted for up to 30 days. Storage may not be freed until it is permanently deleted. Estimated reclaimable space: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибране фото буде видалено з вашої фототеки та інших пристроїв, які використовують Фото iCloud, а потім залишатиметься в альбомі «Недавно видалені» до 30 днів. Місце може не звільнитися, доки фото не буде видалено остаточно. Орієнтовно можна звільнити: %@."
          }
        }
      }
    },
    "core.cleanupCategory.selectedPhotosWillBeRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photos will be removed from your library and other devices using iCloud Photos, then remain in Recently Deleted for up to 30 days. Storage may not be freed until they are permanently deleted. Estimated reclaimable space: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані фото буде видалено з вашої фототеки та інших пристроїв, які використовують Фото iCloud, а потім вони залишатимуться в альбомі «Недавно видалені» до 30 днів. Місце може не звільнитися, доки їх не буде видалено остаточно. Орієнтовно можна звільнити: %@."
          }
        }
      }
    },
    "core.cleanupCategory.selectedScreenshotWillBeRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected screenshot will be removed from your library and other devices using iCloud Photos, then remain in Recently Deleted for up to 30 days. Storage may not be freed until it is permanently deleted. Estimated reclaimable space: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний знімок екрана буде видалено з вашої фототеки та інших пристроїв, які використовують Фото iCloud, а потім він залишатиметься в альбомі «Недавно видалені» до 30 днів. Місце може не звільнитися, доки знімок не буде видалено остаточно. Орієнтовно можна звільнити: %@."
          }
        }
      }
    },
    "core.cleanupCategory.selectedScreenshotsWillBeRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected screenshots will be removed from your library and other devices using iCloud Photos, then remain in Recently Deleted for up to 30 days. Storage may not be freed until they are permanently deleted. Estimated reclaimable space: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані знімки екрана буде видалено з вашої фототеки та інших пристроїв, які використовують Фото iCloud, а потім вони залишатимуться в альбомі «Недавно видалені» до 30 днів. Місце може не звільнитися, доки знімки не буде видалено остаточно. Орієнтовно можна звільнити: %@."
          }
        }
      }
    },
    "core.cleanupCategory.tryRescanningAfterLibraryUpdates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try rescanning after your library updates."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте пересканувати після оновлення фототеки."
          }
        }
      }
    },
    "core.cleanupCategory.unlockBlurredPhotoCleanupReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock blurred photo cleanup to review likely low-quality shots before deleting them with the same safe confirmation flow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте очищення розмитих фото, щоб переглядати й видаляти ймовірно неякісні кадри з безпечним підтвердженням."
          }
        }
      }
    },
    "core.cleanupCategory.unlockScreenshotCleanupReviewDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock screenshot cleanup to review and delete screenshots with the same safe confirmation flow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте очищення знімків екрана, щоб переглядати й видаляти їх із безпечним підтвердженням."
          }
        }
      }
    }
