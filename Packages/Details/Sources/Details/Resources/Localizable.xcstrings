    "details.common.alikeNeedsPhotoLibraryAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike needs photo library access before it can delete photos. Open Settings to continue."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike потрібен доступ до фототеки, щоб видаляти фото. Відкрийте Налаштування, щоб продовжити."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso a la fototeca antes de poder eliminar fotos. Abre Configuración para continuar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike necesita acceso a la fototeca antes de poder eliminar fotos. Abre Ajustes para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike precisa de acesso à fototeca antes de apagar fotos. Abra os Ajustes para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike benötigt Zugriff auf die Mediathek, bevor Fotos gelöscht werden können. Öffne die Einstellungen, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike a besoin d’accéder à la photothèque avant de pouvoir supprimer des photos. Ouvrez Réglages pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ha bisogno dell'accesso alla libreria foto per poter eliminare le foto. Apri Impostazioni per continuare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike heeft toegang tot je fotobibliotheek nodig om foto's te kunnen verwijderen. Open Instellingen om verder te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
