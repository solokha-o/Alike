          "stringUnit": {
            "state": "translated",
            "value": "Puedes gestionar o cancelar la suscripción cuando quieras en el App Store. Los precios se muestran antes de suscribirte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes gestionar o cancelar la suscripción cuando quieras en el App Store. Los precios se muestran antes de suscribirte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie ou cancele a assinatura quando quiser na App Store. Os preços aparecem antes de você assinar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ein Abo jederzeit im App Store verwalten oder kündigen. Die Preise siehst du, bevor du abschließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez ou résiliez un abonnement à tout moment dans l’App Store. Les prix sont affichés avant l’abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci o annulla l'abbonamento quando vuoi nell'App Store. I prezzi vengono mostrati prima della sottoscrizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer of zeg je abonnement altijd op in de App Store. Prijzen worden getoond voordat je je abonneert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcją możesz zarządzać lub anulować ją w dowolnym momencie w App Store. Ceny są pokazywane przed subskrypcją."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğini istediğin zaman App Store'dan yönetebilir ya da iptal edebilirsin. Fiyatlar abone olmadan önce gösterilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在 App Store 管理或取消訂閱項目。訂閱前會先顯示價格。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إدارة الاشتراك أو إلغاؤه في أي وقت من App Store. وتُعرض الأسعار قبل أن تشترك."
          }
        }
      }
    },
