    "widgetsupport.widget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار المساحة التي يمكنك استعادتها، بنظرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einen Blick sehen, wie viel Speicher frei werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much space you can reclaim, at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto espacio puedes recuperar, de un vistazo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto espacio puedes recuperar, de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace que vous pouvez récupérer, en un coup d’œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto spazio puoi recuperare, in un colpo d’occhio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel ruimte je kunt vrijmaken, in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile miejsca możesz odzyskać — na pierwszy rzut oka."
          }
        },
        "pt-BR": {
