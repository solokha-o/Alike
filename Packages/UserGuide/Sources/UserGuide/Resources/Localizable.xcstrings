    "userGuide.smartCategories.workflow.inspect.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold for Show Info or Open Original, and adjust columns from the toolbar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте для «Показати інформацію» чи «Відкрити оригінал», а колонки змініть на панелі інструментів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para «Mostrar información» o «Abrir original», y ajusta las columnas desde la barra de herramientas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para «Mostrar información» o «Abrir original», y ajusta las columnas desde la barra de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado para “Mostrar informações” ou “Abrir original”, e ajuste as colunas pela barra de ferramentas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten für „Infos einblenden“ oder „Original öffnen“, und die Spalten über die Symbolleiste anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour « Afficher les infos » ou « Ouvrir l’original », et ajustez les colonnes depuis la barre d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per «Mostra info» o «Apri originale» e regola le colonne dalla barra strumenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt voor Toon gegevens of Open origineel, en pas de kolommen aan via de knoppenbalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj, aby użyć Pokaż informacje lub Otwórz oryginał, a kolumny zmienisz na pasku narzędzi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgileri Göster ya da Özgün Dosyayı Aç için uzun bas, sütunları araç çubuğundan ayarla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按可使用「顯示資訊」或「打開原始檔」，並可從工具列調整欄數。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا لعرض المعلومات أو فتح الأصل، واضبط الأعمدة من شريط الأدوات."
          }
        }
      }
    },
