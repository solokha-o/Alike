    "userGuide.gettingStarted.scope.blurred.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos that look out of focus, gathered for you to check before removing."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, що виглядають нерізкими, зібрані для перевірки перед видаленням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, reunidas para que las revises antes de eliminarlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecen desenfocadas, reunidas para que las revises antes de eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos que parecem fora de foco, reunidas para você conferir antes de remover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die unscharf wirken – gesammelt, damit du sie vor dem Entfernen prüfst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des photos qui semblent floues, rassemblées pour que vous les vérifiiez avant de les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto che sembrano fuori fuoco, raccolte perché tu le controlli prima di rimuoverle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's die onscherp lijken, verzameld zodat jij ze kunt controleren voordat je ze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia, które wyglądają na nieostre, zebrane, abyś sprawdził je przed usunięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak dışı görünen fotoğraflar, kaldırmadan önce denetlemen için bir araya getirildi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看起來失焦的照片，集中起來讓你在移除前先確認。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور تبدو خارج نطاق التركيز، جُمعت لتتحقق منها قبل الإزالة."
          }
        }
      }
    },
