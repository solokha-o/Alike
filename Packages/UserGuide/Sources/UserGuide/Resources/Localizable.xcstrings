    "userGuide.settingsAndReminders.analysis.language.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike is available in English, Ukrainian, Spanish, Portuguese, German and French. The switch opens the iOS Settings page for the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike доступний англійською, українською, іспанською, португальською, німецькою та французькою. Перемикач відкриває сторінку застосунку в Налаштуваннях iOS."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike está disponible en inglés, ucraniano, español, portugués, alemán y francés. El selector abre la página de la app en Configuración de iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike está disponible en inglés, ucraniano, español, portugués, alemán y francés. El selector abre la página de la app en Ajustes de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike está disponível em inglês, ucraniano, espanhol, português, alemão e francês. O seletor abre a página do app nos Ajustes do iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike gibt es auf Englisch, Ukrainisch, Spanisch, Portugiesisch, Deutsch und Französisch. Der Schalter öffnet die iOS-Einstellungsseite der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike est disponible en anglais, ukrainien, espagnol, portugais, allemand et français. Le sélecteur ouvre la page de l’app dans les Réglages iOS."
          }
        }
      }
    },
