          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As favoritas ficam de fora"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten bleiben unangetastet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris sont épargnés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preferiti restano intatti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
