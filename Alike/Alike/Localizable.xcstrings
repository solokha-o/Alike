    "Move 1 Selected Screenshot to Recently Deleted?": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move 1 Selected Screenshot to Recently Deleted?"}},"uk":{"stringUnit":{"state":"translated","value":"Перемістити 1 вибраний знімок екрана до «Недавно видалені»?"}}}},
