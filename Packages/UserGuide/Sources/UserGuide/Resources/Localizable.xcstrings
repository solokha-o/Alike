          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photothèque a changé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è cambiata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek is gewijzigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka się zmieniła"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığın değişti"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的圖庫有變動"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت مكتبتك"
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitivity decides how alike two photos must be to land in the same group, so Alike asks to rescan after you change it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чутливість визначає, наскільки схожими мають бути фото для однієї групи, тому після зміни Alike пропонує пересканувати."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad decide cuánto deben parecerse dos fotos para caer en el mismo grupo, así que Alike pide analizar de nuevo cuando la cambias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad decide cuánto deben parecerse dos fotos para caer en el mismo grupo, así que Alike pide analizar de nuevo cuando la cambias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensibilidade decide o quanto duas fotos precisam se parecer para caírem no mesmo grupo, por isso o Alike pede uma nova análise depois que você a altera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfindlichkeit entscheidet, wie ähnlich sich zwei Fotos sein müssen, um in dieselbe Gruppe zu kommen – deshalb bittet Alike nach einer Änderung um einen neuen Scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilité détermine à quel point deux photos doivent se ressembler pour tomber dans le même groupe : Alike propose donc une nouvelle analyse après un changement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilità decide quanto due foto debbano somigliarsi per finire nello stesso gruppo, perciò Alike chiede una nuova scansione dopo che la cambi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevoeligheid bepaalt hoeveel twee foto's op elkaar moeten lijken om in dezelfde groep te belanden, daarom vraagt Alike om opnieuw te scannen nadat je die wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czułość decyduje o tym, jak bardzo dwa zdjęcia muszą być podobne, aby trafić do jednej grupy, dlatego po jej zmianie Alike prosi o ponowne skanowanie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyarlılık, iki fotoğrafın aynı gruba girmesi için ne kadar benzemesi gerektiğini belirler; bu yüzden değiştirdikten sonra Alike yeniden tarama ister."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感度決定兩張照片要多相似才會歸為同一組，因此更改後 Alike 會要求重新掃描。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد الحساسية مقدار التشابه المطلوب بين صورتين لتقعا في المجموعة نفسها، لذا يطلب Alike إعادة الفحص بعد تغييرها."
          }
        }
      }
    },
    "userGuide.scanning.rescan.sensitivity.title": {
