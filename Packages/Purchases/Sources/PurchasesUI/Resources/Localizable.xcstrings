        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
