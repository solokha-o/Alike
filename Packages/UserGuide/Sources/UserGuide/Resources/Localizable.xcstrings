    "userGuide.freeAndPro.free.scans.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three scans each calendar month, with the counter resetting at the start of the next one."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три сканування щокалендарного місяця; лічильник оновлюється на початку наступного."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres análisis por mes calendario; el contador se restablece al empezar el siguiente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres análisis por mes natural; el contador se restablece al empezar el siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três análises por mês, com o contador zerando no início do mês seguinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Scans pro Kalendermonat; der Zähler startet zu Beginn des nächsten Monats neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois analyses par mois civil, le compteur repartant au début du suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre scansioni per ogni mese di calendario, con il contatore che riparte all'inizio del mese successivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie scans per kalendermaand; de teller begint aan het begin van de volgende maand opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy skanowania w każdym miesiącu kalendarzowym; licznik zeruje się na początku kolejnego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her takvim ayında üç tarama; sayaç bir sonraki ayın başında sıfırlanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個日曆月三次掃描，計數會在下個月初重設。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة فحوصات في كل شهر ميلادي، ويُصفَّر العدّاد في بداية الشهر التالي."
          }
        }
      }
    },
