    "core.cleanupCategory.unlockBlurredPhotoCleanupReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock blurred photo cleanup to review likely low-quality shots before deleting them with the same safe confirmation flow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте очищення розмитих фото, щоб переглядати й видаляти ймовірно неякісні кадри з безпечним підтвердженням."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la limpieza de fotos borrosas para revisar las tomas probablemente de baja calidad antes de eliminarlas, con la misma confirmación segura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la limpieza de fotos borrosas para revisar las tomas probablemente de baja calidad antes de eliminarlas, con la misma confirmación segura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere a limpeza de fotos desfocadas para revisar as imagens provavelmente de baixa qualidade antes de apagá-las, com a mesma confirmação segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das Aufräumen unscharfer Fotos frei, um wahrscheinlich qualitativ schlechte Aufnahmen vor dem Löschen zu prüfen – mit derselben sicheren Bestätigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez le nettoyage des photos floues pour examiner les photos probablement de mauvaise qualité avant de les supprimer, avec la même confirmation sécurisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca la pulizia delle foto sfocate per controllare gli scatti probabilmente di bassa qualità prima di eliminarli, con la stessa conferma sicura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel het opruimen van wazige foto's om waarschijnlijk mislukte opnamen te bekijken voordat je ze verwijdert, met dezelfde veilige bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj porządki w rozmytych zdjęciach, aby przejrzeć prawdopodobnie nieudane ujęcia przed ich usunięciem — z tym samym bezpiecznym potwierdzeniem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulanık fotoğraf temizliğinin kilidini aç; düşük kaliteli olabilecek kareleri aynı güvenli onay akışıyla silmeden önce gözden geçir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖模糊照片清理，透過同樣安全的確認流程，在刪除前先檢視可能品質不佳的照片。"
          }
        }
      }
    },
    "core.cleanupCategory.unlockScreenshotCleanupReviewDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
