    "settings.main.notificationsTurnedOffAlikeEnable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Alike. Enable them in Settings to receive your weekly cleanup reminder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Alike вимкнено сповіщення. Увімкніть їх у Налаштуваннях, щоб отримувати щотижневе нагадування про очищення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Alike. Actívalas en Configuración para recibir tu recordatorio semanal de limpieza."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Alike. Actívalas en Ajustes para recibir tu recordatorio semanal de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Alike. Ative-as nos Ajustes para receber seu lembrete semanal de limpeza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Alike deaktiviert. Aktiviere sie in den Einstellungen, um deine wöchentliche Aufräum-Erinnerung zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
