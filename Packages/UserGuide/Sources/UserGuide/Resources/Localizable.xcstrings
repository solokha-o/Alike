            "value": "Quando ripetere la scansione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je opnieuw moet scannen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy skanować ponownie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman yeniden taramalı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
