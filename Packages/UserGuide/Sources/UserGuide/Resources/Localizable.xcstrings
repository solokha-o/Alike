    "userGuide.settingsAndReminders.reminder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reminder is off until you turn it on, and asks for notification permission the first time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування вимкнене, доки ви його не ввімкнете, і першого разу запитує дозвіл на сповіщення."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatorio está desactivado hasta que lo actives, y la primera vez pide permiso de notificaciones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatorio está desactivado hasta que lo actives, y la primera vez pide permiso de notificaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lembrete fica desativado até você ligá-lo, e pede permissão de notificações na primeira vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerung ist aus, bis du sie einschaltest, und fragt beim ersten Mal nach der Mitteilungserlaubnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rappel est désactivé tant que vous ne l’activez pas, et demande l’autorisation de notification la première fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il promemoria è disattivato finché non lo attivi e la prima volta chiede il permesso per le notifiche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herinnering staat uit tot je die inschakelt, en vraagt de eerste keer om toestemming voor berichtgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie jest wyłączone, dopóki go nie włączysz, i za pierwszym razem prosi o zgodę na powiadomienia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anımsatıcı sen açana kadar kapalıdır ve ilk seferde bildirim izni ister."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒預設為關閉，開啟後第一次會要求通知權限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكير معطَّل حتى تفعّله، ويطلب إذن الإشعارات في المرة الأولى."
          }
        }
      }
    },
