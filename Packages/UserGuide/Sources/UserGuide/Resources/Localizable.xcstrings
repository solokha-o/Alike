        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи, щодо яких ви ще не вирішили, і ті, що змінилися після пересканування. Почніть звідси."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos sobre los que aún no decidiste, más los que cambió un nuevo análisis. Empieza por aquí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
