        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you how much storage Alike can free, based on the last scan. Does not open the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє, скільки місця може звільнити Alike за результатами останнього сканування. Не відкриває застосунок."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto espacio puede liberar Alike según el último escaneo. No abre la app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto espacio puede liberar Alike según el último escaneo. No abre la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa quanto espaço o Alike pode liberar, com base na última análise. Não abre o app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, wie viel Speicher Alike laut letztem Scan freigeben kann. Öffnet die App nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l’espace qu’Alike peut libérer d’après la dernière analyse. N’ouvre pas l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quanto spazio Alike può liberare in base all’ultima analisi. Non apre l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt hoeveel opslag Alike kan vrijmaken op basis van de laatste scan. Opent de app niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje, ile miejsca Alike może odzyskać na podstawie ostatniego skanowania. Nie otwiera aplikacji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son taramaya göre Alike’ın ne kadar alan boşaltabileceğini söyler. Uygulamayı açmaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據上次掃描結果告訴你 Alike 可以釋放多少空間。不會開啟 App。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بمقدار المساحة التي يمكن أن يحررها Alike بناءً على آخر فحص. لا يفتح التطبيق."
          }
        }
      }
