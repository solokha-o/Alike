            "value": "Tout garder compte aussi"
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.move.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button at the bottom appears once something is selected, and always asks for confirmation first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка внизу з'являється, щойно щось вибрано, і завжди спершу запитує підтвердження."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de abajo aparece cuando hay algo seleccionado y siempre pide confirmación antes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de abajo aparece cuando hay algo seleccionado y siempre pide confirmación antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão na parte de baixo aparece quando há algo selecionado e sempre pede confirmação antes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Button unten erscheint, sobald etwas ausgewählt ist, und fragt immer vorher nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton du bas apparaît dès qu’un élément est sélectionné, et demande toujours confirmation."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.move.title": {
      "extractionState": "manual",
      "localizations": {
