          }
        }
      }
    },
    "settings.main.thisPermanentlyDeletesAlikesLocal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes Alike's local results, cleanup history, and preferences. Your photos and subscription will stay."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить локальні результати Alike, історію очищення та налаштування. Ваші фотографії та підписка залишаться."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los resultados locales, el historial de limpieza y las preferencias de Alike. Tus fotos y tu suscripción se mantienen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los resultados locales, el historial de limpieza y las preferencias de Alike. Tus fotos y tu suscripción se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apaga definitivamente os resultados locais, o histórico de limpeza e as preferências do Alike. Suas fotos e sua assinatura permanecem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden Alikes lokale Ergebnisse, der Aufräum-Verlauf und die Einstellungen endgültig gelöscht. Deine Fotos und dein Abo bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les résultats locaux, l’historique de nettoyage et les préférences d’Alike. Vos photos et votre abonnement sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione elimina definitivamente i risultati locali, la cronologia della pulizia e le preferenze di Alike. Le tue foto e il tuo abbonamento restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de lokale resultaten, opruimgeschiedenis en voorkeuren van Alike definitief verwijderd. Je foto's en abonnement blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie lokalnych wyników, historii porządków i preferencji Alike. Twoje zdjęcia i subskrypcja pozostaną."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem Alike'ın yerel sonuçlarını, temizlik geçmişini ve tercihlerini kalıcı olarak siler. Fotoğrafların ve aboneliğin kalır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除 Alike 的本機結果、清理歷史記錄與偏好設定。你的照片與訂閱項目會保留。"
          }
        }
      }
    },
