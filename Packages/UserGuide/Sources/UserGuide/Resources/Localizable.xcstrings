    "userGuide.cleanupQueue.controls.columns.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between a roomy one-column layout and a denser grid from the toolbar on any photo screen. Alike remembers your choice between launches."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайтеся між просторим одноколонковим виглядом і щільнішою сіткою на панелі інструментів будь-якого екрана з фото. Alike запам’ятовує ваш вибір між запусками."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre un diseño amplio de una columna y una cuadrícula más densa desde la barra de herramientas de cualquier pantalla de fotos. Alike recuerda tu elección entre sesiones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre un diseño amplio de una columna y una cuadrícula más densa desde la barra de herramientas de cualquier pantalla de fotos. Alike recuerda tu elección entre sesiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre um layout espaçoso de uma coluna e uma grade mais densa pela barra de ferramentas em qualquer tela de fotos. O Alike lembra sua escolha entre as aberturas do app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle über die Symbolleiste jeder Fotoansicht zwischen einer großzügigen einspaltigen Darstellung und einem dichteren Raster. Alike merkt sich deine Wahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculez entre une mise en page aérée sur une colonne et une grille plus dense depuis la barre d’outils de n’importe quel écran photo. Alike retient votre choix d’une session à l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa da un layout spazioso a una colonna a una griglia più fitta dalla barra strumenti di qualsiasi schermata con foto. Alike ricorda la tua scelta tra un avvio e l'altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel via de knoppenbalk op elk fotoscherm tussen een ruime weergave met één kolom en een dichter raster. Alike onthoudt je keuze tussen sessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączaj się między przestronnym układem jednokolumnowym a gęstszą siatką z paska narzędzi na dowolnym ekranie ze zdjęciami. Alike zapamiętuje Twój wybór między uruchomieniami."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir fotoğraf ekranındaki araç çubuğundan ferah tek sütunlu düzenle daha sık bir ızgara arasında geçiş yap. Alike seçimini açılışlar arasında hatırlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一照片畫面的工具列中，於寬鬆的單欄版面與較密集的格線之間切換。Alike 會在下次啟動時記住你的選擇。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بين تخطيط فسيح بعمود واحد وشبكة أكثر كثافة من شريط الأدوات في أي شاشة صور. يتذكر Alike اختيارك بين عمليات التشغيل."
          }
        }
      }
    },
