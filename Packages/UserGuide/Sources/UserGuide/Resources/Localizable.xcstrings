    "userGuide.cleanupQueue.badges.changed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos were added to or removed from a group you had already reviewed, so it's worth another look."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вже переглянутій групі додалися або зникли фото, тож варто глянути ще раз."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregaron o quitaron fotos de un grupo que ya habías revisado, así que vale la pena mirarlo otra vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han añadido o quitado fotos de un grupo que ya habías revisado, así que merece la pena mirarlo otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos foram adicionadas ou removidas de um grupo que você já tinha revisado, então vale outra olhada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Gruppe, die du schon geprüft hattest, kamen Fotos hinzu oder fielen weg – ein zweiter Blick lohnt sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des photos ont été ajoutées ou retirées d’un groupe que vous aviez déjà examiné : un second coup d’œil s’impose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state aggiunte o rimosse foto da un gruppo che avevi già controllato: vale la pena dargli un'altra occhiata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn foto's toegevoegd aan of verwijderd uit een groep die je al had bekeken, dus een tweede blik is de moeite waard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do grupy, którą już przejrzałeś, dodano lub usunięto zdjęcia — warto spojrzeć jeszcze raz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce gözden geçirdiğin bir gruba fotoğraf eklendi ya da gruptan fotoğraf çıkarıldı; bir kez daha bakmakta fayda var."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已檢視過的群組中新增或移除了照片，值得再看一次。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيفت صور إلى مجموعة سبق أن راجعتها أو أُزيلت منها، لذا تستحق نظرة أخرى."
          }
        }
      }
    },
