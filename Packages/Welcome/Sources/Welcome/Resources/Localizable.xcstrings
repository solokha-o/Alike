    "welcome.main.photoAccessLetsAlikeScan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access lets Alike scan your library, group similar photos, and prepare cleanup suggestions for you to review."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до фото дозволяє Alike сканувати фототеку, групувати схожі фото та готувати рекомендації для перегляду."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a las fotos permite que Alike analice tu fototeca, agrupe fotos similares y prepare sugerencias de limpieza para que las revises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a las fotos permite que Alike analice tu fototeca, agrupe fotos similares y prepare sugerencias de limpieza para que las revises."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso às fotos permite que o Alike analise sua fototeca, agrupe fotos semelhantes e prepare sugestões de limpeza para você revisar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Fotozugriff kann Alike deine Mediathek scannen, ähnliche Fotos gruppieren und Aufräumvorschläge für dich vorbereiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos permet à Alike d’analyser votre photothèque, de regrouper les photos similaires et de préparer des suggestions de nettoyage à examiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alle foto permette ad Alike di analizzare la libreria, raggruppare le foto simili e preparare suggerimenti di pulizia da controllare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met fototoegang kan Alike je bibliotheek scannen, vergelijkbare foto's groeperen en opruimsuggesties voorbereiden die jij kunt bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do zdjęć pozwala Alike przeskanować bibliotekę, pogrupować podobne zdjęcia i przygotować propozycje porządków do Twojego przejrzenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf erişimi, Alike'ın kitaplığını taramasını, benzer fotoğrafları gruplamasını ve senin gözden geçirmen için temizlik önerileri hazırlamasını sağlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取用照片後，Alike 就能掃描你的圖庫、將相似照片分組，並準備清理建議供你檢視。"
          }
        }
      }
    },
