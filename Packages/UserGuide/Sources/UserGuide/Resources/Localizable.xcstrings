    "userGuide.settingsAndReminders.analysis.sensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low groups only near-identical photos. High casts a wider net and finds more, but loosely related, matches."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Низька» групує лише майже однакові фото. «Висока» шукає ширше й знаходить більше, але менш споріднених збігів."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja agrupa solo fotos casi idénticas. Alta abarca más y encuentra más coincidencias, aunque menos parecidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja agrupa solo fotos casi idénticas. Alta abarca más y encuentra más coincidencias, aunque menos parecidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa agrupa apenas fotos quase idênticas. Alta abre o leque e encontra mais correspondências, porém menos parecidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrig gruppiert nur nahezu identische Fotos. Hoch fasst weiter und findet mehr, dafür lockerer verwandte Treffer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basse ne regroupe que les photos quasi identiques. Haute ratisse plus large et trouve davantage de correspondances, mais plus lâches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bassa» raggruppa solo le foto quasi identiche. «Alta» allarga la rete e trova più corrispondenze, ma meno affini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laag groepeert alleen bijna identieke foto's. Hoog werpt een breder net uit en vindt meer, maar losser verwante, overeenkomsten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niska grupuje tylko niemal identyczne zdjęcia. Wysoka zarzuca szerszą sieć i znajduje więcej, ale luźniej powiązanych dopasowań."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük yalnızca neredeyse aynı fotoğrafları gruplar. Yüksek ağı genişletir ve daha çok, ama daha gevşek ilişkili eşleşme bulur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「低」只會將幾乎相同的照片分為一組。「高」會放寬範圍，找到更多但關聯較鬆散的結果。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجمّع الحساسية المنخفضة الصور شبه المتطابقة فقط. أما العالية فتوسّع النطاق وتعثر على تطابقات أكثر لكنها أقل ارتباطًا."
          }
        }
      }
    },
