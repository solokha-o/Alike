    "userGuide.hub.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike finds photos worth a second look, and lets you decide what stays."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike знаходить фото, які варто переглянути ще раз, а рішення залишає за вами."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike encuentra fotos que merecen una segunda mirada y te deja decidir qué se queda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike encuentra fotos que merecen una segunda mirada y te deja decidir qué se queda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike encontra fotos que merecem uma segunda olhada e deixa você decidir o que fica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike findet Fotos, die einen zweiten Blick verdienen, und überlässt dir die Entscheidung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike repère les photos qui méritent un second regard et vous laisse décider de ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike trova le foto che meritano una seconda occhiata e lascia a te la scelta su cosa resta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike vindt foto's die een tweede blik verdienen en laat jou bepalen wat blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike znajduje zdjęcia warte drugiego spojrzenia, a Ty decydujesz, co zostaje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike ikinci kez bakmaya değer fotoğrafları bulur, neyin kalacağına sen karar verirsin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike 找出值得再看一眼的照片，由你決定要留下什麼。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر Alike على الصور التي تستحق نظرة ثانية، ويترك لك قرار ما يبقى."
          }
        }
      }
    },
