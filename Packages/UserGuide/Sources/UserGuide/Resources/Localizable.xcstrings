    "userGuide.comparingPhotos.review.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking a group reviewed is your decision, not a consequence of selecting photos. You can reopen it at any time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка «переглянуто» — це ваше рішення, а не наслідок вибору фото. Ви завжди можете повернути групу в роботу."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar un grupo como revisado es decisión tuya, no una consecuencia de seleccionar fotos. Puedes volver a abrirlo cuando quieras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar un grupo como revisado es decisión tuya, no una consecuencia de seleccionar fotos. Puedes volver a abrirlo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar um grupo como revisado é decisão sua, não consequência de selecionar fotos. Você pode reabri-lo quando quiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe als geprüft zu markieren ist deine Entscheidung, keine Folge des Auswählens. Du kannst sie jederzeit wieder öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer un groupe comme examiné relève de votre décision, pas d’une conséquence de la sélection. Vous pouvez le rouvrir à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnare un gruppo come controllato è una tua decisione, non una conseguenza della selezione. Puoi riaprirlo quando vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een groep als bekeken markeren is jouw beslissing, geen gevolg van het selecteren van foto's. Je kunt de groep altijd weer openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczenie grupy jako przejrzanej to Twoja decyzja, a nie skutek wybrania zdjęć. Możesz ją otworzyć ponownie w każdej chwili."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir grubu gözden geçirildi olarak işaretlemek senin kararındır, fotoğraf seçmenin sonucu değil. İstediğin zaman yeniden açabilirsin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將群組標示為已檢視是你的決定，並非選取照片造成的結果。你隨時可以重新打開。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع علامة «تمت المراجعة» على مجموعة هو قرارك، وليس نتيجة لتحديد الصور. ويمكنك إعادة فتحها في أي وقت."
          }
        }
      }
    },
    "userGuide.comparingPhotos.review.header": {
