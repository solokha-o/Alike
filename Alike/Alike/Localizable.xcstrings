    "alike.rescan.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing sensitivity requires a new scan to take effect"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб застосувати зміну чутливості, потрібне нове сканування"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad requiere un nuevo análisis para que surta efecto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la sensibilidad requiere un nuevo análisis para que surta efecto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a sensibilidade exige uma nova análise para ter efeito"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geänderte Empfindlichkeit wird erst nach einem neuen Scan wirksam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification de la sensibilité ne prend effet qu’après une nouvelle analyse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per applicare la nuova sensibilità serve una nuova scansione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gewijzigde gevoeligheid werkt pas na een nieuwe scan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana czułości zacznie działać dopiero po nowym skanowaniu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyarlılık değişikliğinin geçerli olması için yeni bir tarama gerekiyor"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改敏感度後須重新掃描才會生效"
          }
        }
      }
    },
