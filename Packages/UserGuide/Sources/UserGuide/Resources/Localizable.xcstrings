    "userGuide.cleanupQueue.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset controls puts sorting and filters back to their defaults."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скинути параметри» повертає сортування та фільтри до типових значень."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer controles devuelve el orden y los filtros a sus valores predeterminados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer controles devuelve el orden y los filtros a sus valores predeterminados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir controles devolve a ordenação e os filtros aos valores padrão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Einstellungen zurücksetzen“ stellt Sortierung und Filter wieder auf die Standardwerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réinitialiser les réglages » rétablit le tri et les filtres par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reimposta i criteri» riporta ordinamento e filtri ai valori predefiniti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Herstel instellingen' zet sorteren en filters terug op de standaardwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zresetuj ustawienia” przywraca sortowanie i filtry do wartości domyślnych."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçütleri sıfırla, sıralamayı ve filtreleri varsayılanlarına döndürür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「重置條件」會將排序與篩選恢復為預設值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد «إعادة تعيين الضوابط» الترتيب والمرشّحات إلى إعداداتها الافتراضية."
          }
        }
      }
    },
