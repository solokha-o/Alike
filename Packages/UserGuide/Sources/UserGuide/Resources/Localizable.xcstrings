    "userGuide.scanning.status.allowance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free includes three scans each calendar month. The counter resets at the start of the next month."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free містить три сканування щокалендарного місяця. Лічильник оновлюється на початку наступного місяця."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free incluye tres análisis por mes calendario. El contador se restablece al empezar el mes siguiente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free incluye tres análisis por mes natural. El contador se restablece al empezar el mes siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alike Free inclui três análises por mês. O contador zera no início do mês seguinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free enthält drei Scans pro Kalendermonat. Der Zähler startet zu Beginn des nächsten Monats neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free comprend trois analyses par mois civil. Le compteur repart au début du mois suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free include tre scansioni per ogni mese di calendario. Il contatore riparte all'inizio del mese successivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free bevat drie scans per kalendermaand. De teller begint aan het begin van de volgende maand opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free obejmuje trzy skanowania w każdym miesiącu kalendarzowym. Licznik zeruje się na początku kolejnego miesiąca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free her takvim ayında üç tarama içerir. Sayaç bir sonraki ayın başında sıfırlanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Alike Free 每個日曆月包含三次掃描。計數會在下個月初重設。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل Alike المجاني ثلاثة فحوصات في كل شهر ميلادي. ويُصفَّر العدّاد في بداية الشهر التالي."
          }
        }
      }
    },
