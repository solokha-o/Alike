    "userGuide.cleanupQueue.controls.filters.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrow the list by review status, minimum group size, or favourites only. Sorting stays available on Alike Free."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звужуйте список за станом перегляду, мінімальним розміром групи або лише обраними. Сортування доступне й в Alike Free."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acota la lista por estado de revisión, tamaño mínimo del grupo o solo favoritas. El orden sigue disponible en Alike Free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acota la lista por estado de revisión, tamaño mínimo del grupo o solo favoritas. El orden sigue disponible en Alike Free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre a lista por status de revisão, tamanho mínimo do grupo ou apenas favoritas. A ordenação continua disponível no Alike Free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenze die Liste nach Prüfstatus, Mindestgröße der Gruppe oder nur Favoriten ein. Das Sortieren bleibt in Alike Free verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restreignez la liste par statut d’examen, taille minimale de groupe ou favoris uniquement. Le tri reste disponible dans Alike Free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringi l'elenco per stato di controllo, dimensione minima del gruppo o solo preferiti. L'ordinamento resta disponibile su Alike Free."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperk de lijst op beoordelingsstatus, minimale groepsgrootte of alleen favorieten. Sorteren blijft beschikbaar in Alike Free."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawęź listę według stanu przeglądu, minimalnego rozmiaru grupy lub tylko ulubionych. Sortowanie pozostaje dostępne w Alike Free."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeyi gözden geçirme durumuna, en küçük grup boyutuna ya da yalnızca favorilere göre daralt. Sıralama Alike Free'de kullanılabilir olmayı sürdürür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依檢視狀態、群組最小數量或僅限最愛來縮小清單範圍。排序在 Alike Free 中仍可使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضيّق القائمة حسب حالة المراجعة أو الحد الأدنى لحجم المجموعة أو المفضلة فقط. يبقى الترتيب متاحًا في Alike المجاني."
          }
        }
      }
    },
