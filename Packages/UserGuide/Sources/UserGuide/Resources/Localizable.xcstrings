    "userGuide.comparingPhotos.inspect.info.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a photo for resolution, file type, dates, favourite status, and where it was taken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте фото, щоб побачити роздільну здатність, тип файлу, дати, статус обраного та місце зйомки."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una foto para ver resolución, tipo de archivo, fechas, si es favorita y dónde se tomó."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una foto para ver resolución, tipo de archivo, fechas, si es favorita y dónde se tomó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma foto pressionada para ver resolução, tipo de arquivo, datas, se é favorita e onde foi tirada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Foto gedrückt für Auflösung, Dateityp, Daten, Favoritenstatus und Aufnahmeort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une photo pour voir la résolution, le type de fichier, les dates, le statut de favori et le lieu de prise de vue."
          }
        }
      }
    },
    "userGuide.comparingPhotos.inspect.info.title": {
