    "welcome.main.alikeNeedsPhotoAccessScan" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Alike إلى إذن الوصول إلى الصور لفحص مكتبتك وإعداد اقتراحات التنظيف وحفظ التحسين عندما تختار تطبيقه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike benötigt Zugriff auf deine Fotos, um deine Mediathek zu scannen, Aufräumvorschläge vorzubereiten und eine Verbesserung zu sichern, wenn du sie anwendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike needs photo access to scan your library, prepare cleanup suggestions, and save an enhancement when you choose to apply one."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike needs photo access to scan your library, prepare cleanup suggestions, and save an enhancement when you choose to apply one."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike needs photo access to scan your library, prepare cleanup suggestions, and save an enhancement when you choose to apply one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike needs photo access to scan your library, prepare cleanup suggestions, and save an enhancement when you choose to apply one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike necesita acceso a tus fotos para analizar tu fototeca, preparar sugerencias de limpieza y guardar una mejora cuando decidas aplicarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike necesita acceso a tus fotos para analizar tu fototeca, preparar sugerencias de limpieza y guardar una mejora cuando decidas aplicarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike a besoin d’accéder à vos photos pour analyser votre photothèque, préparer des suggestions de nettoyage et enregistrer une amélioration lorsque vous choisissez de l’appliquer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike a besoin d’accéder à vos photos pour analyser votre photothèque, préparer des suggestions de nettoyage et enregistrer une amélioration lorsque vous choisissez de l’appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike ha bisogno dell'accesso alle foto per analizzare la libreria, preparare i suggerimenti di pulizia e salvare un miglioramento quando scegli di applicarlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike heeft toegang tot je foto's nodig om je bibliotheek te scannen, opruimsuggesties voor te bereiden en een verbetering te bewaren wanneer je die toepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike potrzebuje dostępu do zdjęć, aby przeskanować bibliotekę, przygotować propozycje porządków i zapisać poprawkę, gdy zdecydujesz się ją zastosować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike precisa de acesso às fotos para analisar sua fototeca, preparar sugestões de limpeza e salvar um aprimoramento quando você optar por aplicá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alike precisa de acesso às fotografias para analisar a tua fototeca, preparar sugestões de limpeza e guardar uma melhoria quando escolhes aplicá-la."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike'ın fotoğraf arşivini taraması, temizlik önerileri hazırlaması ve bir iyileştirmeyi uygulamayı seçtiğinde kaydetmesi için fotoğraflarına erişmesi gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike потрібен доступ до фото, щоб сканувати вашу фототеку, підготувати рекомендації для очищення та зберегти покращення, коли ви вирішите його застосувати."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike 需要取用照片，才能掃描你的圖庫、準備清理建議，並在你選擇套用時儲存優化結果。"
          }
        }
      }
    },
    "welcome.main.alikeNeverDeletesPhotosAutomatically" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحذف Alike الصور تلقائيًا أبدًا. أنت تراجع الاقتراحات أولًا وتؤكد كل إجراء تنظيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike löscht nie automatisch Fotos. Du prüfst zuerst die Vorschläge und bestätigst jede Aufräumaktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alike never deletes photos automatically. You review the suggestions first and confirm every cleanup action."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
